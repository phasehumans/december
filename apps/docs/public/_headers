# Cache static illustrations for 1 year immutable
/illustrations/*
  Cache-Control: public, max-age=31536000, immutable

# Cache compiled Astro assets for 1 year immutable
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Installer scripts - text/plain utf-8 with must-revalidate
/install.ps1
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate

/install.sh
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate
