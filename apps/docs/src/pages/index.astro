              December is a coding agent designed for your terminal and cloud. Rather than just offering inline suggestions, December explores your project, plans multi-file changes, writes code, and executes terminal commands and tests to verify fixes. You can work with it entirely in your local terminal or alongside your favorite IDE.
            </p>
          </div>
        </div>

        <!-- 02 Installation -->
        <div class="faq-item border border-[#e2e8f0] bg-white transition-all hover:border-[#87b2f4]">
          <button
            type="button"
            class="faq-toggle w-full p-4 sm:p-5 text-left flex items-start justify-between gap-4 cursor-pointer group"
            aria-expanded="false"
          >
            <div>
              <div class="flex items-center gap-1.5 font-mono text-xs text-[#090a0f] font-medium mb-1">
                <span class="text-[#87b2f4] font-semibold">02</span>
                <span class="text-[#cbd5e1]">/</span>
                <span>Installation</span>
              </div>
              <h4 class="text-sm sm:text-[15px] font-normal text-[#090a0f] leading-snug">
                How do I get started with December?
              </h4>
            </div>
            <span class="faq-icon-box shrink-0 w-6 h-6 mt-0.5 border border-[#e2e8f0] group-hover:border-[#87b2f4] flex items-center justify-center font-mono text-xs text-[#64748b] group-hover:text-[#87b2f4] transition-all select-none">
              <span class="faq-icon font-bold leading-none">+</span>
            </span>
          </button>
          <div class="faq-content hidden px-4 pb-4 sm:px-5 sm:pb-5 pt-0 text-sm text-[#52525b] leading-relaxed">
            <p>
              Install December using the standalone installer or your preferred package manager (npm, bun, or pnpm) from the quick install command bar above.
            </p>
            <p class="mt-2.5">
              Then navigate to any git repository in your shell and run <code class="font-mono text-[#090a0f]">december</code> to start an interactive session, or launch with an initial instruction like <code class="font-mono text-[#090a0f]">december "fix failing unit tests"</code>.
            </p>
          </div>
        </div>

        <!-- 03 Models & BYOK -->
        <div class="faq-item border border-[#e2e8f0] bg-white transition-all hover:border-[#87b2f4]">
          <button
            type="button"
            class="faq-toggle w-full p-4 sm:p-5 text-left flex items-start justify-between gap-4 cursor-pointer group"
            aria-expanded="false"
          >
            <div>
              <div class="flex items-center gap-1.5 font-mono text-xs text-[#090a0f] font-medium mb-1">
                <span class="text-[#87b2f4] font-semibold">03</span>
                <span class="text-[#cbd5e1]">/</span>
                <span>Models &amp; BYOK</span>
              </div>
              <h4 class="text-sm sm:text-[15px] font-normal text-[#090a0f] leading-snug">
                Do I need extra AI subscriptions or proprietary credits?
              </h4>
            </div>
            <span class="faq-icon-box shrink-0 w-6 h-6 mt-0.5 border border-[#e2e8f0] group-hover:border-[#87b2f4] flex items-center justify-center font-mono text-xs text-[#64748b] group-hover:text-[#87b2f4] transition-all select-none">
              <span class="faq-icon font-bold leading-none">+</span>
            </span>
          </button>
          <div class="faq-content hidden px-4 pb-4 sm:px-5 sm:pb-5 pt-0 text-sm text-[#52525b] leading-relaxed">
            <p>
              No! December is 100% model-agnostic with zero token markup. Bring your own API keys for Claude 3.7 Sonnet, OpenAI (GPT-4o, o3-mini), Google Gemini 2.5, DeepSeek, or run local offline models privately with Ollama.
            </p>
            <p class="mt-2">
              If you prefer zero setup, you can also sign in to December Cloud to use bundled monthly credits across top-tier models. Configure your keys anytime by running <code class="font-mono text-[#090a0f]">december login</code>.
            </p>
          </div>
        </div>

        <!-- 04 Privacy & Security -->
        <div class="faq-item border border-[#e2e8f0] bg-white transition-all hover:border-[#87b2f4]">
          <button
            type="button"
            class="faq-toggle w-full p-4 sm:p-5 text-left flex items-start justify-between gap-4 cursor-pointer group"
            aria-expanded="false"
          >
            <div>
              <div class="flex items-center gap-1.5 font-mono text-xs text-[#090a0f] font-medium mb-1">
                <span class="text-[#87b2f4] font-semibold">04</span>
                <span class="text-[#cbd5e1]">/</span>
                <span>Privacy &amp; Security</span>
              </div>
              <h4 class="text-sm sm:text-[15px] font-normal text-[#090a0f] leading-snug">
                What about data privacy and codebase security?
              </h4>
            </div>
            <span class="faq-icon-box shrink-0 w-6 h-6 mt-0.5 border border-[#e2e8f0] group-hover:border-[#87b2f4] flex items-center justify-center font-mono text-xs text-[#64748b] group-hover:text-[#87b2f4] transition-all select-none">
              <span class="faq-icon font-bold leading-none">+</span>
            </span>
          </button>
          <div class="faq-content hidden px-4 pb-4 sm:px-5 sm:pb-5 pt-0 text-sm text-[#52525b] leading-relaxed">
            <p>
              December operates locally on your machine. Your codebase, git history, and local environment files never leave your system. When you use BYOK mode, requests travel directly from your machine to your configured LLM endpoint (or stay completely offline when using Ollama).
            </p>
            <p class="mt-2">
              Code is only synchronized to an isolated cloud micro-VM when you explicitly execute the <code class="font-mono text-[#090a0f]">/handoff</code> command.
            </p>
          </div>
        </div>

      </div>
    </section>

    <!-- Brand Banner above Footer -->
    <div class="mb-1 sm:mb-2">
      <a
        href={`${appUrl}/login`}
        class="relative block w-full border border-[#e2e8f0] bg-white overflow-hidden group min-h-[100px] sm:min-h-[120px] flex items-center"
        aria-label="start building with december"
      >
        <!-- Pure Dither Background Image -->
        <img
          src="/illustrations/banner.webp"
          alt=""
          class="absolute inset-0 w-full h-full object-cover object-right select-none pointer-events-none opacity-90 group-hover:opacity-100 transition-opacity duration-300"
          loading="lazy"
          decoding="async"
        />

        <!-- Soft gradient on the left ensuring crisp text contrast -->
        <div class="absolute inset-y-0 left-0 w-full sm:w-[48%] md:w-[40%] bg-gradient-to-r from-white via-white/80 to-transparent pointer-events-none"></div>

        <!-- Banner Content -->
        <div class="relative z-10 px-5 sm:px-7 py-3 sm:py-4 flex items-center">
          <span class="text-xs sm:text-[13px] md:text-sm font-medium tracking-tight text-[#87b2f4] group-hover:text-[#6fa2ee] transition-colors">
            start building with december
          </span>
        </div>
      </a>
    </div>
  </div>
</BaseLayout>

<script>
  // Page Client Scripts
  function initPageScripts() {
    // 1. Hero Command Bar & Package Manager Dropdown
    const heroDisplayCmd = document.getElementById('hero-display-cmd');
    const heroCopyCmdBtn = document.getElementById('hero-copy-cmd-btn');
    const heroCopyIconBtn = document.getElementById('hero-copy-icon-btn');
    const heroCopyIcon = document.getElementById('hero-copy-icon');
    const pmDropdownToggle = document.getElementById('pm-dropdown-toggle');
    const pmDropdownChevron = document.getElementById('pm-dropdown-chevron');
    const pmDropdownMenu = document.getElementById('pm-dropdown-menu');
    const pmOptions = document.querySelectorAll('.pm-option');

    let currentHeroCmd = heroDisplayCmd?.textContent?.trim() || "npm install -g @trydecember/cli";

    const triggerHeroCopy = async () => {
      try {
        await navigator.clipboard.writeText(currentHeroCmd);
        if (heroCopyIcon) {
          heroCopyIcon.innerHTML = '<polyline points="20 6 9 17 4 12"></polyline>';
          setTimeout(() => {
            heroCopyIcon.innerHTML = '<rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>';
          }, 1200);
        }
      } catch {
        // Fallback
      }
    };

    if (heroCopyCmdBtn) (heroCopyCmdBtn as HTMLElement).onclick = triggerHeroCopy;
    if (heroCopyIconBtn) (heroCopyIconBtn as HTMLElement).onclick = triggerHeroCopy;

    if (pmDropdownToggle && pmDropdownMenu) {
      (pmDropdownToggle as HTMLElement).onclick = (e) => {
        e.preventDefault();
        e.stopPropagation();
        const willOpen = pmDropdownMenu.classList.contains('hidden');
        if (willOpen) {
          pmDropdownMenu.classList.remove('hidden');
          pmDropdownToggle.setAttribute('aria-expanded', 'true');
          pmDropdownToggle.classList.add('bg-[#f1f5f9]', 'text-[#090a0f]');
          if (pmDropdownChevron) pmDropdownChevron.classList.add('rotate-180');
        } else {
          pmDropdownMenu.classList.add('hidden');
          pmDropdownToggle.setAttribute('aria-expanded', 'false');
          pmDropdownToggle.classList.remove('bg-[#f1f5f9]', 'text-[#090a0f]');
          if (pmDropdownChevron) pmDropdownChevron.classList.remove('rotate-180');
        }
      };

      pmOptions.forEach((option) => {
        (option as HTMLElement).onclick = (e) => {
          e.stopPropagation();
          const cmd = option.getAttribute('data-cmd');
          if (cmd && heroDisplayCmd) {
            currentHeroCmd = cmd;
            heroDisplayCmd.textContent = cmd;

            // Update active styles and checkmarks
            pmOptions.forEach((opt) => {
              const check = opt.querySelector('.pm-check');
              if (check) check.classList.add('hidden');
              opt.classList.remove('bg-[#f8fafc]', 'text-[#090a0f]', 'font-semibold');
              opt.classList.add('text-[#1e293b]');
            });
            const activeCheck = option.querySelector('.pm-check');
            if (activeCheck) activeCheck.classList.remove('hidden');
            option.classList.remove('text-[#1e293b]');
            option.classList.add('bg-[#f8fafc]', 'text-[#090a0f]', 'font-semibold');

            // Close dropdown & copy selected command
            pmDropdownMenu.classList.add('hidden');
            pmDropdownToggle.setAttribute('aria-expanded', 'false');
            pmDropdownToggle.classList.remove('bg-[#f1f5f9]', 'text-[#090a0f]');
            if (pmDropdownChevron) {
              pmDropdownChevron.classList.remove('rotate-180');
            }
            triggerHeroCopy();
          }
        };
      });
    }

    // 2. FAQ Accordion Toggle Script
    const faqList = document.getElementById('faq-list');
    if (faqList) {
      faqList.onclick = (e) => {
        const target = e.target;
        if (!(target instanceof HTMLElement)) return;

        const toggleBtn = target.closest('.faq-toggle');
        if (!toggleBtn || !faqList.contains(toggleBtn)) return;

        const item = toggleBtn.closest('.faq-item');
        if (!item) return;

        const content = item.querySelector('.faq-content');
        const icon = item.querySelector('.faq-icon');
        const iconBox = item.querySelector('.faq-icon-box');
        if (!content || !icon) return;

        const isHidden = content.classList.contains('hidden');
        if (isHidden) {
          content.classList.remove('hidden');
          icon.textContent = '-';
          item.classList.add('border-[#87b2f4]', 'shadow-xs');
          if (iconBox) {
            iconBox.classList.add('border-[#87b2f4]', 'text-[#87b2f4]', 'bg-[#87b2f4]/10');
          }
          toggleBtn.setAttribute('aria-expanded', 'true');
        } else {
          content.classList.add('hidden');
          icon.textContent = '+';
          item.classList.remove('border-[#87b2f4]', 'shadow-xs');
          if (iconBox) {
            iconBox.classList.remove('border-[#87b2f4]', 'text-[#87b2f4]', 'bg-[#87b2f4]/10');
          }
          toggleBtn.setAttribute('aria-expanded', 'false');
        }
      };
    }

  }

  // Global click to dismiss dropdown
  document.addEventListener('click', (e) => {
    const pmDropdownMenu = document.getElementById('pm-dropdown-menu');
    const pmDropdownToggle = document.getElementById('pm-dropdown-toggle');
    const pmDropdownChevron = document.getElementById('pm-dropdown-chevron');
    if (pmDropdownMenu && pmDropdownToggle) {
      if (!pmDropdownMenu.contains(e.target as Node) && !pmDropdownToggle.contains(e.target as Node)) {
        pmDropdownMenu.classList.add('hidden');
        pmDropdownToggle.setAttribute('aria-expanded', 'false');
        pmDropdownToggle.classList.remove('bg-[#f1f5f9]', 'text-[#090a0f]');
        if (pmDropdownChevron) {
          pmDropdownChevron.classList.remove('rotate-180');
        }
      }
    }
  });

  initPageScripts();
  document.addEventListener('astro:page-load', initPageScripts);
</script>

