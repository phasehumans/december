<script>
  // Package Manager Switcher & Copy Script
  const installCommand = document.getElementById('install-command');
  const copyBtn = document.getElementById('copy-btn');
  const copyText = document.getElementById('copy-text');
  const tabs = document.querySelectorAll('.pm-tab');

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const cmd = tab.getAttribute('data-cmd');
      if (cmd && installCommand) {
        installCommand.textContent = cmd;
        tabs.forEach((t) => {
          t.classList.remove('text-[#090a0f]', 'font-semibold');
          t.classList.add('text-[#64748b]');
        });
        tab.classList.remove('text-[#64748b]');
        tab.classList.add('text-[#090a0f]', 'font-semibold');
      }
    });
  });

  if (copyBtn && installCommand) {
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(installCommand.textContent || '');
        if (copyText) copyText.textContent = 'Copied!';
        setTimeout(() => {
          if (copyText) copyText.textContent = 'Copy';
        }, 2000);
      } catch {
        // Fallback for non-secure contexts
      }
    });
  }

  // Hero Command Bar & Package Manager Dropdown Script
  const heroDisplayCmd = document.getElementById('hero-display-cmd');
  const heroCopyCmdBtn = document.getElementById('hero-copy-cmd-btn');
  const heroCopyIconBtn = document.getElementById('hero-copy-icon-btn');
  const heroCopyFeedback = document.getElementById('hero-copy-feedback');
  const pmDropdownToggle = document.getElementById('pm-dropdown-toggle');
  const pmDropdownChevron = document.getElementById('pm-dropdown-chevron');
  const pmDropdownMenu = document.getElementById('pm-dropdown-menu');
  const pmOptions = document.querySelectorAll('.pm-option');

  let currentHeroCmd = "npm install -g @trydecember/cli";

  const triggerHeroCopy = async () => {
    try {
      await navigator.clipboard.writeText(currentHeroCmd);
      if (heroCopyFeedback) {
        heroCopyFeedback.classList.remove('hidden');
        setTimeout(() => {
          heroCopyFeedback.classList.add('hidden');
        }, 1800);
      }
    } catch {
      // Fallback
    }
  };

  if (heroCopyCmdBtn) heroCopyCmdBtn.addEventListener('click', triggerHeroCopy);
  if (heroCopyIconBtn) heroCopyIconBtn.addEventListener('click', triggerHeroCopy);

  if (pmDropdownToggle && pmDropdownMenu) {
    pmDropdownToggle.addEventListener('click', (e) => {
      e.stopPropagation();
      const isHidden = pmDropdownMenu.classList.contains('hidden');
      pmDropdownMenu.classList.toggle('hidden');
      pmDropdownToggle.setAttribute('aria-expanded', String(isHidden));
      if (pmDropdownChevron) {
        pmDropdownChevron.classList.toggle('rotate-180', isHidden);
      }
    });

    document.addEventListener('click', (e) => {
      if (!pmDropdownMenu.contains(e.target as Node) && !pmDropdownToggle.contains(e.target as Node)) {
        pmDropdownMenu.classList.add('hidden');
        pmDropdownToggle.setAttribute('aria-expanded', 'false');
        if (pmDropdownChevron) {
          pmDropdownChevron.classList.remove('rotate-180');
        }
      }
    });

    pmOptions.forEach((option) => {
      option.addEventListener('click', () => {
        const cmd = option.getAttribute('data-cmd');
        if (cmd && heroDisplayCmd) {
          currentHeroCmd = cmd;
          heroDisplayCmd.textContent = cmd;

          // Update checkmarks
          pmOptions.forEach((opt) => {
            const check = opt.querySelector('.pm-check');
            if (check) check.classList.add('hidden');
          });
          const activeCheck = option.querySelector('.pm-check');
          if (activeCheck) activeCheck.classList.remove('hidden');

          // Close dropdown & copy selected command
          pmDropdownMenu.classList.add('hidden');
          pmDropdownToggle.setAttribute('aria-expanded', 'false');
          if (pmDropdownChevron) {
            pmDropdownChevron.classList.remove('rotate-180');
          }
          triggerHeroCopy();
        }
      });
    });
  }

  // Benchmark Filter Tabs
  const benchFilters = document.querySelectorAll('.bench-filter');
  benchFilters.forEach((filter) => {
    filter.addEventListener('click', () => {
      benchFilters.forEach((f) => {
        f.classList.remove('bg-white', 'text-[#090a0f]', 'font-medium', 'shadow-xs');
        f.classList.add('text-[#64748b]');
      });
      filter.classList.remove('text-[#64748b]');
      filter.classList.add('bg-white', 'text-[#090a0f]', 'font-medium', 'shadow-xs');
    });
  });

  // FAQ Accordion Toggle Script
  function initFaq() {
    const faqList = document.getElementById('faq-list');
    if (!faqList || faqList.dataset.faqInitialized === 'true') return;
    faqList.dataset.faqInitialized = 'true';

    faqList.addEventListener('click', (e) => {
      const target = e.target;
      if (!(target instanceof HTMLElement)) return;

      const toggleBtn = target.closest('.faq-toggle');
      if (!toggleBtn || !faqList.contains(toggleBtn)) return;

      const item = toggleBtn.closest('.faq-item');
      if (!item) return;

      const content = item.querySelector('.faq-content');
      const icon = item.querySelector('.faq-icon');
      if (!content || !icon) return;

      const isHidden = content.classList.contains('hidden');
      if (isHidden) {
        content.classList.remove('hidden');
        icon.textContent = '—';
        toggleBtn.setAttribute('aria-expanded', 'true');
      } else {
        content.classList.add('hidden');
        icon.textContent = '+';
        toggleBtn.setAttribute('aria-expanded', 'false');
      }
    });
  }

  initFaq();
  document.addEventListener('astro:page-load', initFaq);
</script>

