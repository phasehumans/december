---
import BaseLayout from '../layouts/BaseLayout.astro';
import { version } from '../lib/version';

const webUrl = import.meta.env.PUBLIC_WEB_URL || (import.meta.env.DEV ? 'http://localhost:3000' : 'https://app.trydecember.com');
---

<BaseLayout
  title="December | A Coding Agent for Terminal and Cloud"
  description="December is an open-source coding agent for terminal and cloud. It writes code, fixes bugs, and runs commands with seamless terminal-to-cloud handoff."
  canonicalUrl="https://trydecember.com"
  hideHeader={false}
  hideFooter={false}
>
  <!-- Page Container: Generous left & right margins with compact vertical rhythm -->
  <div class="mx-auto max-w-[940px] px-6 sm:px-8 md:px-10 lg:px-12 pt-8 pb-16 sm:pt-12 sm:pb-20">
    
    <!-- Hero Section -->
    <section class="mb-16 sm:mb-20">

      <!-- Headline -->
      <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-[52px] font-medium tracking-[-0.035em] text-[#090a0f] leading-[1.1] max-w-3xl">
        december, a coding agent<br class="hidden sm:inline" /> for terminal and cloud.
      </h1>

      <!-- Subtitle (simple & compact) -->
      <p class="mt-3 text-sm sm:text-base text-[#52525b] font-normal leading-relaxed max-w-2xl">
        Lives in your shell to write code, fix bugs, and execute commands with zero latency—with instant cloud sandboxes whenever you need them.
      </p>

      <!-- Action Buttons & Setup Prompt Group -->
      <div class="mt-7 max-w-xl">
        <!-- Dual Buttons Row (Supermemory Reference) -->
        <div class="flex flex-wrap items-center gap-3">
          <!-- Primary: Build with December -->
          <a
            href={webUrl}
            class="group inline-flex items-center rounded-none bg-[#87b2f4] text-[#071326] font-mono text-xs uppercase tracking-wider font-semibold transition-all hover:bg-[#72a4ee] active:scale-[0.98] shadow-xs overflow-hidden"
          >
            <!-- Logo Icon Tile Slot -->
            <span class="flex items-center justify-center bg-[#6fa2ee] px-3 py-2.5 border-r border-[#5b94e8] transition-colors group-hover:bg-[#5b94e8]">
              <svg viewBox="0 0 32 32" class="w-3.5 h-3.5 text-[#071326]" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="16" y1="16" x2="16" y2="6" />
                <line x1="16" y1="9" x2="19" y2="7.5" />
                <line x1="16" y1="9" x2="13" y2="7.5" />
                <line x1="16" y1="16" x2="25" y2="21" />
                <line x1="22" y1="19.5" x2="25" y2="17" />
                <line x1="22" y1="19.5" x2="22" y2="23" />
                <line x1="16" y1="16" x2="7" y2="21" />
                <line x1="10" y1="19.5" x2="10" y2="23" />
                <line x1="10" y1="19.5" x2="7" y2="17" />
              </svg>
            </span>
            <span class="px-4 py-2.5">Build with December</span>
          </a>

          <!-- Secondary: Get Started (Login / Signup) -->
          <a
            href={`${webUrl}/login`}
            class="corner-brackets relative inline-flex items-center gap-2 border border-[#e2e8f0] bg-white px-4 py-2.5 font-mono text-xs uppercase tracking-wider text-[#1e293b] font-medium hover:border-[#87b2f4] hover:text-[#090a0f] transition-all active:scale-[0.98]"
          >
            <span class="corner-brackets-tr"></span>
            <span class="corner-brackets-bl"></span>
            <span>Get Started</span>
            <svg class="w-3.5 h-3.5 text-[#64748b]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square">
              <path d="M7 17L17 7M17 7H7M17 7V17" />
            </svg>
          </a>
        </div>

        <!-- Hatch-Pattern Command Bar with Package Manager Dropdown -->
        <div class="mt-3 relative" id="hero-install-container">
          <div class="hatch-pattern flex items-center justify-between border border-[#e2e8f0] rounded-none px-3.5 py-2 shadow-xs transition-all hover:border-[#cbd5e1]">
            <!-- Command Text button -->
            <button
              id="hero-copy-cmd-btn"
              type="button"
              class="flex-1 flex items-center gap-2 font-mono text-xs sm:text-[13px] text-[#1e293b] text-left cursor-pointer focus:outline-none"
              title="Click to copy command"
            >
              <span class="text-[#87b2f4] select-none font-semibold">$</span>
              <span id="hero-display-cmd" class="font-normal text-[#0f172a]">npm install -g @trydecember/cli</span>
            </button>

            <!-- Actions: Copy Button + Dropdown Toggle -->
            <div class="flex items-center gap-1 ml-2">
              <!-- Copy Button with Tooltip Feedback -->
              <button
                id="hero-copy-icon-btn"
                type="button"
                class="relative p-1 text-[#64748b] hover:text-[#090a0f] transition-colors cursor-pointer focus:outline-none"
                title="Copy command"
              >
                <svg id="hero-copy-icon" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                  <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                </svg>
                <span id="hero-copy-feedback" class="hidden absolute -top-7 right-0 bg-[#090a0f] text-white text-[10px] font-mono py-0.5 px-1.5 rounded shadow-sm whitespace-nowrap">Copied!</span>
              </button>

              <!-- Dropdown Toggle Button (Matching Reference) -->
              <button
                id="pm-dropdown-toggle"
                type="button"
                class="p-1 border-l border-[#e2e8f0] text-[#64748b] hover:text-[#090a0f] transition-colors focus:outline-none cursor-pointer"
                aria-expanded="false"
                aria-haspopup="true"
                title="Select package manager"
              >
                <svg id="pm-dropdown-chevron" class="w-3.5 h-3.5 transition-transform duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M6 9l6 6 6-6" />
                </svg>
              </button>
            </div>
          </div>

          <!-- Dropdown Menu (npm, bun, pnpm with Logos) -->
          <div
            id="pm-dropdown-menu"
            class="hidden absolute right-0 top-full mt-1.5 z-40 w-52 border border-[#e2e8f0] bg-white p-1.5 shadow-xl font-mono text-xs rounded-none"
          >
            <div class="px-2.5 py-1 text-[10px] uppercase tracking-wider text-[#94a3b8] font-semibold">
              Install via
            </div>

            <!-- npm option -->
            <button
              type="button"
              class="pm-option w-full flex items-center justify-between px-2.5 py-2 text-[#1e293b] hover:bg-[#f8fafc] hover:text-[#090a0f] transition-colors cursor-pointer text-left rounded-[2px]"
              data-pm="npm"
              data-cmd="npm install -g @trydecember/cli"
            >
              <div class="flex items-center gap-2.5">
                <svg class="w-4 h-4 text-[#cb3837]" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M1.763 0C.786 0 0 .786 0 1.763v20.474C0 23.214.786 24 1.763 24h20.474c.977 0 1.763-.786 1.763-1.763V1.763C24 .786 23.214 0 22.237 0zM5.13 5.323l13.837.019-.009 13.836h-3.464l.01-10.382h-3.456L12.04 19.17H5.113z"/>
                </svg>
                <span class="font-medium">npm</span>
              </div>
              <span class="pm-check text-[#87b2f4] text-xs">✓</span>
            </button>

            <!-- bun option -->
            <button
              type="button"
              class="pm-option w-full flex items-center justify-between px-2.5 py-2 text-[#1e293b] hover:bg-[#f8fafc] hover:text-[#090a0f] transition-colors cursor-pointer text-left rounded-[2px]"
              data-pm="bun"
              data-cmd="bun add -g @trydecember/cli"
            >
              <div class="flex items-center gap-2.5">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none">
                  <path d="M19.98 14.86c-.16-1.57-.9-3.03-2.1-4.14.76-1.04 1.15-2.3 1.1-3.6-.1-2.45-1.9-4.52-4.32-4.96C11.53 1.6 8.35 3.52 7.57 6.46c-.34 1.28-.2 2.65.4 3.8-1.5 1.18-2.38 2.94-2.44 4.88-.08 2.62 1.5 5.02 3.94 6 1.6.64 3.37.76 5.04.35 2.58-.63 4.67-2.6 5.33-5.18.09-.48.14-.98.14-1.45z" fill="#fbf0df" stroke="#d4956a" stroke-width="1.2"/>
                  <circle cx="9.5" cy="11" r="1" fill="#333"/>
                  <circle cx="14.5" cy="11" r="1" fill="#333"/>
                  <path d="M11 13.5c.6.4 1.4.4 2 0" stroke="#333" stroke-width="1" stroke-linecap="round"/>
                </svg>
                <span class="font-medium">bun</span>
              </div>
              <span class="pm-check hidden text-[#87b2f4] text-xs">✓</span>
            </button>

            <!-- pnpm option -->
            <button
              type="button"
              class="pm-option w-full flex items-center justify-between px-2.5 py-2 text-[#1e293b] hover:bg-[#f8fafc] hover:text-[#090a0f] transition-colors cursor-pointer text-left rounded-[2px]"
              data-pm="pnpm"
              data-cmd="pnpm add -g @trydecember/cli"
            >
              <div class="flex items-center gap-2.5">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none">
                  <rect x="2" y="2" width="5.5" height="5.5" fill="#f69220" rx="1"/>
                  <rect x="9.25" y="2" width="5.5" height="5.5" fill="#f69220" rx="1"/>
                  <rect x="16.5" y="2" width="5.5" height="5.5" fill="#f69220" rx="1"/>
                  <rect x="9.25" y="9.25" width="5.5" height="5.5" fill="#f69220" rx="1"/>
                  <rect x="16.5" y="9.25" width="5.5" height="5.5" fill="#f69220" rx="1"/>
                  <rect x="2" y="16.5" width="5.5" height="5.5" fill="#4a4a4a" rx="1"/>
                  <rect x="9.25" y="16.5" width="5.5" height="5.5" fill="#4a4a4a" rx="1"/>
                  <rect x="16.5" y="16.5" width="5.5" height="5.5" fill="#4a4a4a" rx="1"/>
                </svg>
                <span class="font-medium">pnpm</span>
              </div>
              <span class="pm-check hidden text-[#87b2f4] text-xs">✓</span>
            </button>
          </div>
        </div>

        <!-- "CLI SUPPORTS PROVIDERS" Strip -->
        <div class="mt-6 flex flex-wrap items-center gap-3.5">
          <span class="font-mono text-xs text-[#64748b] font-medium">CLI supports providers:</span>
          <div class="flex items-center gap-3 text-[#475569]">
            <!-- OpenAI -->
            <span title="OpenAI" class="hover:text-[#090a0f] transition-colors cursor-pointer inline-flex items-center">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                <path d="M22.282 9.821a5.985 5.985 0 0 0-.516-4.91 6.046 6.046 0 0 0-6.51-2.9A6.065 6.065 0 0 0 4.981 4.18a5.985 5.985 0 0 0-3.998 2.9 6.046 6.046 0 0 0 .743 7.097 5.98 5.98 0 0 0 .51 4.911 6.051 6.051 0 0 0 6.515 2.9A5.985 5.985 0 0 0 13.26 24a6.056 6.056 0 0 0 5.772-4.206 5.99 5.99 0 0 0 3.997-2.9 6.056 6.056 0 0 0-.747-7.073zM13.26 22.43a4.476 4.476 0 0 1-2.876-1.04l.141-.081 4.779-2.758a.795.795 0 0 0 .392-.681v-6.737l2.02 1.168a.071.071 0 0 1 .038.052v5.583a4.504 4.504 0 0 1-4.494 4.494zM3.6 18.304a4.47 4.47 0 0 1-.535-3.014l.142.085 4.783 2.759a.771.771 0 0 0 .78 0l5.843-3.369v2.332a.08.08 0 0 1-.033.062L9.74 19.95a4.5 4.5 0 0 1-6.14-1.646zM2.34 8.946a4.485 4.485 0 0 1 2.366-1.973V12.6a.766.766 0 0 0 .388.677l5.815 3.355-2.02 1.168a.076.076 0 0 1-.071 0l-4.83-2.786A4.504 4.504 0 0 1 2.34 8.946zm16.799 3.014l-5.843-3.37v-2.33a.08.08 0 0 1 .033-.062l4.84-2.796a4.499 4.499 0 0 1 6.674 4.66l-.141-.085-4.784-2.759a.775.775 0 0 0-.779 0zm2.522-3.014a4.476 4.476 0 0 1-2.366 1.973V5.3a.766.766 0 0 0-.388-.677L13.092 1.27l2.02-1.168a.076.076 0 0 1 .071 0l4.83 2.786a4.504 4.504 0 0 1 1.646 6.046zM10.855 8.16l2.385-1.378 2.385 1.378v2.755l-2.385 1.378-2.385-1.378z"/>
              </svg>
            </span>

            <!-- Anthropic -->
            <span title="Anthropic" class="hover:text-[#090a0f] transition-colors cursor-pointer inline-flex items-center">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                <path d="M13.827 3.52h3.603L24 20h-3.603l-6.57-16.48zm-7.258 0h3.767L16.906 20h-3.674l-1.343-3.461H5.017l-1.344 3.46H0L6.57 3.522zm4.132 9.959L8.453 7.687 6.205 13.48H10.7z"/>
              </svg>
            </span>

            <!-- Google Gemini -->
            <span title="Google Gemini" class="hover:text-[#090a0f] transition-colors cursor-pointer inline-flex items-center">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                <path d="M11.04 19.32Q12 21.51 12 24q0-2.49.93-4.68.96-2.19 2.58-3.81t3.81-2.55Q21.51 12 24 12q-2.49 0-4.68-.93a12.3 12.3 0 0 1-3.81-2.58 12.3 12.3 0 0 1-2.58-3.81Q12 2.49 12 0q0 2.49-.96 4.68-.93 2.19-2.55 3.81a12.3 12.3 0 0 1-3.81 2.58Q2.49 12 0 12q2.49 0 4.68.96 2.19.93 3.81 2.55t2.55 3.81z"/>
              </svg>
            </span>

            <!-- Mistral AI -->
            <span title="Mistral AI" class="hover:text-[#090a0f] transition-colors cursor-pointer inline-flex items-center">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                <path d="M17.143 3.429v3.428h-3.429v3.429h-3.428V6.857H6.857V3.43H3.43v13.714H0v3.428h10.286v-3.428H6.857v-3.429h3.429v3.429h3.429v-3.429h3.428v3.429h-3.428v3.428H24v-3.428h-3.43V3.429z"/>
              </svg>
            </span>

            <!-- Z.AI -->
            <span title="Z.ai" class="hover:text-[#090a0f] transition-colors cursor-pointer inline-flex items-center">
              <svg class="w-4 h-4" viewBox="0 0 30 30" fill="currentColor">
                <path d="M24.51 28.51H5.49c-2.21 0-4-1.79-4-4V5.49c0-2.21 1.79-4 4-4h19.03c2.21 0 4 1.79 4 4v19.03c0 2.2-1.79 3.99-4 3.99z" fill="none" stroke="currentColor" stroke-width="1.8" rx="4"/>
                <path d="M15.47 7.1l-1.3 1.85c-.2.29-.54.47-.9.47h-7.1V7.09h9.3z"/>
                <polygon points="24.3,7.1 13.14,22.91 5.7,22.91 16.86,7.1"/>
                <path d="M14.53 22.91l1.31-1.86c.2-.29.54-.47.9-.47h7.09v2.33H14.53z"/>
              </svg>
            </span>

            <!-- Meta Muse -->
            <span title="Meta Muse" class="hover:text-[#090a0f] transition-colors cursor-pointer inline-flex items-center">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 15.657C10.74 17.065 9.074 18 7.218 18 3.79 18 1 14.939 1 11.144 1 7.348 3.79 4.288 7.218 4.288c1.856 0 3.522.934 4.782 2.343 1.26-1.409 2.926-2.343 4.782-2.343C20.21 4.288 23 7.348 23 11.144c0 3.795-2.79 6.856-6.218 6.856-1.856 0-3.522-.935-4.782-2.343zm-2.074-4.513C9.404 8.783 8.375 7.288 7.218 7.288 5.257 7.288 3.666 9.014 3.666 11.144c0 2.13 1.591 3.856 3.552 3.856 1.157 0 2.186-1.495 2.708-3.856zm4.148 0c.522 2.36 1.551 3.856 2.708 3.856 1.961 0 3.552-1.726 3.552-3.856 0-2.13-1.591-3.856-3.552-3.856-1.157 0-2.186 1.495-2.708 3.856z"/>
              </svg>
            </span>
          </div>

          <!-- 50+ more providers -->
          <a
            href="/docs/integrations"
            class="font-mono text-xs text-[#64748b] hover:text-[#090a0f] transition-colors flex items-center gap-1 group ml-1"
          >
            <span>50+ more providers</span>
            <span class="text-[#94a3b8] transition-transform group-hover:translate-x-0.5">→</span>
          </a>
        </div>
      </div>
    </section>

    <!-- Video Player Showcase (Hero Demo) -->
    <section class="mb-20 sm:mb-24">
      <div class="relative w-full mx-auto">
        <!-- Video Container with 16:9 Aspect Ratio (Sharp edges, no curve radius) -->
        <div
          id="hero-video-container"
          class="relative w-full aspect-video rounded-none border border-[#e2e8f0] bg-black shadow-xl overflow-hidden"
        >
          <iframe
            src="https://www.youtube.com/embed/dQw4w9WgXcQ"
            title="December Demo Video"
            class="w-full h-full border-0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
          ></iframe>
        </div>
      </div>
    </section>

    <!-- Editorial & What We Do Section (Supermemory Style) -->
    <section class="mb-20 sm:mb-24">
      <!-- Editorial Narrative Paragraph (Image 1 reference) -->
      <div class="max-w-3xl mb-12 sm:mb-16">
        <p class="text-lg sm:text-xl md:text-[22px] font-normal text-[#1e293b] leading-[1.65] tracking-tight">
          December is an coding agent that lives in your terminal. It understands your codebase and helps you build faster by writing code, fixing bugs, and running commands. Use it directly in your terminal or alongside your favorite IDE.
        </p>
      </div>

      <!-- What We Do Feature List (Image 2 reference) -->
      <div class="max-w-3xl">
        <h2 class="text-2xl sm:text-3xl font-medium tracking-tight text-[#090a0f] mb-8 sm:mb-10">
          What we do
        </h2>

        <div class="space-y-8 sm:space-y-10">
          <!-- 1. Writes code & runs commands -->
          <div class="flex items-start gap-4 sm:gap-6">
            <div class="w-14 h-14 sm:w-16 sm:h-16 shrink-0 rounded-2xl bg-[#0462ee] flex items-center justify-center shadow-sm relative overflow-hidden">
              <svg class="absolute inset-0 w-full h-full opacity-20" viewBox="0 0 100 100" fill="none" stroke="white" stroke-width="0.8">
                <circle cx="50" cy="50" r="42" stroke-dasharray="2 2" />
                <circle cx="50" cy="50" r="26" />
                <line x1="10" y1="50" x2="90" y2="50" />
              </svg>
              <svg class="w-6 h-6 sm:w-7 sm:h-7 text-white relative z-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="4 17 10 11 4 5"></polyline>
                <line x1="12" y1="19" x2="20" y2="19"></line>
              </svg>
            </div>
            <div class="flex-1 pt-0.5 sm:pt-1">
              <h3 class="text-base sm:text-lg font-semibold text-[#090a0f] tracking-tight">
                Writes code & runs commands:
              </h3>
              <p class="mt-1 text-sm sm:text-base text-[#52525b] leading-relaxed">
                Ask it to build features, fix bugs, or run tests. It does the work for you.
              </p>
            </div>
          </div>

          <!-- 2. Cloud Handoff -->
          <div class="flex items-start gap-4 sm:gap-6">
            <div class="w-14 h-14 sm:w-16 sm:h-16 shrink-0 rounded-2xl bg-[#0462ee] flex items-center justify-center shadow-sm relative overflow-hidden">
              <svg class="absolute inset-0 w-full h-full opacity-20" viewBox="0 0 100 100" fill="none" stroke="white" stroke-width="0.8">
                <ellipse cx="50" cy="50" rx="42" ry="20" />
                <ellipse cx="50" cy="50" rx="20" ry="42" />
              </svg>
              <svg class="w-6 h-6 sm:w-7 sm:h-7 text-white relative z-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"></path>
                <polyline points="13 11 16 8 19 11"></polyline>
                <line x1="16" y1="8" x2="16" y2="15"></line>
              </svg>
            </div>
            <div class="flex-1 pt-0.5 sm:pt-1">
              <h3 class="text-base sm:text-lg font-semibold text-[#090a0f] tracking-tight">
                Cloud Handoff:
              </h3>
              <p class="mt-1 text-sm sm:text-base text-[#52525b] leading-relaxed">
                Use <code class="font-mono text-xs bg-[#f1f5f9] text-[#090a0f] px-1.5 py-0.5 rounded border border-[#e2e8f0]">/handoff</code> to continue your session on <a href="https://trydecember.com/" target="_blank" rel="noopener noreferrer" class="text-[#0462ee] hover:underline font-medium">trydecember.com</a>
              </p>
            </div>
          </div>

          <!-- 3. Bring your own AI -->
          <div class="flex items-start gap-4 sm:gap-6">
            <div class="w-14 h-14 sm:w-16 sm:h-16 shrink-0 rounded-2xl bg-[#0462ee] flex items-center justify-center shadow-sm relative overflow-hidden">
              <svg class="absolute inset-0 w-full h-full opacity-20" viewBox="0 0 100 100" fill="none" stroke="white" stroke-width="0.8">
                <polygon points="50,10 90,90 10,90" />
                <polygon points="50,90 90,10 10,10" />
              </svg>
              <svg class="w-6 h-6 sm:w-7 sm:h-7 text-white relative z-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="3"></circle>
                <path d="M12 3v3m0 12v3M3 12h3m12 0h3m-3.5-6.5l-2 2m-7 7l-2 2m0-11l2 2m7 7l2 2"></path>
              </svg>
            </div>
            <div class="flex-1 pt-0.5 sm:pt-1">
              <h3 class="text-base sm:text-lg font-semibold text-[#090a0f] tracking-tight">
                Bring your own AI:
              </h3>
