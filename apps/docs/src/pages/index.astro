---
import BaseLayout from '../layouts/BaseLayout.astro';
import CloudNudge from '../components/CloudNudge.astro';

const appUrl = import.meta.env.APP_URL || (import.meta.env.DEV ? 'http://localhost:3000' : 'https://app.trydecember.com');
---

<BaseLayout
  title="December | A (So Much) Better Coding Agent"
  description="December is a (so much) better coding agent. It writes code, fixes bugs, and runs commands directly in your terminal and cloud."
  canonicalUrl="https://trydecember.com"
  hideHeader={false}
  hideFooter={false}
>
  <!-- Page Container: Generous left & right margins with compact vertical rhythm -->
  <div class="mx-auto max-w-[940px] px-6 sm:px-8 md:px-10 lg:px-12 pt-8 pb-1 sm:pt-12 sm:pb-2">
    
    <!-- Hero Section -->
    <section class="mb-16 sm:mb-20">
      <!-- Centered Hero Header & CLI Script -->
      <div class="text-center max-w-3xl mx-auto flex flex-col items-center">
        <!-- Headline -->
        <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-[54px] font-medium tracking-[-0.035em] text-[#090a0f] leading-[1.12] sm:leading-[1.08] text-center">
          december, a (so much) better<br class="hidden sm:inline" />coding agent.
        </h1>

        <!-- Subtitle -->
        <p class="mt-4 sm:mt-5 text-base sm:text-lg md:text-[19px] text-[#52525b] font-normal leading-relaxed text-center max-w-xl sm:max-w-2xl">
          It helps you build faster by writing code, fixing bugs, and running commands directly in your terminal or alongside your favorite IDE.
        </p>

        <!-- Quick Install Command Bar -->
        <div class="mt-7 sm:mt-8 w-full max-w-[550px] mx-auto">
          <!-- Command Bar with Package Manager Dropdown -->
          <div class="relative w-full" id="hero-install-container">
            <div class="corner-brackets relative h-10 flex items-center justify-between border border-[#e2e8f0] bg-white rounded-none pl-3 sm:pl-3.5 pr-1.5 transition-all hover:border-[#87b2f4]">
              <span class="corner-brackets-tr"></span>
              <span class="corner-brackets-bl"></span>
              <!-- Command Text button -->
              <button
                id="hero-copy-cmd-btn"
                type="button"
                class="flex-1 min-w-0 flex items-center gap-2 font-mono text-xs sm:text-[13px] text-[#1e293b] text-left cursor-pointer focus:outline-none overflow-hidden"
                title="Click to copy command"
              >
                <span class="text-[#87b2f4] select-none font-semibold shrink-0">$</span>
                <span id="hero-display-cmd" data-cmd="curl -fsSL https://trydecember.com/install.sh | bash" class="font-normal text-[#0f172a] truncate">curl -fsSL https://trydecember.com/install.sh <span class="text-[#87b2f4] font-semibold">|</span> bash</span>
              </button>

              <!-- Actions: Copy Button + Dropdown Toggle -->
              <div class="flex items-center gap-1 ml-2 shrink-0">
                <!-- Copy Button -->
                <button
                  id="hero-copy-icon-btn"
                  type="button"
                  class="w-7 h-7 flex items-center justify-center text-[#64748b] hover:text-[#090a0f] hover:bg-[#f8fafc] transition-colors cursor-pointer focus:outline-none rounded-[2px]"
                  title="Copy command"
                  aria-label="Copy install command"
                >
                  <svg id="hero-copy-icon" class="w-3.5 h-3.5 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                    <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                  </svg>
                </button>

                <div class="h-4 w-px bg-[#e2e8f0]" aria-hidden="true"></div>

                <!-- Dropdown Toggle Button -->
                <button
                  id="pm-dropdown-toggle"
                  type="button"
                  class="h-7 px-1.5 flex items-center justify-center gap-1 text-[#64748b] hover:text-[#090a0f] hover:bg-[#f8fafc] transition-colors focus:outline-none cursor-pointer rounded-[2px]"
                  aria-expanded="false"
                  aria-haspopup="true"
                  title="Choose install method"
                  aria-label="Choose install method"
                >
                  <svg id="pm-dropdown-chevron" class="w-3.5 h-3.5 transition-transform duration-200 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M6 9l6 6 6-6" />
                  </svg>
                </button>
              </div>
            </div>

            <!-- Dropdown Menu (bash, powershell, npm with Logos & Active State) -->
            <div
              id="pm-dropdown-menu"
              class="hidden absolute right-0 top-full mt-1.5 z-50 w-56 border border-[#e2e8f0] bg-white p-1.5 shadow-xl font-mono text-xs rounded-none"
            >
              <div class="px-2.5 py-1.5 text-[10px] uppercase tracking-wider text-[#94a3b8] font-semibold border-b border-[#f1f5f9] mb-1 flex items-center justify-between">
                <span>Install via</span>
                <span class="text-[9px] text-[#cbd5e1] font-mono font-normal">CLI</span>
              </div>

              <!-- bash option (default active on unix) -->
              <button
                type="button"
                class="pm-option w-full flex items-center gap-2.5 px-2.5 py-2 text-[#090a0f] bg-[#f8fafc] font-semibold transition-colors cursor-pointer text-left rounded-[2px]"
                data-pm="bash"
                data-cmd="curl -fsSL https://trydecember.com/install.sh | bash"
              >
                <svg class="w-4 h-4 shrink-0" viewBox="0 0 128 128" fill="none">
                  <path fill="#ffffff" d="M112.205 26.129 71.8 2.142A15.326 15.326 0 0 0 64.005 0c-2.688 0-5.386.717-7.796 2.152L15.795 26.14C10.976 28.999 8 34.289 8 40.018v47.975c0 5.729 2.967 11.019 7.796 13.878L56.2 125.858A15.193 15.193 0 0 0 63.995 128a15.32 15.32 0 0 0 7.796-2.142l40.414-23.987c4.819-2.86 7.796-8.16 7.796-13.878V40.007c0-5.718-2.967-11.019-7.796-13.878z"/>
                  <path fill="#293138" d="M112.205 26.129 71.8 2.142A15.326 15.326 0 0 0 64.005 0c-2.688 0-5.386.717-7.796 2.152L15.795 26.14C10.976 28.999 8 34.289 8 40.018v47.975c0 5.729 2.967 11.019 7.796 13.878L56.2 125.858A15.193 15.193 0 0 0 63.995 128a15.32 15.32 0 0 0 7.796-2.142l40.414-23.987c4.819-2.86 7.796-8.16 7.796-13.878V40.007c0-5.718-2.967-11.019-7.796-13.878zm-31.29 74.907.063 3.448c0 .418-.267.889-.588 1.06l-2.046 1.178c-.321.16-.6-.032-.6-.45l-.032-3.394c-1.745.728-3.523.9-4.647.45-.214-.086-.31-.397-.225-.76l.739-3.117c.064-.246.193-.493.364-.643a.726.726 0 0 1 .193-.139c.117-.064.235-.075.332-.032 1.22.407 2.773.214 4.272-.535 1.907-.964 3.18-2.913 3.16-4.84-.022-1.757-.964-2.474-3.267-2.496-2.934.01-5.675-.567-5.718-4.894-.032-3.555 1.81-7.26 4.744-9.595l-.032-3.48c0-.428.257-.9.589-1.07l1.98-1.264c.322-.161.6.042.6.46l.033 3.48c1.456-.578 2.72-.738 3.865-.47.247.063.364.406.257.802l-.77 3.084a1.372 1.372 0 0 1-.354.622.825.825 0 0 1-.203.15c-.108.053-.204.064-.3.053-.525-.118-1.767-.385-3.727.6-2.056 1.038-2.773 2.827-2.763 4.155.022 1.585.825 2.066 3.63 2.11 3.738.063 5.344 1.691 5.387 5.45.053 3.684-1.917 7.657-4.937 10.077zm28.206-64.787L70.89 59.86c-4.765 2.784-8.278 5.911-8.288 11.662v47.107c0 3.437 1.392 5.665 3.523 6.318a12.81 12.81 0 0 1-2.12.204c-2.239 0-4.445-.61-6.383-1.757L17.219 99.408c-3.951-2.345-6.403-6.725-6.403-11.426V40.007c0-4.7 2.452-9.08 6.403-11.426L57.634 4.594a12.555 12.555 0 0 1 6.382-1.756c2.238 0 4.444.61 6.382 1.756l40.415 23.987c3.33 1.981 5.579 5.397 6.21 9.242-1.36-2.86-4.38-3.63-7.902-1.574z"/>
                  <path fill="#4fa847" d="m101.614 92.619-10.066 6.018c-.268.16-.46.332-.46.653v2.635c0 .32.214.46.481.3l10.216-6.212c.268-.16.31-.45.31-.77v-2.324c0-.322-.213-.45-.481-.3z"/>
                </svg>
                <span>bash</span>
                <svg class="pm-check w-3.5 h-3.5 text-[#87b2f4] ml-auto shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12" />
                </svg>
              </button>

              <!-- powershell option (default active on windows) -->
              <button
                type="button"
                class="pm-option w-full flex items-center gap-2.5 px-2.5 py-2 text-[#1e293b] hover:bg-[#f8fafc] hover:text-[#090a0f] transition-colors cursor-pointer text-left rounded-[2px]"
                data-pm="powershell"
                data-cmd="irm https://trydecember.com/install.ps1 | iex"
              >
                <svg class="w-4 h-4 shrink-0" viewBox="0 0 128 128" fill="none">
                  <defs>
                    <linearGradient id="ps-icon-a" x1="96.3" x2="25.5" y1="35.1" y2="98.4" gradientTransform="matrix(1 0 0 -1 0 128)" gradientUnits="userSpaceOnUse">
                      <stop offset="0" stop-color="#a9c8ff"/>
                      <stop offset="1" stop-color="#c7e6ff"/>
                    </linearGradient>
                    <linearGradient id="ps-icon-b" x1="25.3" x2="94.6" y1="98.3" y2="36.8" gradientTransform="matrix(1 0 0 -1 0 128)" gradientUnits="userSpaceOnUse">
                      <stop offset="0" stop-color="#2d4664"/>
                      <stop offset=".17" stop-color="#29405b"/>
                      <stop offset=".45" stop-color="#1e2f43"/>
                      <stop offset=".79" stop-color="#0c131b"/>
                      <stop offset="1" stop-color="#05080c"/>
                    </linearGradient>
                  </defs>
                  <path fill="url(#ps-icon-a)" fill-rule="evenodd" d="M7.2 110.5c-1.7 0-3.1-.7-4.1-1.9-1-1.2-1.3-2.9-.9-4.6l18.6-80.5c.8-3.4 4-6 7.4-6h92.6c1.7 0 3.1.7 4.1 1.9 1 1.2 1.3 2.9.9 4.6l-18.6 80.5c-.8 3.4-4 6-7.4 6H7.2z" clip-rule="evenodd" opacity=".8"/>
                  <path fill="url(#ps-icon-b)" fill-rule="evenodd" d="M120.3 18.5H28.5c-2.9 0-5.7 2.3-6.4 5.2L3.7 104.3c-.7 2.9 1.1 5.2 4 5.2h91.8c2.9 0 5.7-2.3 6.4-5.2l18.4-80.5c.7-2.9-1.1-5.3-4-5.3z" clip-rule="evenodd"/>
                  <path fill="#2C5591" fill-rule="evenodd" d="M64.2 88.3h22.3c2.6 0 4.7 2.2 4.7 4.9s-2.1 4.9-4.7 4.9H64.2c-2.6 0-4.7-2.2-4.7-4.9s2.1-4.9 4.7-4.9zM78.7 66.5c-.4.8-1.2 1.6-2.6 2.6L34.6 98.9c-2.3 1.6-5.5 1-7.3-1.4-1.7-2.4-1.3-5.7.9-7.3l37.4-27.1v-.6l-23.5-25c-1.9-2-1.7-5.3.4-7.4 2.2-2 5.5-2 7.4 0l28.2 30c1.7 1.9 1.8 4.5.6 6.4z" clip-rule="evenodd"/>
                  <path fill="#FFF" fill-rule="evenodd" d="M77.6 65.5c-.4.8-1.2 1.6-2.6 2.6L33.6 97.9c-2.3 1.6-5.5 1-7.3-1.4-1.7-2.4-1.3-5.7.9-7.3l37.4-27.1v-.6l-23.5-25c-1.9-2-1.7-5.3.4-7.4 2.2-2 5.5-2 7.4 0l28.2 30c1.7 1.8 1.8 4.4.5 6.4zM63.5 87.8h22.3c2.6 0 4.7 2.1 4.7 4.6 0 2.6-2.1 4.6-4.7 4.6H63.5c-2.6 0-4.7-2.1-4.7-4.6 0-2.6 2.1-4.6 4.7-4.6z" clip-rule="evenodd"/>
                </svg>
                <span>powershell</span>
                <svg class="pm-check hidden w-3.5 h-3.5 text-[#87b2f4] ml-auto shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12" />
                </svg>
              </button>

              <!-- npm option -->
              <button
                type="button"
                class="pm-option w-full flex items-center gap-2.5 px-2.5 py-2 text-[#1e293b] hover:bg-[#f8fafc] hover:text-[#090a0f] transition-colors cursor-pointer text-left rounded-[2px]"
                data-pm="npm"
                data-cmd="npm install -g @trydecember/cli"
              >
                <svg class="w-4 h-4 shrink-0 text-[#cb3837]" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M1.763 0C.786 0 0 .786 0 1.763v20.474C0 23.214.786 24 1.763 24h20.474c.977 0 1.763-.786 1.763-1.763V1.763C24 .786 23.214 0 22.237 0zM5.13 5.323l13.837.019-.009 13.836h-3.464l.01-10.382h-3.456L12.04 19.17H5.113z"/>
                </svg>
                <span>npm</span>
                <svg class="pm-check hidden w-3.5 h-3.5 text-[#87b2f4] ml-auto shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12" />
                </svg>
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- USE MODELS FROM Strip (Full Length) -->
      <div class="mt-8 sm:mt-10 py-1 flex items-center justify-start sm:justify-center gap-x-2 sm:gap-x-2.5 overflow-x-auto flex-nowrap [scrollbar-width:none] [&::-webkit-scrollbar]:hidden w-full px-1">
        <span class="font-mono text-[10px] sm:text-xs text-[#64748b] font-medium tracking-wider shrink-0 mr-0.5 sm:mr-1">USE MODELS FROM</span>
            <!-- OpenAI -->
            <span title="OpenAI" class="hover:opacity-80 transition-opacity cursor-pointer inline-flex items-center shrink-0">
              <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="#10a37f">
                <path d="M9.205 8.658v-2.26c0-.19.072-.333.238-.428l4.543-2.616c.619-.357 1.356-.523 2.117-.523 2.854 0 4.662 2.212 4.662 4.566 0 .167 0 .357-.024.547l-4.71-2.759a.797.797 0 00-.856 0l-5.97 3.473zm10.609 8.8V12.06c0-.333-.143-.57-.429-.737l-5.97-3.473 1.95-1.118a.433.433 0 01.476 0l4.543 2.617c1.309.76 2.189 2.378 2.189 3.948 0 1.808-1.07 3.473-2.76 4.163zM7.802 12.703l-1.95-1.142c-.167-.095-.239-.238-.239-.428V5.899c0-2.545 1.95-4.472 4.591-4.472 1 0 1.927.333 2.712.928L8.23 5.067c-.285.166-.428.404-.428.737v6.898zM12 15.128l-2.795-1.57v-3.33L12 8.658l2.795 1.57v3.33L12 15.128zm1.796 7.23c-1 0-1.927-.332-2.712-.927l4.686-2.712c.285-.166.428-.404.428-.737v-6.898l1.974 1.142c.167.095.238.238.238.428v5.233c0 2.545-1.974 4.472-4.614 4.472zm-5.637-5.303l-4.544-2.617c-1.308-.761-2.188-2.378-2.188-3.948A4.482 4.482 0 014.21 6.327v5.423c0 .333.143.571.428.738l5.947 3.449-1.95 1.118a.432.432 0 01-.476 0zm-.262 3.9c-2.688 0-4.662-2.021-4.662-4.519 0-.19.024-.38.047-.57l4.686 2.71c.286.167.571.167.856 0l5.97-3.448v2.26c0 .19-.07.333-.237.428l-4.543 2.616c-.619.357-1.356.523-2.117.523zm5.899 2.83a5.947 5.947 0 005.827-4.756C22.287 18.339 24 15.84 24 13.296c0-1.665-.713-3.282-1.998-4.448.119-.5.19-.999.19-1.498 0-3.401-2.759-5.947-5.946-5.947-.642 0-1.26.095-1.88.31A5.962 5.962 0 0010.205 0a5.947 5.947 0 00-5.827 4.757C1.713 5.447 0 7.945 0 10.49c0 1.666.713 3.283 1.998 4.448-.119.5-.19 1-.19 1.499 0 3.401 2.759 5.946 5.946 5.946.642 0 1.26-.095 1.88-.309a5.96 5.96 0 004.162 1.713z"></path>
              </svg>
            </span>

            <!-- Anthropic -->
            <span title="Anthropic" class="hover:opacity-80 transition-opacity cursor-pointer inline-flex items-center shrink-0">
              <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="#d97757">
                <path d="M13.827 3.52h3.603L24 20h-3.603l-6.57-16.48zm-7.258 0h3.767L16.906 20h-3.674l-1.343-3.461H5.017l-1.344 3.46H0L6.57 3.522zm4.132 9.959L8.453 7.687 6.205 13.48H10.7z"></path>
              </svg>
            </span>

            <!-- Google Gemini -->
            <span title="Google Gemini" class="hover:opacity-80 transition-opacity cursor-pointer inline-flex items-center shrink-0">
              <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24">
                <path d="M20.616 10.835a14.147 14.147 0 01-4.45-3.001 14.111 14.111 0 01-3.678-6.452.503.503 0 00-.975 0 14.134 14.134 0 01-3.679 6.452 14.155 14.155 0 01-4.45 3.001c-.65.28-1.318.505-2.002.678a.502.502 0 000 .975c.684.172 1.35.397 2.002.677a14.147 14.147 0 014.45 3.001 14.112 14.112 0 013.679 6.453.502.502 0 00.975 0c.172-.685.397-1.351.677-2.003a14.145 14.145 0 013.001-4.45 14.113 14.113 0 016.453-3.678.503.503 0 000-.975 13.245 13.245 0 01-2.003-.678z" fill="#3186FF"></path><path d="M20.616 10.835a14.147 14.147 0 01-4.45-3.001 14.111 14.111 0 01-3.678-6.452.503.503 0 00-.975 0 14.134 14.134 0 01-3.679 6.452 14.155 14.155 0 01-4.45 3.001c-.65.28-1.318.505-2.002.678a.502.502 0 000 .975c.684.172 1.35.397 2.002.677a14.147 14.147 0 014.45 3.001 14.112 14.112 0 013.679 6.453.502.502 0 00.975 0c.172-.685.397-1.351.677-2.003a14.145 14.145 0 013.001-4.45 14.113 14.113 0 016.453-3.678.503.503 0 000-.975 13.245 13.245 0 01-2.003-.678z" fill="url(#gemini-grad-0)"></path><path d="M20.616 10.835a14.147 14.147 0 01-4.45-3.001 14.111 14.111 0 01-3.678-6.452.503.503 0 00-.975 0 14.134 14.134 0 01-3.679 6.452 14.155 14.155 0 01-4.45 3.001c-.65.28-1.318.505-2.002.678a.502.502 0 000 .975c.684.172 1.35.397 2.002.677a14.147 14.147 0 014.45 3.001 14.112 14.112 0 013.679 6.453.502.502 0 00.975 0c.172-.685.397-1.351.677-2.003a14.145 14.145 0 013.001-4.45 14.113 14.113 0 016.453-3.678.503.503 0 000-.975 13.245 13.245 0 01-2.003-.678z" fill="url(#gemini-grad-1)"></path><path d="M20.616 10.835a14.147 14.147 0 01-4.45-3.001 14.111 14.111 0 01-3.678-6.452.503.503 0 00-.975 0 14.134 14.134 0 01-3.679 6.452 14.155 14.155 0 01-4.45 3.001c-.65.28-1.318.505-2.002.678a.502.502 0 000 .975c.684.172 1.35.397 2.002.677a14.147 14.147 0 014.45 3.001 14.112 14.112 0 013.679 6.453.502.502 0 00.975 0c.172-.685.397-1.351.677-2.003a14.145 14.145 0 013.001-4.45 14.113 14.113 0 016.453-3.678.503.503 0 000-.975 13.245 13.245 0 01-2.003-.678z" fill="url(#gemini-grad-2)"></path><defs><linearGradient gradientUnits="userSpaceOnUse" id="gemini-grad-0" x1="7" x2="11" y1="15.5" y2="12"><stop stop-color="#08B962"></stop><stop offset="1" stop-color="#08B962" stop-opacity="0"></stop></linearGradient><linearGradient gradientUnits="userSpaceOnUse" id="gemini-grad-1" x1="8" x2="11.5" y1="5.5" y2="11"><stop stop-color="#F94543"></stop><stop offset="1" stop-color="#F94543" stop-opacity="0"></stop></linearGradient><linearGradient gradientUnits="userSpaceOnUse" id="gemini-grad-2" x1="3.5" x2="17.5" y1="13.5" y2="12"><stop stop-color="#FABC12"></stop><stop offset=".46" stop-color="#FABC12" stop-opacity="0"></stop></linearGradient></defs>
              </svg>
            </span>

            <!-- DeepSeek -->
