---
import BaseLayout from '../layouts/BaseLayout.astro';

// Terms of Service Page
// Styled with high-craft docs layout, light theme typography, and structured sections
---

<BaseLayout
  title="Terms of Service — December"
  description="Terms of Service governing your use of December software, CLI, and cloud execution sandboxes."
  canonicalUrl="https://trydecember.com/terms"
  activePath="/terms"
  hideHeader={false}
  hideFooter={false}
>
  <div class="mx-auto max-w-[940px] px-6 sm:px-8 md:px-10 lg:px-12 pt-8 pb-16 sm:pt-12 sm:pb-24">
    <!-- Breadcrumb Navigation Bar -->
    <nav class="flex items-center font-mono text-xs text-[#64748b] mb-8">
      <div class="flex items-center gap-2">
        <a href="/" class="hover:text-[#090a0f] transition-colors">home</a>
        <span class="text-[#cbd5e1]">/</span>
        <span class="text-[#64748b]">legal</span>
        <span class="text-[#cbd5e1]">/</span>
        <span class="text-[#090a0f] font-medium">[terms]</span>
      </div>
    </nav>

    <!-- Document Header -->
    <header class="mb-10 pb-6 border-b border-[#e2e8f0]">
      <div class="flex flex-wrap items-center justify-between gap-3 mb-3">
        <div class="inline-flex items-center gap-2 font-mono text-xs text-[#64748b] bg-[#f8fafc] border border-[#e2e8f0] px-2.5 py-1">
          <span class="inline-block w-1.5 h-1.5 bg-[#87b2f4]"></span>
          <span>LEGAL & COMPLIANCE</span>
        </div>
        <div class="flex items-center gap-3 font-mono text-xs text-[#64748b]">
          <span>Effective: September 2026</span>
          <span class="text-[#cbd5e1]">/</span>
          <span>v2.1</span>
        </div>
      </div>
      <h1 class="text-2xl sm:text-3xl md:text-4xl font-medium tracking-tight text-[#090a0f] leading-snug">
        Terms of Service
      </h1>
      <p class="mt-3 text-sm sm:text-base text-[#52525b] leading-relaxed max-w-2xl">
        These Terms of Service ("Terms") govern your access to and use of December software applications,
        command-line interfaces, and cloud execution environments provided by Phasehumans Inc.
        ("Phasehumans", "December", "we", "us", or "our").
      </p>
    </header>

    <!-- Key Guarantees Summary Card -->
    <section class="border border-[#e2e8f0] bg-[#f8fafc] p-5 sm:p-6 mb-10 corner-brackets relative">
      <div class="flex items-center justify-between mb-4">
        <span class="font-mono text-xs text-[#64748b] uppercase tracking-wider flex items-center gap-2">
          <span class="text-[#87b2f4] font-semibold">//</span>
          <span>00 / Key Guarantees at a Glance</span>
        </span>
        <span class="font-mono text-[11px] text-[#87b2f4] bg-white border border-[#e2e8f0] px-2 py-0.5">
          DEVELOPER FIRST
        </span>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs sm:text-[13px] text-[#52525b]">
        <div class="border border-[#e2e8f0] bg-white p-3.5 space-y-1.5">
          <div class="font-semibold text-[#090a0f] flex items-center gap-1.5">
            <span class="text-[#10b981]">✓</span>
            <span>100% Code Ownership</span>
          </div>
          <p class="leading-relaxed">
            You retain complete ownership, copyright, and IP rights over your repositories, prompts, and all code outputs.
          </p>
        </div>
        <div class="border border-[#e2e8f0] bg-white p-3.5 space-y-1.5">
          <div class="font-semibold text-[#090a0f] flex items-center gap-1.5">
            <span class="text-[#10b981]">✓</span>
            <span>Zero Model Training</span>
          </div>
          <p class="leading-relaxed">
            We never train, fine-tune, or license private codebase contents or customer prompts for AI models.
          </p>
        </div>
        <div class="border border-[#e2e8f0] bg-white p-3.5 space-y-1.5">
          <div class="font-semibold text-[#090a0f] flex items-center gap-1.5">
            <span class="text-[#10b981]">✓</span>
            <span>BYOK Direct Billing</span>
          </div>
          <p class="leading-relaxed">
            Bring your own API keys for Anthropic, OpenAI, Gemini, or OpenRouter with zero intermediary markup.
          </p>
        </div>
        <div class="border border-[#e2e8f0] bg-white p-3.5 space-y-1.5">
          <div class="font-semibold text-[#090a0f] flex items-center gap-1.5">
            <span class="text-[#10b981]">✓</span>
            <span>Ephemeral Sandboxing</span>
          </div>
          <p class="leading-relaxed">
            Cloud handoff runs in isolated micro-VM sandboxes that automatically terminate upon session end.
          </p>
        </div>
      </div>
    </section>

    <!-- Table of Contents Jump Grid -->
    <div class="border border-[#e2e8f0] bg-white p-4 sm:p-5 mb-10">
      <div class="flex items-center justify-between text-xs font-mono text-[#64748b] uppercase tracking-wider mb-3">
        <span>Table of Contents</span>
        <span class="text-[#94a3b8]">8 Sections</span>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-2 font-mono text-xs text-[#52525b]">
        <a href="#acceptance" class="hover:text-[#87b2f4] transition-colors flex items-center gap-2">
          <span class="text-[#87b2f4]">01 /</span>
          <span>Acceptance & Eligibility</span>
        </a>
        <a href="#license" class="hover:text-[#87b2f4] transition-colors flex items-center gap-2">
          <span class="text-[#87b2f4]">02 /</span>
          <span>License & Permitted Use</span>
        </a>
        <a href="#ownership" class="hover:text-[#87b2f4] transition-colors flex items-center gap-2">
          <span class="text-[#87b2f4]">03 /</span>
          <span>Code Ownership & IP</span>
        </a>
        <a href="#billing" class="hover:text-[#87b2f4] transition-colors flex items-center gap-2">
          <span class="text-[#87b2f4]">04 /</span>
          <span>Subscriptions & BYOK</span>
        </a>
        <a href="#sandboxes" class="hover:text-[#87b2f4] transition-colors flex items-center gap-2">
          <span class="text-[#87b2f4]">05 /</span>
          <span>Cloud Sandboxes & Hosting</span>
        </a>
        <a href="#acceptable-use" class="hover:text-[#87b2f4] transition-colors flex items-center gap-2">
          <span class="text-[#87b2f4]">06 /</span>
          <span>Acceptable Use Policy</span>
        </a>
        <a href="#disclaimers" class="hover:text-[#87b2f4] transition-colors flex items-center gap-2">
          <span class="text-[#87b2f4]">07 /</span>
          <span>Warranty Disclaimers</span>
        </a>
        <a href="#contact" class="hover:text-[#87b2f4] transition-colors flex items-center gap-2">
          <span class="text-[#87b2f4]">08 /</span>
          <span>Governing Law & Contact</span>
        </a>
      </div>
    </div>

    <!-- Main Terms Content Body -->
    <article class="docs-prose w-full">
      <!-- Section 1 -->
      <section id="acceptance">
        <h2>
          <span class="font-mono text-xs text-[#87b2f4] mr-2">01 /</span>
          Acceptance of Terms & Eligibility
        </h2>
        <p>
          By downloading, installing, running, or accessing December (including the December CLI tool,
          the desktop companions, web applications, and cloud sandbox services), you agree to be bound
          by these Terms. If you are entering into these Terms on behalf of a company, organization, or
          other legal entity, you represent that you have the authority to bind such entity to these Terms.
        </p>
        <p>
          If you do not agree to all terms and conditions set forth herein, you must immediately cease
          downloading, installing, or using the December software and related services.
        </p>
      </section>

      <!-- Section 2 -->
      <section id="license">
        <h2>
          <span class="font-mono text-xs text-[#87b2f4] mr-2">02 /</span>
          License & Permitted Developer Use
        </h2>
        <p>
          Subject to your compliance with these Terms, Phasehumans grants you a revocable, non-exclusive,
          non-transferable, limited right to install and use the December software to develop, test, debug,
          and deploy your software applications.
        </p>
        <p>
          Components of December released under open-source software licenses (such as the Apache-2.0 or
          MIT license) are governed exclusively by their respective license agreements located within the
          relevant source repositories.
        </p>
      </section>

      <!-- Section 3 -->
      <section id="ownership">
        <h2>
          <span class="font-mono text-xs text-[#87b2f4] mr-2">03 /</span>
          Code Ownership & Intellectual Property
        </h2>
        
        <!-- Highlighted Callout Box -->
        <blockquote>
          <strong>Core Principle:</strong> Your code belongs to you. Phasehumans does not assert any
          ownership, copyright, patent, or proprietary interest in your source code, repositories,
          prompts, terminal instructions, or the outputs generated by December.
        </blockquote>

        <p>
          Between you and Phasehumans:
        </p>
        <ul>
          <li>
            <strong>Customer Content:</strong> You retain all right, title, and interest in and to all code,
            text, documentation, repository files, configuration files, and prompts that you provide to December.
          </li>
          <li>
            <strong>Generated Code Outputs:</strong> Any code, diffs, patches, or test suites generated by
            December during your sessions are assigned to you upon generation, subject only to underlying
            open-source licenses of any third-party libraries you choose to incorporate.
          </li>
          <li>
            <strong>No AI Model Training:</strong> We do not use your private code, prompt history, or
            generated outputs to train, retrain, or improve frontier machine learning foundation models.
          </li>
        </ul>
      </section>

      <!-- Section 4 -->
      <section id="billing">
        <h2>
          <span class="font-mono text-xs text-[#87b2f4] mr-2">04 /</span>
          Subscriptions, BYOK & Compute Billing
        </h2>
        <p>
          December provides both local workstation execution and optional cloud infrastructure:
        </p>
        <ul>
          <li>
            <strong>Bring Your Own Key (BYOK):</strong> When using your personal API keys (such as OpenAI,
            Anthropic, Google Gemini, DeepSeek, or OpenRouter), API fees are billed directly to your provider
            account. Phasehumans does not add surcharges or hidden token fees to direct provider traffic.
          </li>
          <li>
            <strong>December Cloud Sandboxes:</strong> Cloud execution features (such as <code>/handoff</code>
            remote micro-VMs and live web preview hosting) are billed according to your active subscription plan
            or pay-as-you-go compute credit rates.
          </li>
          <li>
            <strong>Billing Cycles & Cancellations:</strong> Paid subscription fees are billed in advance on
            a monthly or annual cycle. You may cancel your subscription at any time via your account dashboard;
            cancellations take effect at the conclusion of the current billing cycle.
          </li>
        </ul>

        <!-- Tiers Comparison Table -->
        <table>
          <thead>
            <tr>
              <th>Tier</th>
              <th>Compute Location</th>
              <th>API Billing</th>
              <th>Code Storage</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>Local CLI (BYOK)</strong></td>
              <td>Your workstation</td>
              <td>Direct with provider</td>
              <td>100% Local to your disk</td>
            </tr>
            <tr>
              <td><strong>Cloud Sandboxes</strong></td>
              <td>Ephemeral Micro-VM</td>
              <td>BYOK or December Credits</td>
              <td>Destroyed on session close</td>
            </tr>
            <tr>
              <td><strong>Team / Enterprise</strong></td>
              <td>Dedicated VPC / Cloud</td>
              <td>Centralized or BYOK</td>
              <td>Encrypted at rest (AES-256)</td>
            </tr>
          </tbody>
        </table>
      </section>

      <!-- Section 5 -->
      <section id="sandboxes">
        <h2>
          <span class="font-mono text-xs text-[#87b2f4] mr-2">05 /</span>
          Cloud Sandbox Isolation & Preview Hosting
        </h2>
        <p>
          When you invoke cloud handoff features (such as <code>/handoff</code>), December provisions an
          isolated micro-virtual machine with dedicated CPU, RAM, and root filesystem privileges to execute
          commands, build artifacts, and spin up live web preview servers.
        </p>
        <p>
          Preview URLs generated for your cloud sessions are routed over secure TLS 1.3 connections. You are
          responsible for securing any public preview URLs and ensuring sensitive credentials or secrets
          are not exposed through public endpoints.
        </p>
      </section>

      <!-- Section 6 -->
      <section id="acceptable-use">
        <h2>
          <span class="font-mono text-xs text-[#87b2f4] mr-2">06 /</span>
          Acceptable Use & Prohibited Activities
        </h2>
        <p>
          You agree not to use December or its cloud execution sandboxes to:
        </p>
        <ul>
          <li>Develop, generate, distribute, or execute malware, ransomware, spyware, or malicious exploits.</li>
          <li>Conduct unauthorized vulnerability assessments, penetration tests, or denial-of-service (DoS) attacks against third parties.</li>
          <li>Circumvent or tamper with security sandboxing, rate limits, or compute isolation barriers.</li>
          <li>Mine cryptocurrency or utilize cloud sandbox compute for unauthorized distributed workloads.</li>
          <li>Violate applicable local, national, or international export control laws and regulations.</li>
        </ul>
      </section>

      <!-- Section 7 -->
      <section id="disclaimers">
        <h2>
          <span class="font-mono text-xs text-[#87b2f4] mr-2">07 /</span>
          Warranty Disclaimers & Limitation of Liability
        </h2>
        <p>
          <strong>As-Is Provision:</strong> December is an AI-assisted software development companion
          provided on an "as-is" and "as-available" basis without warranties of any kind, either express or
          implied, including but not limited to warranties of merchantability, fitness for a particular
          purpose, or non-infringement.
        </p>
        <p>
          <strong>Developer Oversight:</strong> Generative AI models may produce incorrect code, hallucinated
          package names, or syntax errors. You acknowledge that you are solely responsible for reviewing,
          compiling, testing, and verifying all code before running it in production environments.
        </p>
        <p>
          <strong>Liability Cap:</strong> To the maximum extent permitted by applicable law, Phasehumans
          shall not be liable for any indirect, incidental, special, consequential, or punitive damages, or
          any loss of profits, data, or operational downtime arising from your use of the software.
        </p>
      </section>

      <!-- Section 8 -->
      <section id="contact">
        <h2>
          <span class="font-mono text-xs text-[#87b2f4] mr-2">08 /</span>
          Governing Law, Amendments & Inquiries
        </h2>
        <p>
          These Terms are governed by the laws of the State of Delaware, United States, without regard to its
          conflict of law principles. We reserve the right to modify these Terms with reasonable advance notice
          posted on our website or distributed via email for material changes.
        </p>
        <p>
          If you have questions regarding these Terms or need to execute a custom enterprise agreement or DPA:
        </p>
      </section>
    </article>

    <!-- Bottom Contact & Cross-Links Card -->
    <div class="mt-12 pt-8 border-t border-[#e2e8f0]">
      <div class="border border-[#e2e8f0] bg-[#f8fafc] p-5 sm:p-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <div class="font-mono text-xs text-[#64748b] uppercase tracking-wider mb-1">
            Questions or Enterprise Inquiries?
          </div>
          <div class="text-sm font-medium text-[#090a0f]">
            Reach out to our legal and compliance team at <a href="mailto:team@trydecember.com" class="text-[#87b2f4] hover:underline">team@trydecember.com</a>.
          </div>
        </div>
        <div class="flex items-center gap-3 shrink-0">
          <a
            href="/privacy"
            class="px-3.5 py-2 border border-[#e2e8f0] bg-white text-xs font-mono text-[#090a0f] hover:border-[#87b2f4] transition-colors"
          >
            Privacy Policy →
          </a>
          <a
            href="/docs/security"
            class="px-3.5 py-2 border border-[#e2e8f0] bg-white text-xs font-mono text-[#090a0f] hover:border-[#87b2f4] transition-colors"
          >
            Security Model →
          </a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style is:global>
  .docs-prose {
    color: #52525b;
    font-size: 15px;
    line-height: 1.7;
  }

  .docs-prose section {
    scroll-margin-top: 5rem;
    margin-bottom: 2.25rem;
  }

  .docs-prose h2 {
    font-size: 1.25rem;
    font-weight: 600;
    color: #090a0f;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    letter-spacing: -0.02em;
  }

  .docs-prose h3 {
    font-size: 1.05rem;
    font-weight: 600;
    color: #090a0f;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
    letter-spacing: -0.01em;
  }

  .docs-prose p {
    margin-bottom: 1.15rem;
    color: #52525b;
    line-height: 1.7;
  }

  .docs-prose ul {
    list-style-type: disc;
    padding-left: 1.5rem;
    margin-bottom: 1.25rem;
    color: #52525b;
  }

  .docs-prose ol {
    list-style-type: decimal;
    padding-left: 1.5rem;
    margin-bottom: 1.25rem;
    color: #52525b;
  }

  .docs-prose li {
    margin-bottom: 0.4rem;
  }

  .docs-prose code {
    font-family: var(--font-mono, monospace);
    font-size: 0.88em;
    color: #090a0f;
    font-weight: 500;
  }

  .docs-prose table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    border: 1px solid #e2e8f0;
    background-color: #ffffff;
    box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.02);
  }

  .docs-prose th {
    background-color: #f8fafc;
    border-bottom: 1px solid #e2e8f0;
    padding: 0.65rem 0.85rem;
    text-align: left;
    font-family: var(--font-mono, monospace);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #64748b;
    font-weight: 600;
  }

  .docs-prose td {
    padding: 0.65rem 0.85rem;
    border-bottom: 1px solid #f1f5f9;
    color: #334155;
    font-size: 0.85rem;
  }

  .docs-prose tr:last-child td {
    border-bottom: none;
  }

  .docs-prose tr:hover td {
    background-color: #f8fafc;
  }

  .docs-prose blockquote {
    border: 1px solid #e2e8f0;
    border-left: 3px solid #87b2f4;
    background-color: #f8fafc;
    padding: 0.85rem 1.15rem;
    margin: 1.25rem 0;
    border-radius: 0;
    color: #52525b;
  }

  .docs-prose strong {
    color: #090a0f;
    font-weight: 600;
  }

  .docs-prose a {
    color: #87b2f4;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .docs-prose a:hover {
    color: #3b82f6;
  }
</style>
