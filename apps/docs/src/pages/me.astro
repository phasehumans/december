---
import BaseLayout from '../layouts/BaseLayout.astro';

const education = [
  {
    school: 'r. c. patel institute of technology',
    degree: 'b.tech in ai & ml',
    period: 'aug 2023 - may 2027',
    // Shorter dates for phones so the school name fits on one line
    mobilePeriod: '2023 - 2027',
  },
];

const work = [
  {
    company: 'aakar foundry',
    role: 'ai engineer',
    period: 'dec 2026 - now',
  },
  {
    company: 'super dots',
    role: 'applied ai engineer',
    period: 'nov 2025 - apr 2026',
  },
];

// mobileSummary: a shorter line for phones, when the summary is too long
const projects: Array<{
  name: string
  summary: string
  mobileSummary?: string
  label: string
  href: string
}> = [
  {
    name: 'december',
    summary: 'a better coding agent',
    label: 'trydecember.com',
    href: 'https://trydecember.com',
  },
  {
    name: 'spacetime',
    summary: 'evals, benchmarks and rl environments',
    label: 'github',
    href: 'https://github.com/phasehumans/spacetime',
  },
  {
    name: 'campuslab',
    summary: 'competitive programming platform',
    label: 'github',
    href: 'https://github.com/phasehumans/campuslab',
  },
];
---

<BaseLayout
  title="Chaitanya Sonawane"
  description="Chaitanya Sonawane | software engineer @trydecember. GitHub: @phasehumans, X: @phasehumans, YouTube: @phasehumans."
  canonicalUrl="https://trydecember.com/me"
  hideHeader={true}
  hideFooter={true}
  hideScrollbar={true}
>
  <!-- Person Schema for Google AI Mode & Knowledge Graph -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Chaitanya Sonawane",
    "alternateName": ["Chetan Sonawane", "phasehumans"],
    "jobTitle": "Software Engineer",
    "alumniOf": {
      "@type": "CollegeOrUniversity",
      "name": "R. C. Patel Institute of Technology"
    },
    "worksFor": {
      "@type": "Organization",
      "name": "December",
      "url": "https://trydecember.com"
    },
    "url": "https://trydecember.com/me",
    "sameAs": [
      "https://github.com/phasehumans",
      "https://x.com/phasehumans",
      "https://www.youtube.com/@phasehumans",
      "https://www.linkedin.com/in/phasehumans/",
      "https://codeforces.com/profile/phasehumans"
    ],
    "description": "Chaitanya Sonawane | software engineer @trydecember"
  })} />

  <div class="min-h-dvh w-full flex flex-col items-center justify-center px-6 py-8 sm:py-16">
    <div class="w-full max-w-[520px] flex flex-col">
    <!-- Intro: name and icons, centered -->
    <div class="flex flex-col items-center text-center select-none">
      <!-- Name -->
      <h1 class="text-sm sm:text-base font-medium text-[#090a0f] tracking-tight">
        Chaitanya Sonawane
      </h1>

      <!-- Role & Organization -->
      <p class="mt-1 text-xs sm:text-[13px] font-mono text-[#64748b]">
        software engineer <a href="/" class="text-[#090a0f] hover:text-[#87b2f4] transition-colors">@trydecember</a>
      </p>

      <!-- Social, Developer & Contact Icons (Subtle Muted Colors) -->
      <nav class="mt-3.5 relative flex flex-wrap items-center justify-center gap-2.5 sm:gap-3 w-full">
        <!-- GitHub -->
        <a
          href="https://github.com/phasehumans"
          target="_blank"
          rel="noopener noreferrer"
          class="group text-[#475569] hover:text-[#090a0f] opacity-75 hover:opacity-100 hover:scale-105 transition-all duration-150 p-0.5"
          aria-label="GitHub"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2A10 10 0 0 0 2 12c0 4.42 2.87 8.17 6.84 9.5.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34-.46-1.16-1.1-1.47-1.1-1.47-.9-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.87 1.52 2.34 1.07 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.92 0-1.11.38-2 1.03-2.71-.1-.25-.45-1.29.1-2.64 0 0 .84-.27 2.75 1.02a9.56 9.56 0 0 1 2.5-.34c.85.04 1.7.15 2.5.34 1.91-1.29 2.75-1.02 2.75-1.02.55 1.35.2 2.39.1 2.64.65.71 1.03 1.6 1.03 2.71 0 3.82-2.34 4.66-4.57 4.91.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0 0 12 2z"></path>
          </svg>
        </a>

        <!-- YouTube -->
        <a
          href="https://www.youtube.com/@phasehumans"
          target="_blank"
          rel="noopener noreferrer"
          class="group text-[#b91c1c] hover:text-[#7f1d1d] opacity-75 hover:opacity-100 hover:scale-105 transition-all duration-150 p-0.5"
          aria-label="YouTube"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24">
            <path fill="currentColor" d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814z"></path>
            <polygon fill="#ffffff" points="9.545 15.568 9.545 8.432 15.818 12"></polygon>
          </svg>
        </a>

        <!-- Twitter / X -->
        <a
          href="https://x.com/phasehumans"
          target="_blank"
          rel="noopener noreferrer"
          class="group text-[#475569] hover:text-[#090a0f] opacity-75 hover:opacity-100 hover:scale-105 transition-all duration-150 p-0.5"
          aria-label="Twitter"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path>
          </svg>
        </a>

        <!-- Codeforces -->
        <a
          href="https://codeforces.com/profile/phasehumans"
          target="_blank"
          rel="noopener noreferrer"
          class="group opacity-75 hover:opacity-100 hover:scale-105 transition-all duration-150 p-0.5"
          aria-label="Codeforces"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24">
            <rect x="4.5" y="11" width="3.5" height="10" rx="1.75" fill="#0284c7"></rect>
            <rect x="10.25" y="3" width="3.5" height="18" rx="1.75" fill="#d97706"></rect>
            <rect x="16" y="7" width="3.5" height="14" rx="1.75" fill="#e11d48"></rect>
          </svg>
        </a>

        <!-- Email -->
        <!--email_off-->
        <div class="relative flex items-center me-email-container">
          <a
            href="mailto:chetan@trydecember.com"
            data-email="chetan@trydecember.com"
            class="me-email-btn group text-[#475569] hover:text-[#090a0f] opacity-75 hover:opacity-100 hover:scale-105 transition-all duration-150 p-0.5 cursor-pointer"
            aria-label="Email"
            title="Click to copy chetan@trydecember.com"
          >
            <svg class="w-4 h-4 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="20" height="16" x="2" y="4" rx="2"></rect>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
            </svg>
          </a>

          <!-- Tooltip: email copied -->
          <div
            class="me-email-tooltip pointer-events-none absolute bottom-full left-1/2 -translate-x-1/2 mb-2 flex items-center gap-1.5 whitespace-nowrap border border-[#1e293b] bg-[#090a0f] px-2 py-0.5 font-mono text-[11px] text-[#f8fafc] shadow-md rounded-[3px] opacity-0 translate-y-1 transition-all duration-150 z-50 select-none"
            role="status"
            aria-live="polite"
          >
            <svg class="w-3 h-3 text-[#87b2f4] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>email copied</span>
            <span class="absolute top-full left-1/2 -translate-x-1/2 -mt-[1px] border-4 border-transparent border-t-[#090a0f]"></span>
          </div>
        </div>
        <!--/email_off-->
      </nav>
    </div>

    <!-- Section: Education -->
    <section class="mt-10 sm:mt-14" aria-labelledby="me-education">
      <h2 id="me-education" class="flex items-center gap-2 font-mono text-xs select-none">
        <span class="text-[#090a0f] font-medium tracking-wider text-[13px] sm:text-sm">education</span>
      </h2>
      <ul class="mt-4 space-y-2.5">
        {education.map((entry) => (
          <li>
            <div class="flex items-baseline justify-between gap-4">
              <span class="min-w-0 text-[13px] sm:text-sm">
                <span class="font-medium text-[#090a0f]">{entry.school}</span>
                <span class="hidden sm:inline font-mono text-xs text-[#64748b]"> / {entry.degree}</span>
              </span>
              <span class="font-mono text-[11px] sm:text-xs text-[#64748b] shrink-0">
                <span class="sm:hidden">{entry.mobilePeriod}</span>
                <span class="hidden sm:inline">{entry.period}</span>
              </span>
            </div>
          </li>
        ))}
      </ul>
    </section>

    <!-- Section: Work -->
    <section class="mt-8 sm:mt-10" aria-labelledby="me-work">
      <h2 id="me-work" class="flex items-center gap-2 font-mono text-xs select-none">
        <span class="text-[#090a0f] font-medium tracking-wider text-[13px] sm:text-sm">work</span>
      </h2>
      <ul class="mt-4 space-y-2.5">
        {work.map((job) => (
          <li>
            <div class="flex items-baseline justify-between gap-4">
              <span class="min-w-0 text-[13px] sm:text-sm">
                <span class="font-medium text-[#090a0f]">{job.company}</span>
                <span class="hidden sm:inline font-mono text-xs text-[#64748b]"> / {job.role}</span>
              </span>
              <span class="font-mono text-[11px] sm:text-xs text-[#64748b] shrink-0">{job.period}</span>
            </div>
          </li>
        ))}
      </ul>
    </section>

    <!-- Section: Projects. Mobile: two lines (linked name and link text, then about text below). sm+: one line, the name link stretches over the whole row. The link text is hidden from screen readers because the name link has the same target -->
    <section class="mt-8 sm:mt-10" aria-labelledby="me-projects">
      <h2 id="me-projects" class="flex items-center gap-2 font-mono text-xs select-none">
        <span class="text-[#090a0f] font-medium tracking-wider text-[13px] sm:text-sm">projects</span>
      </h2>
      <ul class="mt-4 space-y-3 sm:space-y-2.5">
        {projects.map((project) => (
          <li class="group relative flex flex-wrap sm:flex-nowrap items-baseline">
            <a
              href={project.href}
              target="_blank"
              rel="noopener noreferrer"
              title={project.summary}
              class="order-1 font-medium text-[13px] sm:text-sm text-[#090a0f] hover:text-[#87b2f4] sm:group-hover:text-[#87b2f4] transition-colors shrink-0 sm:after:absolute sm:after:inset-0 sm:after:content-['']"
            >{project.name}</a>
            <span class="order-3 sm:order-2 basis-full sm:basis-auto sm:flex-1 mt-0.5 sm:mt-0 sm:ml-2 min-w-0 font-mono text-[11px] sm:text-xs text-[#64748b] sm:truncate">
              <span class="sm:hidden">{project.mobileSummary ?? project.summary}</span>
              <span class="hidden sm:inline">{project.summary}</span>
            </span>
            <a
              href={project.href}
              target="_blank"
              rel="noopener noreferrer"
              tabindex="-1"
              aria-hidden="true"
              class="order-2 sm:order-3 ml-auto sm:ml-4 pl-4 sm:pl-0 inline-flex items-center gap-1 font-mono text-[11px] sm:text-xs text-[#64748b] hover:text-[#87b2f4] sm:group-hover:text-[#87b2f4] transition-colors shrink-0"
            >
              {project.label}
              <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M7 17 17 7M8 7h9v9" />
              </svg>
            </a>
          </li>
        ))}
      </ul>
    </section>
    </div>
  </div>
</BaseLayout>

<script>
  let copyTimeout: ReturnType<typeof setTimeout> | null = null;

  const initMeEmailCopy = () => {
    const emailBtns = document.querySelectorAll<HTMLAnchorElement>('.me-email-btn');
    emailBtns.forEach((btn) => {
      if (btn.dataset.copyInitialized === 'true') return;
      btn.dataset.copyInitialized = 'true';

      btn.addEventListener('click', async (e) => {
        // On phones, let the link open the mail app; copy to clipboard on desktop only
        if (!window.matchMedia('(min-width: 640px)').matches) return;
        e.preventDefault();
        const email = btn.dataset.email || 'chetan@trydecember.com';
        const container = btn.closest('.me-email-container');
        const tooltip = container?.querySelector<HTMLElement>('.me-email-tooltip');

        try {
          await navigator.clipboard.writeText(email);
        } catch {
          // Fallback if clipboard API is restricted
          try {
            const textarea = document.createElement('textarea');
            textarea.value = email;
            textarea.style.position = 'fixed';
            textarea.style.opacity = '0';
            document.body.appendChild(textarea);
            textarea.select();
            document.execCommand('copy');
            document.body.removeChild(textarea);
          } catch {
            // Intentionally swallowed: clipboard fallback attempt handled
          }
        }

        if (tooltip) {
          if (copyTimeout) {
            clearTimeout(copyTimeout);
          }
          tooltip.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-1');
          tooltip.classList.add('opacity-100', 'translate-y-0');

          copyTimeout = setTimeout(() => {
            tooltip.classList.remove('opacity-100', 'translate-y-0');
            tooltip.classList.add('opacity-0', 'pointer-events-none', 'translate-y-1');
          }, 2000);
        }
      });
    });
  };

  initMeEmailCopy();
  document.addEventListener('astro:page-load', initMeEmailCopy);
</script>
