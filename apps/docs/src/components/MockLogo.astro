---
// The December snowflake mark (same lines as Icons.DecemberLogo in apps/web), for the window mocks.

interface Props {
  class?: string;
  strokeWidth?: number;
}

const { class: className, strokeWidth = 1 } = Astro.props;

const lines = [
  [12, 12, 12, 5.3], [12, 7.5, 13.9, 6.4], [12, 7.5, 10.1, 6.4],
  [12, 12, 17.8, 8.65], [15.9, 9.75, 17.8, 10.85], [15.9, 9.75, 15.9, 7.55],
  [12, 12, 17.8, 15.35], [15.9, 14.25, 15.9, 16.45], [15.9, 14.25, 17.8, 13.15],
  [12, 12, 12, 18.7], [12, 16.5, 10.1, 17.6], [12, 16.5, 13.9, 17.6],
  [12, 12, 6.2, 15.35], [8.1, 14.25, 6.2, 13.15], [8.1, 14.25, 8.1, 16.45],
  [12, 12, 6.2, 8.65], [8.1, 9.75, 8.1, 7.55], [8.1, 9.75, 6.2, 10.85],
];
---

<svg class={className} viewBox="5 4 14 16" fill="none" stroke="currentColor" stroke-width={strokeWidth} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {lines.map(([x1, y1, x2, y2]) => <line x1={x1} y1={y1} x2={x2} y2={y2} />)}
</svg>
