---
// Section Divider
// One 1px line that runs the full width of the screen, with the December ✱
// mark where it crosses each side rail of the 1152px column. Place it as a
// direct child of a column container (the element that draws the rails with border-x).
// edge: when set, the divider overlays the top or bottom edge of its container
// and takes no space. When not set, it sits in the normal flow (1px tall).
// hideOnMobile: hide the divider below the lg breakpoint (phones and tablets).
// A small script moves each line by up to about 2px so it starts on a whole screen pixel.
// Without it, at 125% or 150% zoom some lines spread over an extra pixel row and look
// heavier than others (the line above the FAQ looked heavier than the others).

interface Props {
  edge?: 'top' | 'bottom';
  hideOnMobile?: boolean;
}

const { edge, hideOnMobile = false } = Astro.props;

const rootClass = edge === 'top'
  ? 'absolute inset-x-0 top-0'
  : edge === 'bottom'
    ? 'absolute inset-x-0 bottom-0'
    : 'relative w-full';

const visibilityClass = hideOnMobile ? 'hidden lg:block' : '';

// Marks sit on the rails, which are 1px outside this box. Show them only when the gutters are wide enough.
const markClass = 'hidden min-[1192px]:block absolute top-1/2 size-3.5 -translate-y-1/2 rounded-full bg-white p-px text-[#87b2f4]';
---

<div data-divider data-edge={edge} class={`${rootClass} ${visibilityClass} h-px pointer-events-none`} aria-hidden="true">
  <div class="absolute top-0 left-[calc(50%-50vw)] w-screen border-t border-[#cbd5e1]"></div>
  {[`${markClass} -left-[0.5px] -translate-x-1/2`, `${markClass} -right-[0.5px] translate-x-1/2`].map((cls) => (
    <svg class={cls} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="4.5" stroke-linecap="round">
      <line x1="12" y1="3" x2="12" y2="21" />
      <line x1="4.2" y1="7.5" x2="19.8" y2="16.5" />
      <line x1="4.2" y1="16.5" x2="19.8" y2="7.5" />
    </svg>
  ))}
</div>

<script>
  // Snap every divider to the screen pixel grid (see the note at the top of this file)
  const snapDividers = () => {
    const dividers = [...document.querySelectorAll<HTMLElement>('[data-divider]')];
    const dpr = window.devicePixelRatio || 1;
    // Clear old moves first, then read all positions, then write, so the page lays out once
    dividers.forEach((divider) => {
      divider.style.marginTop = '';
      divider.style.marginBottom = '';
    });
    const tops = dividers.map((divider) => {
      const rect = divider.getBoundingClientRect();
      return rect.height === 0 ? null : rect.top + window.scrollY; // null: hidden (phones and tablets)
    });
    // Content with a fractional height (the 16:10 cards, 15px text) puts lines at y values like
    // 4054.59. The browser does not round those the same way at every zoom, so at 125% or 150%
    // such a line spreads over an extra screen row. Move each divider to the nearest whole CSS
    // pixel that is also a whole screen pixel (at most about 2px). Use a margin, not a transform:
    // the browser rounds the box first and then applies a transform, so a fractional transform
    // blurs the line. A margin on an in-flow divider also moves everything below it, so add up
    // those moves before reading the next divider.
    let pushed = 0;
    const moves = tops.map((top, i) => {
      if (top === null) return 0;
      const y = top + pushed;
      const miss = (target: number) => Math.abs(target * dpr - Math.round(target * dpr));
      const base = Math.round(y);
      const target = [0, 1, -1, 2, -2]
        .map((step) => base + step)
        .reduce((best, target) => (miss(target) < miss(best) - 0.01 ? target : best), base);
      const move = Number((target - y).toFixed(4));
      if (!dividers[i].dataset.edge) pushed += move;
      return move;
    });
    dividers.forEach((divider, i) => {
      const move = moves[i];
      if (move !== 0) {
        if (divider.dataset.edge === 'bottom') divider.style.marginBottom = `${-move}px`;
        else divider.style.marginTop = `${move}px`;
      }
      // An edge divider shares the move with its container, so things that sit on the line
      // (the footer horse) can move with it
      if (divider.dataset.edge) divider.parentElement?.style.setProperty('--divider-shift', `${move}px`);
    });
  };

  let frame = 0;
  const scheduleSnap = () => {
    cancelAnimationFrame(frame);
    frame = requestAnimationFrame(snapDividers);
  };

  // Positions change when fonts load, the window resizes or zooms, or content opens (FAQ)
  new ResizeObserver(scheduleSnap).observe(document.documentElement);
  window.addEventListener('resize', scheduleSnap);
  document.fonts?.ready.then(scheduleSnap);
  document.addEventListener('astro:page-load', scheduleSnap);
</script>
