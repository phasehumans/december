---
// PageLoader.astro
// Full-screen pulsing logo loader matching the landing page theme (clean white background + December blue star logo)
// Prevents layout jitter, font flicker, and visual shifts during initial load
---

<div
  id="page-loader"
  class="fixed inset-0 z-[9999] flex flex-col items-center justify-center bg-white select-none transition-opacity duration-300 ease-out"
  aria-hidden="true"
>
  <div class="flex flex-col items-center justify-center gap-3">
    <div class="flex items-center justify-center animate-pulse">
      <svg
        class="w-10 h-10 sm:w-12 sm:h-12 text-[#87b2f4]"
        viewBox="5 4 14 16"
        fill="none"
        stroke="currentColor"
        stroke-width="1.2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <!-- arm up -->
        <line x1="12" y1="12" x2="12" y2="5.3"></line>
        <line x1="12" y1="7.5" x2="13.9" y2="6.4"></line>
        <line x1="12" y1="7.5" x2="10.1" y2="6.4"></line>
        <!-- arm upper-right -->
        <line x1="12" y1="12" x2="17.8" y2="8.65"></line>
        <line x1="15.9" y1="9.75" x2="17.8" y2="10.85"></line>
        <line x1="15.9" y1="9.75" x2="15.9" y2="7.55"></line>
        <!-- arm lower-right -->
        <line x1="12" y1="12" x2="17.8" y2="15.35"></line>
        <line x1="15.9" y1="14.25" x2="15.9" y2="16.45"></line>
        <line x1="15.9" y1="14.25" x2="17.8" y2="13.15"></line>
        <!-- arm down -->
        <line x1="12" y1="12" x2="12" y2="18.7"></line>
        <line x1="12" y1="16.5" x2="10.1" y2="17.6"></line>
        <line x1="12" y1="16.5" x2="13.9" y2="17.6"></line>
        <!-- arm lower-left -->
        <line x1="12" y1="12" x2="6.2" y2="15.35"></line>
        <line x1="8.1" y1="14.25" x2="6.2" y2="13.15"></line>
        <line x1="8.1" y1="14.25" x2="8.1" y2="16.45"></line>
        <!-- arm upper-left -->
        <line x1="12" y1="12" x2="6.2" y2="8.65"></line>
        <line x1="8.1" y1="9.75" x2="8.1" y2="7.55"></line>
        <line x1="8.1" y1="9.75" x2="6.2" y2="10.85"></line>
      </svg>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    const loader = document.getElementById('page-loader');
    if (!loader) return;

    let isDismissed = false;
    const dismiss = () => {
      if (isDismissed) return;
      isDismissed = true;
      loader.classList.add('opacity-0', 'pointer-events-none');
      loader.style.pointerEvents = 'none';
      requestAnimationFrame(() => {
        try {
          loader.remove();
        } catch {
          loader.style.display = 'none';
        }
      });
    };

    // Dismiss immediately once DOM is interactive or loaded - no artificial delay
    if (document.readyState === 'complete' || document.readyState === 'interactive') {
      dismiss();
    } else {
      window.addEventListener('DOMContentLoaded', dismiss, { once: true });
      window.addEventListener('load', dismiss, { once: true });
    }

    // Support Astro View Transitions
    document.addEventListener('astro:page-load', dismiss);

    // Safeguard: dismiss immediately within 100ms so screen is never blocked
    setTimeout(dismiss, 100);
  })();
</script>
