---
// Terminal Window Mock
// A December CLI session drawn in HTML, for the "everywhere you work" card on the landing page.
//
// The window is laid out at real size (13px mono text, 17px rows) with the rows and colors of the
// TUI (packages/tui: theme.ts, header-view, message-line-cache, input-bar-view): the header, the
// user prompt band, one ● row per step, the live diff under the latest edit, a └ result line,
// the reply, the "Worked for" line, and the prompt box.
// A 680 x 425 stage is then scaled down to the panel width, so the card shows only the top-left
// part of the window, like a cropped screenshot.
//
// Place it inside a panel that has the Tailwind `@container` class and a 16:10 shape.
// The scale is 100cqw / 680px: tan(atan2()) turns that length ratio into a plain number.

import { version } from '../lib/version';

// TUI theme colors (packages/tui/src/theme.ts)
const c = {
  brand: '#89B4F8',
  text: '#E4E4E7',
  muted: '#A1A1AA',
  dim: '#71717A',
  border: '#3F3F46',
  surface: '#262629',
  success: '#6EE7B7',
  error: '#F87171',
  diffAddBg: '#0F2419',
  diffDeleteBg: '#2C1214',
};

// Live diff of the latest edit (formatDiffRow: line number, sign, text on a tinted band)
const diff = [
  { type: 'add', no: 4, text: "import { rateLimit } from '../middleware/rate-limit'" },
  { type: 'delete', no: 18, text: "router.post('/login', login)" },
  { type: 'add', no: 18, text: "router.post('/login', rateLimit({ max: 5, windowMs: 60_000 }), login)" },
] as const;

const diffStyle = {
  context: { bg: 'transparent', sign: '  ', signColor: c.dim, color: c.muted },
  add: { bg: c.diffAddBg, sign: '+ ', signColor: c.success, color: c.text },
  delete: { bg: c.diffDeleteBg, sign: '- ', signColor: c.error, color: c.text },
};
---

<div class="absolute inset-0 overflow-hidden" role="img" aria-label="December running in a terminal">
  <div
    class="absolute left-0 top-0 w-[680px] h-[425px] origin-top-left select-none"
    style="transform: scale(tan(atan2(100cqw, 680px)))"
  >
    <div class="absolute left-[88px] top-[72px] w-[1000px] h-[420px] flex flex-col overflow-hidden rounded-[12px] border border-[#3a3a3a] bg-[#18181b] shadow-[0_20px_60px_rgba(15,23,42,0.25)]">
      <!-- Title bar -->
      <div class="relative flex items-center h-[34px] shrink-0 bg-[#111113] border-b border-[#27272a] px-[14px]">
        <span class="relative z-10 flex gap-[8px]">
          <span class="w-[12px] h-[12px] rounded-full bg-[#ff5f57]"></span>
          <span class="w-[12px] h-[12px] rounded-full bg-[#febc2e]"></span>
          <span class="w-[12px] h-[12px] rounded-full bg-[#28c840]"></span>
        </span>
        <span class="absolute inset-x-0 text-center font-sans text-[12.5px] text-[#a1a1aa]">december &middot; ~/code/december</span>
      </div>

      <!-- Screen: 13px text, 17px rows -->
      <div class="flex-1 min-h-0 px-[14px] pt-[10px] font-mono text-[13px] leading-[17px] [&>p]:whitespace-pre [&>p]:overflow-hidden" style={`color: ${c.muted}`}>
        <!-- header-view.ts -->
        <p><span style={`color: ${c.brand}`} class="font-bold">✱ </span><span style={`color: ${c.text}`} class="font-bold">December</span><span style={`color: ${c.dim}`}> {version}</span></p>
        <p style={`color: ${c.dim}`}>team@trydecember.com</p>
        <p style={`color: ${c.dim}`}>Claude Sonnet 5.5 · Claude Subscription</p>
        <p style={`color: ${c.dim}`}>~/code/december (main)</p>
        <p>&nbsp;</p>

        <!-- User prompt band -->
        <p class="-mx-[14px] px-[14px]" style={`background: ${c.surface}; color: ${c.text}`}><span style={`color: ${c.dim}`}>❭ </span>add rate limiting to the login route, 5 tries per minute for each IP</p>
        <p>&nbsp;</p>

        <!-- Steps -->
        <p><span style={`color: ${c.dim}`}>● </span><span style={`color: ${c.text}`}>Created</span> src/middleware/rate-limit.ts  <span style={`color: ${c.dim}`}>38 lines</span></p>
        <p><span style={`color: ${c.dim}`}>● </span><span style={`color: ${c.text}`}>Edited</span> src/auth/auth.routes.ts  <span style={`color: ${c.success}`}>+2</span> <span style={`color: ${c.error}`}>-1</span></p>
        {diff.map((row) => {
          const st = diffStyle[row.type];
          return (
            <p style={`background: ${st.bg}`}><span style={`color: ${c.dim}`}>{String(row.no).padStart(6)} </span><span style={`color: ${st.signColor}`}>{st.sign}</span><span style={`color: ${st.color}`}>{row.text}</span></p>
          );
        })}
        <p><span style={`color: ${c.dim}`}>● </span><span style={`color: ${c.text}`}>Ran</span> bun test test/auth  <span style={`color: ${c.dim}`}>2.4s</span></p>
        <p style={`color: ${c.dim}`}>  └ 42 pass, 0 fail</p>
        <p>&nbsp;</p>
        <p style={`color: ${c.text}`}>Added a rate limit of 5 login tries per minute for each IP. All 42 auth tests pass.</p>
        <p>&nbsp;</p>
        <p style={`color: ${c.dim}`}><span style={`color: ${c.brand}`}>✱</span> Worked for 1m 12s</p>
        <p>&nbsp;</p>

        <!-- Prompt box (input-bar-view.ts) -->
        <p style={`color: ${c.border}`}>{'─'.repeat(140)}</p>
        <p><span style={`color: ${c.text}`}>❭ </span><span class="inline-block w-[8px] h-[15px] align-[-3px]" style={`background: ${c.text}`}></span><span style={`color: ${c.dim}`}>Ask December to build features, fix bugs, or work on your code…</span></p>
        <p style={`color: ${c.border}`}>{'─'.repeat(140)}</p>
        <p style={`color: ${c.dim}`}>Claude Sonnet 5.5</p>
      </div>
    </div>
  </div>
</div>
