---
// Web Window Mock
// December Cloud in a browser, drawn in HTML, for the "everywhere you work" card on the landing page.
//
// The window is laid out at real size (a 1100 x 740 laptop browser) with the same sizes and colors as the
// web app (apps/web: Sidebar, HomeHeader, HomeHero, PromptInput, PromptFooter). A 680 x 425 stage
// is then scaled down to the panel width, so the card shows only the top-left part of the window,
// like a cropped screenshot. The prompt box sits in the middle of the page, so only part of it shows.
//
// Place it inside a panel that has the Tailwind `@container` class and a 16:10 shape.
// The scale is 100cqw / 680px: tan(atan2()) turns that length ratio into a plain number.

import MockLogo from './MockLogo.astro';

const recentSessions = [
  { title: 'Add rate limiting to login', meta: 'Running', running: true },
  { title: 'Fix the flaky checkout test', meta: '2h ago', pr: 214 },
  { title: 'Dark mode for settings', meta: 'Yesterday', pr: 209 },
  { title: 'Upgrade to React 19', meta: '3d ago' },
  { title: 'Add CSV export to reports', meta: '5d ago', pr: 197 },
];

const icon = 'fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"';
---

<div class="absolute inset-0 overflow-hidden" role="img" aria-label="December Cloud running in a web browser">
  <div
    class="absolute left-0 top-0 w-[680px] h-[425px] origin-top-left select-none font-sans leading-normal"
    style="transform: scale(tan(atan2(100cqw, 680px)))"
  >
    <div class="absolute left-[88px] top-[72px] w-[1100px] h-[740px] flex flex-col overflow-hidden rounded-[12px] border border-[#3a3a3a] bg-[#141414] shadow-[0_20px_60px_rgba(15,23,42,0.25)]">
      <!-- Tab strip -->
      <div class="flex items-end h-[40px] shrink-0 bg-[#0e0e0e] pl-[16px]">
        <span class="self-center flex gap-[8px]">
          <span class="w-[12px] h-[12px] rounded-full bg-[#ff5f57]"></span>
          <span class="w-[12px] h-[12px] rounded-full bg-[#febc2e]"></span>
          <span class="w-[12px] h-[12px] rounded-full bg-[#28c840]"></span>
        </span>
        <div class="ml-[22px] flex items-center gap-[8px] w-[230px] h-[32px] px-[12px] rounded-t-[9px] bg-[#232323] text-[12px] text-[#e5e5e5]">
          <MockLogo class="w-[15px] h-[15px] text-white" strokeWidth={1.3} />
          <span class="truncate">December</span>
          <span class="ml-auto text-[#8a8a8a] text-[14px]">&times;</span>
        </div>
        <span class="self-center ml-[12px] text-[16px] text-[#8a8a8a]">+</span>
      </div>

      <!-- Address bar -->
      <div class="flex items-center gap-[14px] h-[40px] shrink-0 bg-[#232323] px-[14px] text-[#9a9a9a] border-b border-black/40">
        <svg class="w-[16px] h-[16px]" viewBox="0 0 24 24" set:html={`<path d="M19 12H5M12 19l-7-7 7-7" ${icon} />`} />
        <svg class="w-[16px] h-[16px] opacity-40" viewBox="0 0 24 24" set:html={`<path d="M5 12h14M12 5l7 7-7 7" ${icon} />`} />
        <svg class="w-[16px] h-[16px]" viewBox="0 0 24 24" set:html={`<path d="M21 12a9 9 0 1 1-3-6.7L21 8M21 3v5h-5" ${icon} />`} />
        <div class="flex-1 flex items-center gap-[8px] h-[28px] rounded-full bg-[#171717] px-[14px] text-[13px] text-[#d4d4d4]">
          <svg class="w-[13px] h-[13px] text-[#9a9a9a]" viewBox="0 0 24 24" set:html={`<rect x="5" y="11" width="14" height="10" rx="2" ${icon} /><path d="M8 11V7a4 4 0 0 1 8 0v4" ${icon} />`} />
          app.trydecember.com
        </div>
      </div>

      <!-- App -->
      <div class="flex flex-1 min-h-0">
        <!-- Sidebar (Sidebar.tsx, open) -->
        <div class="w-[200px] shrink-0 flex flex-col bg-[#191919] border-r border-white/5">
          <div class="px-3 mb-2">
            <div class="flex items-center justify-between px-2 h-11 mb-2">
              <MockLogo class="w-6 h-6 text-[#D6D5D4]" />
              <svg class="w-4 h-4 text-[#919191]" viewBox="0 0 24 24" set:html={`<rect x="3" y="4" width="18" height="16" rx="2" ${icon} /><path d="M9 4v16" ${icon} />`} />
            </div>
            <div class="flex flex-col gap-[1px]">
              <div class="flex items-center gap-2.5 px-2.5 h-[30px] rounded-[9px] bg-[#1F1F1F]">
                <div class="w-[19px] h-[19px] rounded-full bg-[#333333] flex items-center justify-center shrink-0">
                  <svg class="w-2.5 h-2.5 text-[#E8E8E8]" viewBox="0 0 24 24" set:html={`<path d="M12 5v14M5 12h14" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" />`} />
                </div>
                <span class="font-medium text-[13.5px] tracking-tight text-[#D6D5D4]">New</span>
              </div>
              <div class="flex items-center gap-2.5 px-2.5 h-[30px] text-[#919191]">
                <svg class="w-[17px] h-[17px]" viewBox="0 0 24 24" set:html={`<circle cx="11" cy="11" r="7" ${icon} /><path d="m21 21-4.3-4.3" ${icon} />`} />
                <span class="font-medium text-[13.5px] tracking-tight">Search</span>
              </div>
              <div class="flex items-center gap-2.5 px-2.5 h-[30px] text-[#919191]">
                <span class="relative flex">
                  <svg class="w-[17px] h-[17px]" viewBox="0 0 24 24" set:html={`<path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" ${icon} />`} />
                  <span class="absolute -top-1 -right-1 w-2 h-2 rounded-full bg-emerald-400 border border-[#1E1E1E]"></span>
                </span>
                <span class="font-medium text-[13.5px] tracking-tight">Sessions</span>
              </div>
              <div class="flex items-center gap-2.5 px-2.5 h-[30px] text-[#919191]">
                <svg class="w-[17px] h-[17px]" viewBox="0 0 24 24" set:html={`<circle cx="12" cy="12" r="3" ${icon} /><path d="M12 2v3M12 19v3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M2 12h3M19 12h3M4.9 19.1 7 17M17 7l2.1-2.1" ${icon} />`} />
                <span class="font-medium text-[13.5px] tracking-tight">Settings</span>
              </div>
            </div>
          </div>

          <div class="flex-1 flex flex-col px-3 min-h-0">
            <div class="flex items-center justify-between px-2.5 h-7">
              <span class="font-semibold text-[11.5px] text-[#8F8E8D] tracking-tight">Recent</span>
              <svg class="w-3.5 h-3.5 text-[#919191]" viewBox="0 0 24 24" set:html={`<circle cx="5" cy="12" r="1" ${icon} /><circle cx="12" cy="12" r="1" ${icon} /><circle cx="19" cy="12" r="1" ${icon} />`} />
            </div>
            <div class="flex flex-col gap-[2px] mt-1">
              {recentSessions.map((session) => (
                <div class:list={['flex flex-col px-2.5 py-1.5 rounded-xl', session.running && 'bg-[#202020]']}>
                  <div class="flex items-center gap-1.5 min-w-0">
                    {session.running && <span class="w-1.5 h-1.5 rounded-full shrink-0 bg-emerald-400"></span>}
                    <span class="font-normal text-[12.5px] tracking-tight text-[#EDEDED] truncate leading-snug">{session.title}</span>
                  </div>
                  <div class="flex items-center gap-1.5 text-[11px] text-[#8F8E8D] tracking-tight mt-[2px]">
                    <span class:list={[session.running && 'text-emerald-400 font-medium']}>{session.meta}</span>
                    {session.pr && (
                      <>
                        <span class="text-[#555]">&bull;</span>
                        <span class="text-[#C084FC] font-mono text-[10.5px]">#{session.pr}</span>
                      </>
                    )}
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>

        <!-- Home (HomeHero.tsx) -->
        <div class="relative flex-1 min-w-0 flex flex-col">
          <!-- HomeHeader.tsx -->
          <div class="flex items-center justify-between h-11 px-6 shrink-0">
            <div class="flex items-center gap-1.5">
              <span class="flex items-center gap-1.5 h-7 px-2.5 rounded-full bg-[#1F1F1F] text-[12px] font-medium text-[#999999]">
                Credits: <span class="text-[#E8E8E8]">$5.00</span>
              </span>
              <span class="flex items-center gap-1 h-7 px-2.5 rounded-full bg-[#1F1F1F] text-[12px] font-medium text-[#999999]">
                Docs
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" set:html={`<path d="M7 17 17 7M7 7h10v10" ${icon} />`} />
              </span>
            </div>
            <span class="w-7 h-7 flex items-center justify-center"><svg class="w-5 h-5 text-[#999999]" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 0-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.2.5-2.3 1.3-3.1-.2-.4-.6-1.6 0-3.2 0 0 1-.3 3.4 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.6 1.6.2 2.8.1 3.2.8.8 1.3 1.9 1.3 3.2 0 4.6-2.8 5.6-5.5 5.9.5.4.9 1 .9 2.2v3.3c0 .3.1.7.8.6A12 12 0 0 0 12 .3" /></svg></span>
          </div>

          <div class="flex flex-col items-center pt-[160px] w-full max-w-4xl mx-auto px-4">
            <div class="relative w-full max-w-[638px]">
              <div class="absolute bottom-[calc(100%+10px)] left-0 flex items-center gap-2 ml-2">
                <MockLogo class="w-[26px] h-[26px] text-white" />
                <span class="text-[23px] font-normal tracking-[-0.025em] text-white leading-none">
                  December <span class="text-[#87B2F4]">Agent</span>
                </span>
              </div>

              <!-- PromptInput.tsx + PromptFooter.tsx -->
              <div class="rounded-[17px] bg-[#1F1F1F] border border-[#313131] flex flex-col">
                <div class="flex flex-wrap items-start pt-[12px] pl-5 pr-12 pb-1 min-h-[72px] text-[14.5px]">
                  <span class="flex items-center gap-1.5 text-[#E8E8E8] text-[12.5px] font-medium mr-1.5 mb-1 bg-[#2A2928] px-2 py-0.5 rounded-[6px]">
                    <svg class="w-3.5 h-3.5 text-white" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 0-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.2.5-2.3 1.3-3.1-.2-.4-.6-1.6 0-3.2 0 0 1-.3 3.4 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.6 1.6.2 2.8.1 3.2.8.8 1.3 1.9 1.3 3.2 0 4.6-2.8 5.6-5.5 5.9.5.4.9 1 .9 2.2v3.3c0 .3.1.7.8.6A12 12 0 0 0 12 .3" /></svg>
                    acme/storefront
                  </span>
                  <span class="flex items-center gap-1.5 bg-[#2A2928] text-[#EDEDEF] text-[12px] font-medium mr-1.5 mb-1 px-2 py-0.5 rounded-[6px]">
                    <svg class="w-3.5 h-3.5 text-[#8F8E8D]" viewBox="0 0 24 24" set:html={`<circle cx="6" cy="6" r="2" ${icon} /><circle cx="6" cy="18" r="2" ${icon} /><circle cx="18" cy="8" r="2" ${icon} /><path d="M6 8v8M18 10a6 6 0 0 1-6 6H8" ${icon} />`} />
                    main
                  </span>
                  <p class="basis-full mt-1 font-medium leading-relaxed text-[#D6D5D4]">
                    Add rate limiting to the login route. Allow 5 tries per minute for each IP<span class="inline-block w-px h-[18px] ml-px align-[-4px] bg-white"></span>
                  </p>
                </div>
                <div class="flex items-center justify-between px-3 pb-3 pt-2">
                  <div class="flex items-center gap-1.5">
                    <span class="flex items-center justify-center w-8 h-8 rounded-full text-[#8E8E8E]">
                      <svg class="w-[18px] h-[18px]" viewBox="0 0 24 24" set:html={`<path d="M12 5v14M5 12h14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" />`} />
                    </span>
                    <span class="flex items-center gap-1.5 ml-1 px-2.5 py-1 rounded-full text-[12px] font-medium text-[#8E8E8E] border border-white/5">
                      <svg class="w-3 h-3 text-[#E08734]" viewBox="0 0 24 24" set:html={`<path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9z" fill="currentColor" />`} />
                      Claude Sonnet 5.5
                      <svg class="w-3 h-3 opacity-60" viewBox="0 0 24 24" set:html={`<path d="m6 9 6 6 6-6" ${icon} />`} />
                    </span>
                  </div>
                  <div class="flex items-center gap-1.5">
                    <span class="flex items-center justify-center w-8 h-8 rounded-full text-[#8E8E8E]">
                      <svg class="w-[14px] h-[14px]" viewBox="0 0 24 24" set:html={`<rect x="9" y="3" width="6" height="11" rx="3" fill="none" stroke="currentColor" stroke-width="2.5" /><path d="M5 11a7 7 0 0 0 14 0M12 18v3" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" />`} />
                    </span>
                    <span class="flex items-center justify-center w-8 h-8 rounded-full bg-[#EDEDED] text-[#090a0f]">
                      <svg class="w-4 h-4" viewBox="0 0 24 24" set:html={`<path d="M5 12h14M12 5l7 7-7 7" ${icon} />`} />
                    </span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
