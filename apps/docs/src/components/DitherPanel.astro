---
// Dither Panel
// A still background of light blue dither clouds for an illustration panel, in the same
// style as the hero clouds (ordered Bayer dither, warped noise). An oval in the middle stays
// clear for the illustration, and the clouds sit around the edges and in the corners. Each
// panel takes a seed, so panels next to each other get different clouds.
//
// Set clear={false} when the panel content covers the middle (like a window screenshot):
// then the clouds fill the whole panel, with no clear oval.
//
// Place it as the first child of a positioned panel (relative, overflow-hidden). Give the
// panel content `relative` so it paints above the canvas. The canvas is drawn once, and
// again when the panel changes size. Pass `class` to add classes to the canvas, for example
// `hidden sm:block` to show it only from the sm breakpoint up.

interface Props {
  seed?: number;
  clear?: boolean;
  class?: string;
}

const { seed = 1, clear = true, class: className } = Astro.props;
---

<canvas
  data-dither-panel
  data-seed={seed}
  data-clear={clear ? 'oval' : 'none'}
  aria-hidden="true"
  class:list={['pointer-events-none absolute inset-0 h-full w-full', className]}
></canvas>

<style>
  canvas[data-dither-panel] {
    image-rendering: pixelated;
    image-rendering: crisp-edges;
  }
</style>

<script>
  // Panel look. Phones use a denser profile: finer dots, more fill, and a smaller clear oval,
  // because the panels there are small and the desktop clouds look sparse and coarse.
  interface Profile {
    pixel: number; // CSS px per dither pixel
    ovalX: number; // clear oval half width, as a share of the panel width
    ovalY: number; // clear oval half height, as a share of the panel height
    riseFrom: number; // clouds start at this elliptical distance from the centre
    riseTo: number; // clouds are at full strength from this distance
    peak: number; // max share of lit pixels
    haze: number; // thin dither between the clouds
    scale: number; // noise size multiplier (smaller = tighter clouds)
  }

  const DESKTOP: Profile = { pixel: 3, ovalX: 0.3, ovalY: 0.46, riseFrom: 0.9, riseTo: 1.7, peak: 0.55, haze: 0.1, scale: 1 };
  const MOBILE: Profile = { pixel: 2, ovalX: 0.26, ovalY: 0.42, riseFrom: 0.75, riseTo: 1.35, peak: 0.72, haze: 0.24, scale: 0.6 };
  const mobileQuery = window.matchMedia('(max-width: 639px)'); // below Tailwind sm

  const ACCENT_FROM = 0.4; // above this strength, some lit pixels take the dark accent tone

  const TONE: [number, number, number] = [135, 178, 244]; // #87b2f4
  const ACCENT: [number, number, number] = [0, 102, 245]; // #0066f5

  // 4x4 Bayer matrix, as thresholds in (0, 1)
  const BAYER = [0, 8, 2, 10, 12, 4, 14, 6, 3, 11, 1, 9, 15, 7, 13, 5].map((b) => (b + 0.5) / 16);

  const smooth = (a: number, b: number, x: number) => {
    const u = Math.max(0, Math.min(1, (x - a) / (b - a)));
    return u * u * (3 - 2 * u);
  };

  // Value noise on a lattice shuffled from a seed, so each panel gets its own clouds
  const makeNoise = (seed: number) => {
    let state = seed >>> 0 || 1;
    const random = () => {
      // mulberry32
      state = (state + 0x6d2b79f5) >>> 0;
      let t = state;
      t = Math.imul(t ^ (t >>> 15), t | 1);
      t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
    const perm = new Uint8Array(512);
    const p = Array.from({ length: 256 }, (_, i) => i);
    for (let i = 255; i > 0; i--) {
      const j = Math.floor(random() * (i + 1));
      [p[i], p[j]] = [p[j], p[i]];
    }
    for (let i = 0; i < 512; i++) perm[i] = p[i & 255];
    const lattice = (x: number, y: number) => perm[perm[x & 255] + (y & 255)] / 255;
    return (x: number, y: number) => {
      const xi = Math.floor(x);
      const yi = Math.floor(y);
      const xf = x - xi;
      const yf = y - yi;
      const u = xf * xf * (3 - 2 * xf);
      const v = yf * yf * (3 - 2 * yf);
      const a = lattice(xi, yi);
      const b = lattice(xi + 1, yi);
      const c = lattice(xi, yi + 1);
      const d = lattice(xi + 1, yi + 1);
      return a + (b - a) * u + (c - a) * v + (a - b - c + d) * u * v;
    };
  };

  const drawPanel = (canvas: HTMLCanvasElement) => {
    const ctx = canvas.getContext('2d');
    const rect = canvas.getBoundingClientRect();
    if (!ctx || rect.width === 0 || rect.height === 0) return;

    const { pixel, ovalX, ovalY, riseFrom, riseTo, peak, haze, scale } = mobileQuery.matches ? MOBILE : DESKTOP;
    const cols = Math.ceil(rect.width / pixel);
    const rows = Math.ceil(rect.height / pixel);
    canvas.width = cols;
    canvas.height = rows;
    const image = ctx.createImageData(cols, rows);
    const data = image.data;

    const noise = makeNoise(Number(canvas.dataset.seed) || 1);
    const cx = rect.width / 2;
    const cy = rect.height / 2;
    const rx = rect.width * ovalX;
    const ry = rect.height * ovalY;
    const clearOval = canvas.dataset.clear !== 'none';

    for (let row = 0; row < rows; row++) {
      const y = row * pixel + pixel / 2;
      const ey = (y - cy) / ry;
      for (let col = 0; col < cols; col++) {
        const x = col * pixel + pixel / 2;
        const ex = (x - cx) / rx;
        // Warped noise, as in the hero, so the clouds curl
        const warp = noise(x / (120 * scale), y / (120 * scale));
        const wx = x + (warp - 0.5) * 90 * scale;
        const wy = y + (warp - 0.5) * 70 * scale;
        const n = 0.65 * noise(wx / (70 * scale), wy / (70 * scale)) + 0.35 * noise(wx / (28 * scale) + 50, wy / (28 * scale) + 50);
        const cloud = smooth(0.42, 0.7, n);
        // The oval edge moves in and out with the noise, so it never looks drawn
        const e = Math.sqrt(ex * ex + ey * ey) - (warp - 0.5) * 0.3;
        const shape = clearOval ? smooth(riseFrom, riseTo, e) : 1;
        if (shape <= 0) continue;
        const v = Math.min(peak, shape * (haze + (1 - haze) * cloud));
        const th = BAYER[(row & 3) * 4 + (col & 3)];
        if (v <= th) continue;
        const tone = th < v - ACCENT_FROM ? ACCENT : TONE;
        const o = (row * cols + col) * 4;
        data[o] = tone[0];
        data[o + 1] = tone[1];
        data[o + 2] = tone[2];
        data[o + 3] = 255;
      }
    }
    ctx.putImageData(image, 0, 0);
  };

  let observer: ResizeObserver | null = null;

  const initPanels = () => {
    observer?.disconnect();
    const canvases = Array.from(document.querySelectorAll<HTMLCanvasElement>('canvas[data-dither-panel]'));
    if (canvases.length === 0) return;
    // Draws each panel now, and again when its size changes
    observer = new ResizeObserver((entries) => {
      entries.forEach((entry) => drawPanel(entry.target as HTMLCanvasElement));
    });
    canvases.forEach((canvas) => observer?.observe(canvas));
  };

  document.addEventListener('astro:page-load', initPanels);
  document.addEventListener('astro:before-swap', () => {
    observer?.disconnect();
    observer = null;
  });
</script>
