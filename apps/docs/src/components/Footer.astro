---
// Footer Component
// Minimalist structure with tagline, CONNECT social links, and legal/status bar
---

<footer class="w-full border-t border-[#e2e8f0] bg-white text-[#52525b] mt-auto font-sans">
  <div class="mx-auto max-w-[940px] px-6 sm:px-8 md:px-10 lg:px-12 pt-12 sm:pt-16 pb-12">
    <!-- Main Content: Left Tagline + Right CONNECT -->
    <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-10">
      <!-- Left Column: Brand & Tagline -->
      <div class="max-w-sm">
        <a href="/" class="inline-flex items-center gap-2 group">
          <span class="text-[#87b2f4] text-xl font-bold select-none leading-none">✱</span>
          <span class="text-xl font-semibold tracking-tight text-[#090a0f]">december</span>
        </a>
        <p class="mt-3.5 text-sm sm:text-base text-[#52525b] leading-relaxed">
          A coding agent for terminal and cloud.
        </p>
      </div>

      <!-- Right Column: CONNECT -->
      <div class="sm:min-w-[140px]">
        <h3 class="font-mono text-xs uppercase tracking-wider text-[#090a0f] font-semibold mb-4">
          CONNECT
        </h3>
        <ul class="space-y-3 text-sm">
          <!-- X -->
          <li>
            <a
              href="https://x.com/trydecember"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2.5 hover:text-[#090a0f] transition-colors group"
            >
              <svg class="w-4 h-4 text-[#52525b] group-hover:text-[#090a0f] transition-colors" viewBox="0 0 24 24" fill="currentColor">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
              </svg>
              <span>X</span>
            </a>
          </li>

          <!-- GitHub -->
          <li>
            <a
              href="https://github.com/phasehumans/december"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2.5 hover:text-[#090a0f] transition-colors group"
            >
              <svg class="w-4 h-4 text-[#52525b] group-hover:text-[#090a0f] transition-colors" viewBox="0 0 24 24" fill="currentColor">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
              </svg>
              <span>GitHub</span>
            </a>
          </li>

          <!-- LinkedIn -->
          <li>
            <a
              href="https://linkedin.com/company/trydecember"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2.5 hover:text-[#090a0f] transition-colors group"
            >
              <svg class="w-4 h-4 text-[#52525b] group-hover:text-[#090a0f] transition-colors" viewBox="0 0 24 24" fill="currentColor">
                <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/>
              </svg>
              <span>LinkedIn</span>
            </a>
          </li>

          <!-- YouTube -->
          <li>
            <a
              href="https://youtube.com/@trydecember"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2.5 hover:text-[#090a0f] transition-colors group"
            >
              <svg class="w-4 h-4 text-[#52525b] group-hover:text-[#090a0f] transition-colors" viewBox="0 0 24 24" fill="currentColor">
                <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
              </svg>
              <span>YouTube</span>
            </a>
          </li>

          <!-- npm -->
          <li>
            <a
              href="https://www.npmjs.com/package/@trydecember/cli"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2.5 hover:text-[#090a0f] transition-colors group"
            >
              <svg class="w-4 h-4 text-[#52525b] group-hover:text-[#090a0f] transition-colors" viewBox="0 0 24 24" fill="currentColor">
                <path d="M1.763 0C.786 0 0 .786 0 1.763v20.474C0 23.214.786 24 1.763 24h20.474c.977 0 1.763-.786 1.763-1.763V1.763C24 .786 23.214 0 22.237 0zM5.13 5.323l13.837.019-.009 13.836h-3.464l.01-10.382h-3.456L12.04 19.17H5.113z"/>
              </svg>
              <span>npm</span>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar: Copyright, Legal (Privacy & Terms), Status, Back to top -->
    <div class="mt-12 sm:mt-16 pt-6 border-t border-[#e2e8f0] flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 text-xs sm:text-sm">
      <!-- Left: Copyright & Legal -->
      <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
        <span>© {new Date().getFullYear()} december</span>
        <a href="/privacy" class="hover:text-[#090a0f] transition-colors">Privacy</a>
        <a href="/terms" class="hover:text-[#090a0f] transition-colors">Terms</a>
      </div>

      <!-- Right: Status Indicator & Back to top -->
      <div class="flex items-center gap-6">
        <a
          href="https://status.trydecember.com"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 hover:text-[#090a0f] transition-colors"
        >
          <span class="w-2 h-2 rounded-full bg-[#10b981]"></span>
          <span>Status</span>
        </a>
        <button
          type="button"
          id="back-to-top-btn"
          class="hover:text-[#090a0f] transition-colors cursor-pointer"
        >
          Back to top ↑
        </button>
      </div>
    </div>
  </div>
</footer>

<script>
  const backToTopBtn = document.getElementById('back-to-top-btn');
  if (backToTopBtn) {
    backToTopBtn.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }
</script>
