---
const webUrl = import.meta.env.PUBLIC_WEB_URL || (import.meta.env.DEV ? 'http://localhost:3000' : 'https://app.trydecember.com');
---

<footer class="border-t border-[#202020] bg-[#0a0a0a] text-[#888888]">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 gap-8 md:grid-cols-4">
      <div>
        <h3 class="text-[12px] font-mono uppercase tracking-wider text-[#dddddd]">Product</h3>
        <ul class="mt-4 space-y-2 text-[13px]">
          <li><a href="/#cli" class="hover:text-white transition-colors">Terminal CLI</a></li>
          <li><a href={webUrl} class="hover:text-white transition-colors">Cloud Workspace</a></li>
          <li><a href="/#architecture" class="hover:text-white transition-colors">Cloud Handoff</a></li>
          <li><a href="/#pricing" class="hover:text-white transition-colors">Pricing & BYOK</a></li>
        </ul>
      </div>

      <div>
        <h3 class="text-[12px] font-mono uppercase tracking-wider text-[#dddddd]">Documentation</h3>
        <ul class="mt-4 space-y-2 text-[13px]">
          <li><a href="/docs" class="hover:text-white transition-colors">Overview</a></li>
          <li><a href="/docs/quickstart" class="hover:text-white transition-colors">Quickstart</a></li>
          <li><a href="/docs/cli" class="hover:text-white transition-colors">CLI Reference</a></li>
          <li><a href="/docs/slash-commands" class="hover:text-white transition-colors">Slash Commands</a></li>
          <li><a href="/docs/security" class="hover:text-white transition-colors">Security & Isolation</a></li>
        </ul>
      </div>

      <div>
        <h3 class="text-[12px] font-mono uppercase tracking-wider text-[#dddddd]">Community</h3>
        <ul class="mt-4 space-y-2 text-[13px]">
          <li><a href="https://github.com/phasehumans/december" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">GitHub</a></li>
          <li><a href="https://github.com/phasehumans/december/issues" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">Issue Tracker</a></li>
          <li><a href="mailto:team@trydecember.com" class="hover:text-white transition-colors">team@trydecember.com</a></li>
        </ul>
      </div>

      <div>
        <h3 class="text-[12px] font-mono uppercase tracking-wider text-[#dddddd]">Legal</h3>
        <ul class="mt-4 space-y-2 text-[13px]">
          <li><a href="/privacy" class="hover:text-white transition-colors">Privacy Policy</a></li>
          <li><a href="/terms" class="hover:text-white transition-colors">Terms of Service</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-12 flex flex-col sm:flex-row items-center justify-between border-t border-[#1c1c1c] pt-6 text-[12px]">
      <div class="flex items-center gap-2">
        <img src="/logo.svg" alt="December Logo" width="16" height="16" class="opacity-60" />
        <span class="font-mono text-[#666666]">© {new Date().getFullYear()} phasehumans. All rights reserved.</span>
      </div>
      <p class="mt-4 sm:mt-0 font-mono text-[#555555]">autonomous coding agent in your terminal</p>
    </div>
  </div>
</footer>
