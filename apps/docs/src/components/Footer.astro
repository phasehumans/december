---
// Footer Component
// Ultra-minimal developer-focused footer matching the page content width and design language
---

<footer class="w-full bg-white text-[#64748b] mt-auto">
  <!-- Constrained container matching landing page content width -->
  <div class="mx-auto max-w-[940px] px-6 sm:px-8 md:px-10 lg:px-12">
    <div class="pt-5 sm:pt-6 pb-8 sm:pb-10">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 font-mono text-xs sm:text-[13px]">
        <!-- Left: Creator & Legal -->
        <div class="flex flex-wrap items-center gap-x-4 sm:gap-x-5 gap-y-2">
          <span class="text-[#64748b]">
            built by <a href="/me" target="_blank" rel="noopener noreferrer" class="text-[#090a0f] hover:text-[#87b2f4] transition-colors font-medium">@chaitanya</a>
          </span>
          <span class="text-[#cbd5e1] hidden sm:inline">/</span>
          <a href="/privacy" class="hover:text-[#090a0f] transition-colors">privacy</a>
          <a href="/terms" class="hover:text-[#090a0f] transition-colors">terms</a>
          <a href="/docs/changelog" class="hover:text-[#090a0f] transition-colors">changelog</a>
        </div>

        <!-- Right: Social & Back to Top -->
        <div class="flex flex-wrap items-center gap-x-4 sm:gap-x-5 gap-y-2">
          <a
            href="https://x.com/phasehumans"
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-[#090a0f] transition-colors"
          >
            x
          </a>
          <a
            href="https://www.npmjs.com/package/@trydecember/cli"
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-[#090a0f] transition-colors"
          >
            npm
          </a>
          <a
            href="https://github.com/phasehumans/december"
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-[#090a0f] transition-colors"
          >
            github
          </a>
        </div>
      </div>
    </div>
  </div>
</footer>
