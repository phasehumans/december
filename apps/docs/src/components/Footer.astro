---
// Footer Component
// Ultra-minimal developer-focused footer matching the page content width and design language
---

<footer class="w-full bg-white text-[#64748b] mt-auto">
  <!-- Constrained container matching landing page content width -->
  <div class="mx-auto max-w-[940px] px-6 sm:px-8 md:px-10 lg:px-12">
    <div class="pt-5 sm:pt-6 pb-8 sm:pb-10">
      <div class="flex items-center justify-between gap-4 font-mono text-xs sm:text-[13px]">
        <!-- Left: Creator & Legal (on mobile: privacy & terms; on sm+: full creator, legal, changelog) -->
        <div class="flex items-center gap-x-4 sm:gap-x-5">
          <span class="text-[#64748b] hidden sm:inline">
            built by <a href="/me" target="_blank" rel="noopener noreferrer" class="text-[#090a0f] hover:text-[#87b2f4] transition-colors font-medium">@chaitanya</a>
          </span>
          <span class="text-[#cbd5e1] hidden sm:inline">/</span>
          <a href="/privacy" class="hover:text-[#090a0f] transition-colors">privacy</a>
          <a href="/terms" class="hover:text-[#090a0f] transition-colors">terms</a>
          <a href="/docs/changelog" class="hover:text-[#090a0f] transition-colors">changelog</a>
        </div>

        <!-- Right: Social & Contact Icons (GitHub & Email) -->
        <div class="flex items-center gap-2.5 sm:gap-3">
          <!-- GitHub -->
          <a
            href="https://github.com/phasehumans"
            target="_blank"
            rel="noopener noreferrer"
            class="group text-[#475569] hover:text-[#090a0f] opacity-75 hover:opacity-100 hover:scale-105 transition-all duration-150 p-0.5"
            aria-label="GitHub"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2A10 10 0 0 0 2 12c0 4.42 2.87 8.17 6.84 9.5.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34-.46-1.16-1.1-1.47-1.1-1.47-.9-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.87 1.52 2.34 1.07 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.92 0-1.11.38-2 1.03-2.71-.1-.25-.45-1.29.1-2.64 0 0 .84-.27 2.75 1.02a9.56 9.56 0 0 1 2.5-.34c.85.04 1.7.15 2.5.34 1.91-1.29 2.75-1.02 2.75-1.02.55 1.35.2 2.39.1 2.64.65.71 1.03 1.6 1.03 2.71 0 3.82-2.34 4.66-4.57 4.91.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0 0 12 2z"></path>
            </svg>
          </a>

          <!-- Email -->
          <!--email_off-->
          <div class="relative flex items-center footer-email-container">
            <a
              href="mailto:team@trydecember.com"
              data-email="team@trydecember.com"
              class="footer-email-btn group text-[#475569] hover:text-[#090a0f] opacity-75 hover:opacity-100 hover:scale-105 transition-all duration-150 p-0.5 cursor-pointer"
              aria-label="Email"
              title="Click to copy team@trydecember.com"
            >
              <svg class="w-4 h-4 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
              </svg>
            </a>

            <!-- Tooltip: email copied -->
            <div
              class="footer-email-tooltip pointer-events-none absolute bottom-full right-0 mb-2 flex items-center gap-1.5 whitespace-nowrap border border-[#1e293b] bg-[#090a0f] px-2 py-0.5 font-mono text-[11px] text-[#f8fafc] shadow-md rounded-[3px] opacity-0 translate-y-1 transition-all duration-150 z-50 select-none"
              role="status"
              aria-live="polite"
            >
              <svg class="w-3 h-3 text-[#87b2f4] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span>email copied</span>
              <span class="absolute top-full right-2 -mt-[1px] border-4 border-transparent border-t-[#090a0f]"></span>
            </div>
          </div>
          <!--/email_off-->
        </div>


      </div>
    </div>
  </div>
</footer>

<script>
  let copyTimeout: ReturnType<typeof setTimeout> | null = null;

  const initFooterEmailCopy = () => {
    const emailBtns = document.querySelectorAll<HTMLAnchorElement>('.footer-email-btn');
    emailBtns.forEach((btn) => {
      if (btn.dataset.copyInitialized === 'true') return;
      btn.dataset.copyInitialized = 'true';

      btn.addEventListener('click', async (e) => {
        e.preventDefault();
        const email = btn.dataset.email || 'team@trydecember.com';
        const container = btn.closest('.footer-email-container');
        const tooltip = container?.querySelector<HTMLElement>('.footer-email-tooltip');

        try {
          await navigator.clipboard.writeText(email);
        } catch {
          // Fallback if clipboard API is restricted
          try {
            const textarea = document.createElement('textarea');
            textarea.value = email;
            textarea.style.position = 'fixed';
            textarea.style.opacity = '0';
            document.body.appendChild(textarea);
            textarea.select();
            document.execCommand('copy');
            document.body.removeChild(textarea);
          } catch {
            // Intentionally swallowed: clipboard fallback attempt handled
          }
        }

        if (tooltip) {
          if (copyTimeout) {
            clearTimeout(copyTimeout);
          }
          tooltip.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-1');
          tooltip.classList.add('opacity-100', 'translate-y-0');

          copyTimeout = setTimeout(() => {
            tooltip.classList.remove('opacity-100', 'translate-y-0');
            tooltip.classList.add('opacity-0', 'pointer-events-none', 'translate-y-1');
          }, 2000);
        }
      });
    });
  };

  initFooterEmailCopy();
  document.addEventListener('astro:page-load', initFooterEmailCopy);
</script>
