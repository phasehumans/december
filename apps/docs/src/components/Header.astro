---
import { version } from '../lib/version';

interface Props {
  activePath?: string;
}

const { activePath = '/' } = Astro.props;
const appUrl = import.meta.env.APP_URL || (import.meta.env.DEV ? 'http://localhost:3000' : 'https://app.trydecember.com');
---

<header class="relative top-auto z-10 w-full bg-white sm:bg-transparent transition-colors">
  <div class="relative z-10 mx-auto flex h-14 sm:h-16 max-w-[1200px] items-center justify-between px-6 sm:px-8 md:px-10 lg:px-12 border-x border-transparent lg:border-[#e2e8f0] bg-transparent sm:bg-white">
    <!-- Brand (Left): December [version] -->
    <a href="/" class="flex items-center gap-1.5 sm:gap-2 py-1 transition-opacity hover:opacity-85 font-mono text-xs sm:text-sm shrink-0 whitespace-nowrap">
      <span class="font-medium text-[#090a0f]">December</span>
      <span class="text-[#64748b]">{version}</span>
    </a>

    <!-- Nav Items & CTA (Right): docs and blog on all sizes, Sign in / Open app on sm+ -->
    <div class="flex items-center gap-2 sm:gap-5 font-mono text-xs sm:text-sm shrink-0">
      <nav class="flex items-center gap-3.5 sm:gap-4 font-mono text-xs sm:text-sm" aria-label="Main navigation">
        <a 
          href="/docs" 
          class={`transition-colors py-1 ${
            activePath.startsWith('/docs') ? 'text-[#87b2f4]' : 'text-[#475569] hover:text-[#87b2f4]'
          }`}
        >
          docs
        </a>

        <a 
          href="/blog" 
          class={`transition-colors py-1 ${
            activePath.startsWith('/blog') ? 'text-[#87b2f4]' : 'text-[#475569] hover:text-[#87b2f4]'
          }`}
        >
          blog
        </a>
      </nav>

      <!-- Sign In CTA Button (Hidden on mobile, visible on sm+); becomes "Open app" for signed-in users -->
      <a
        id="header-auth-cta"
        href={`${appUrl}/login`}
        data-app-url={appUrl}
        class="hidden sm:inline-flex items-center bg-[#090a0f] text-white hover:bg-[#27272a] text-xs font-mono font-medium px-2.5 sm:px-3 py-1 h-7 rounded-[3px] transition-colors active:scale-[0.98] whitespace-nowrap shrink-0"
      >
        <span class="whitespace-nowrap">Sign in</span>
      </a>
      <!-- Runs inline right after the CTA so signed-in users never see a "Sign in" flash -->
      <script is:inline>
        (function () {
          var cta = document.getElementById('header-auth-cta');
          if (!cta) return;
          var isLoggedIn = document.cookie.split(';').some(function (c) {
            return c.trim().startsWith('december_logged_in=1');
          });
          if (!isLoggedIn) return;
          cta.setAttribute('href', cta.getAttribute('data-app-url') || '/');
          var label = cta.querySelector('span');
          if (label) label.textContent = 'Open app';
        })();
      </script>
    </div>
  </div>
</header>
