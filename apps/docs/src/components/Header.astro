---
import { version } from '../lib/version';

interface Props {
  activePath?: string;
}

const { activePath = '/' } = Astro.props;
const appUrl = import.meta.env.APP_URL || (import.meta.env.DEV ? 'http://localhost:3000' : 'https://app.trydecember.com');
---

<header class="relative z-10 w-full overflow-hidden">
  <!-- Left Side Gutter: Cross Blue Hatching Pattern (visible on lg+ screens) -->
  <div
    class="hidden lg:block absolute top-0 bottom-0 left-0 right-[calc(50%+560px)] side-gutter-hatch side-gutter-mask-left pointer-events-none z-0 border-r border-[#e2e8f0]"
    aria-hidden="true"
  />

  <!-- Right Side Gutter: Cross Blue Hatching Pattern (visible on lg+ screens) -->
  <div
    class="hidden lg:block absolute top-0 bottom-0 left-[calc(50%+560px)] right-0 side-gutter-hatch side-gutter-mask-right pointer-events-none z-0 border-l border-[#e2e8f0]"
    aria-hidden="true"
  />

  <div class="relative z-10 mx-auto flex h-14 sm:h-16 max-w-[1120px] items-center justify-between px-6 sm:px-8 md:px-10 lg:px-12 border-x border-transparent lg:border-[#e2e8f0] bg-white">
    <!-- Brand (Left): December [version] -->
    <a href="/" class="flex items-center gap-2 py-1 transition-opacity hover:opacity-85 font-mono text-xs sm:text-sm">
      <svg
        class="w-4 h-4 text-[#090a0f] shrink-0"
        viewBox="5 4 14 16"
        fill="none"
        stroke="currentColor"
        stroke-width="1.2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <!-- arm up -->
        <line x1="12" y1="12" x2="12" y2="5.3" />
        <line x1="12" y1="7.5" x2="13.9" y2="6.4" />
        <line x1="12" y1="7.5" x2="10.1" y2="6.4" />
        <!-- arm upper-right -->
        <line x1="12" y1="12" x2="17.8" y2="8.65" />
        <line x1="15.9" y1="9.75" x2="17.8" y2="10.85" />
        <line x1="15.9" y1="9.75" x2="15.9" y2="7.55" />
        <!-- arm lower-right -->
        <line x1="12" y1="12" x2="17.8" y2="15.35" />
        <line x1="15.9" y1="14.25" x2="15.9" y2="16.45" />
        <line x1="15.9" y1="14.25" x2="17.8" y2="13.15" />
        <!-- arm down -->
        <line x1="12" y1="12" x2="12" y2="18.7" />
        <line x1="12" y1="16.5" x2="10.1" y2="17.6" />
        <line x1="12" y1="16.5" x2="13.9" y2="17.6" />
        <!-- arm lower-left -->
        <line x1="12" y1="12" x2="6.2" y2="15.35" />
        <line x1="8.1" y1="14.25" x2="6.2" y2="13.15" />
        <line x1="8.1" y1="14.25" x2="8.1" y2="16.45" />
        <!-- arm upper-left -->
        <line x1="12" y1="12" x2="6.2" y2="8.65" />
        <line x1="8.1" y1="9.75" x2="8.1" y2="7.55" />
        <line x1="8.1" y1="9.75" x2="6.2" y2="10.85" />
      </svg>
      <span class="font-medium text-[#090a0f]">December</span>
      <span class="text-[#64748b]">{version}</span>
    </a>

    <!-- Nav Items & CTA (Right): docs, blog, and Sign in -->
    <div class="flex items-center gap-3 sm:gap-5 font-mono text-xs sm:text-sm">
      <nav class="flex items-center gap-3 sm:gap-4 font-mono text-xs sm:text-sm" aria-label="Main navigation">
        <a 
          href="/docs" 
          class={`transition-colors py-1 ${
            activePath.startsWith('/docs') ? 'text-[#87b2f4]' : 'text-[#475569] hover:text-[#87b2f4]'
          }`}
        >
          docs
        </a>

        <a 
          href="/blog" 
          class={`transition-colors py-1 ${
            activePath.startsWith('/blog') ? 'text-[#87b2f4]' : 'text-[#475569] hover:text-[#87b2f4]'
          }`}
        >
          blog
        </a>
      </nav>

      <!-- Sign In CTA Button -->
      <a
        href={`${appUrl}/login`}
        class="group inline-flex items-center gap-1.5 bg-[#090a0f] text-white hover:bg-[#27272a] text-xs font-mono font-medium px-3.5 py-1.5 rounded-[3px] transition-colors active:scale-[0.98]"
      >
        <span>Sign in</span>
        <svg class="w-3 h-3 text-white/70 transition-transform duration-200 ease-out group-hover:translate-x-0.5 group-hover:text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14M12 5l7 7-7 7" />
        </svg>
      </a>
    </div>
  </div>
</header>
