---
import { version } from '../lib/version';

interface Props {
  activePath?: string;
}

const { activePath = '/' } = Astro.props;
---

<header class="w-full bg-white pt-4 sm:pt-6">
  <div class="mx-auto flex h-14 sm:h-16 max-w-[940px] items-center justify-between px-6 sm:px-8 md:px-10 lg:px-12">
    <!-- Brand (Left): December [version] -->
    <a href="/" class="flex items-center gap-1.5 sm:gap-2 py-1 px-1 transition-opacity hover:opacity-85 font-mono text-xs sm:text-sm">
      <span class="font-medium text-[#090a0f]">December</span>
      <span class="text-[#64748b]">{version}</span>
    </a>

    <!-- Nav Items (Right): [blog] and [docs] -->
    <div class="flex items-center gap-1.5 sm:gap-2.5 font-mono text-xs sm:text-sm">
      <!-- [blog] in bracket format -->
      <a 
        href="/blog" 
        class={`transition-colors py-1 px-1 ${
          activePath.startsWith('/blog') ? 'text-[#87b2f4]' : 'text-[#475569] hover:text-[#87b2f4]'
        }`}
      >
        [blog]
      </a>

      <!-- [docs] in bracket format -->
      <a 
        href="/docs" 
        class={`transition-colors py-1 px-1 ${
          activePath.startsWith('/docs') ? 'text-[#87b2f4]' : 'text-[#475569] hover:text-[#87b2f4]'
        }`}
      >
        [docs]
      </a>
    </div>
  </div>
</header>
