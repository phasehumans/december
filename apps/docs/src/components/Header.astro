---
import { version } from '../lib/version';

interface Props {
  activePath?: string;
}

const { activePath = '/' } = Astro.props;
const appUrl = import.meta.env.APP_URL || (import.meta.env.DEV ? 'http://localhost:3000' : 'https://app.trydecember.com');
---

<header class="relative top-auto z-10 w-full bg-white sm:bg-transparent transition-colors">
  <div class="relative z-10 mx-auto flex h-14 sm:h-16 max-w-[1120px] items-center justify-between px-4 sm:px-8 md:px-10 lg:px-12 border-x border-transparent lg:border-[#e2e8f0] bg-transparent sm:bg-white">
    <!-- Brand (Left): December [version] -->
    <a href="/" class="flex items-center gap-1.5 sm:gap-2 py-1 transition-opacity hover:opacity-85 font-mono text-xs sm:text-sm shrink-0 whitespace-nowrap">
      <span class="font-medium text-[#090a0f]">December</span>
      <span class="text-[#64748b]">{version}</span>
    </a>

    <!-- Nav Items & CTA (Right): docs, blog, and Sign in (hidden on mobile) -->
    <div class="flex items-center gap-2 sm:gap-5 font-mono text-xs sm:text-sm shrink-0">
      <nav class="hidden sm:flex items-center gap-3 sm:gap-4 font-mono text-xs sm:text-sm" aria-label="Main navigation">
        <a 
          href="/docs" 
          class={`transition-colors py-1 ${
            activePath.startsWith('/docs') ? 'text-[#87b2f4]' : 'text-[#475569] hover:text-[#87b2f4]'
          }`}
        >
          docs
        </a>

        <a 
          href="/blog" 
          class={`transition-colors py-1 ${
            activePath.startsWith('/blog') ? 'text-[#87b2f4]' : 'text-[#475569] hover:text-[#87b2f4]'
          }`}
        >
          blog
        </a>
      </nav>

      <!-- GitHub (Mobile view): visible on mobile in navbar -->
      <a
        href="https://github.com/phasehumans/december"
        target="_blank"
        rel="noopener noreferrer"
        class="flex sm:hidden items-center justify-center w-7 h-7 text-[#475569] hover:text-[#090a0f] hover:bg-[#f1f5f9] rounded-[3px] transition-colors p-1"
        aria-label="GitHub Repository"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 2A10 10 0 0 0 2 12c0 4.42 2.87 8.17 6.84 9.5.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34-.46-1.16-1.1-1.47-1.1-1.47-.9-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.87 1.52 2.34 1.07 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.92 0-1.11.38-2 1.03-2.71-.1-.25-.45-1.29.1-2.64 0 0 .84-.27 2.75 1.02a9.56 9.56 0 0 1 2.5-.34c.85.04 1.7.15 2.5.34 1.91-1.29 2.75-1.02 2.75-1.02.55 1.35.2 2.39.1 2.64.65.71 1.03 1.6 1.03 2.71 0 3.82-2.34 4.66-4.57 4.91.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0 0 12 2z"></path>
        </svg>
      </a>

      <!-- Sign In CTA Button (Hidden on mobile, visible on sm+) -->
      <a
        href={`${appUrl}/login`}
        class="hidden sm:inline-flex items-center bg-[#090a0f] text-white hover:bg-[#27272a] text-xs font-mono font-medium px-2.5 sm:px-3 py-1 h-7 rounded-[3px] transition-colors active:scale-[0.98] whitespace-nowrap shrink-0"
      >
        <span class="whitespace-nowrap">Sign in</span>
      </a>
    </div>
  </div>
</header>
