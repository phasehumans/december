---
interface Props {
  appUrl?: string;
}

const defaultAppUrl = import.meta.env.APP_URL || (import.meta.env.DEV ? 'http://localhost:3000' : 'https://app.trydecember.com');
const { appUrl = defaultAppUrl } = Astro.props;
const loginUrl = `${appUrl}/login`;
---

<!-- Floating Side Popup / Cloud Nudge (Desktop Only) -->
<aside
  id="december-cloud-nudge"
  class="hidden sm:block fixed sm:bottom-5 sm:right-5 z-50 sm:w-[280px] opacity-0 translate-y-4 pointer-events-none transition-all duration-300 ease-out"
  aria-hidden="true"
  aria-label="Try December Cloud notification"
>
  <div class="corner-brackets relative bg-white border border-[#e2e8f0] p-3 sm:p-3.5 shadow-xl">
    <span class="corner-brackets-tr"></span>
    <span class="corner-brackets-bl"></span>

    <!-- Top Row: Title & Dismiss Button -->
    <div class="flex items-start justify-between gap-2">
      <h3 class="text-[13px] font-medium text-[#090a0f] leading-snug pr-1">
        Start December in Web
      </h3>
      <button
        id="cloud-nudge-close-btn"
        type="button"
        class="w-5 h-5 -mr-1 -mt-0.5 shrink-0 flex items-center justify-center text-[#94a3b8] hover:text-[#090a0f] hover:bg-[#f8fafc] transition-colors cursor-pointer rounded-[2px]"
        aria-label="Dismiss notification"
      >
        <svg class="w-3 h-3 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <!-- Description -->
    <p class="mt-1 text-[11.5px] text-[#52525b] leading-normal">
      Run December agents in the cloud with sandbox execution, previews, and git sync.
    </p>

    <!-- Call to Action -->
    <div class="mt-2.5">
      <a
        id="cloud-nudge-cta-btn"
        href={loginUrl}
        class="group w-full h-8 inline-flex items-center justify-center gap-1.5 bg-[#090a0f] text-white hover:bg-[#27272a] text-xs font-mono font-medium px-3.5 py-1.5 rounded-[3px] transition-colors active:scale-[0.98]"
      >
        <span>Get started</span>
        <svg class="w-3 h-3 text-white/70 transition-transform duration-200 ease-out group-hover:translate-x-0.5 group-hover:text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14M12 5l7 7-7 7" />
        </svg>
      </a>
    </div>
  </div>
</aside>

<script is:inline>
  (function () {
    var timerId = null;
    var isDisplayed = false;
    var footerObserver = null;
    var isFooterVisible = false;

    function isMainPage() {
      var p = window.location.pathname;
      return p === '/' || p === '' || p === '/index.html';
    }

    function isDesktop() {
      return typeof window !== 'undefined' && window.innerWidth >= 640;
    }

    var TTL_MS = 24 * 60 * 60 * 1000; // 24 hours TTL

    function isDismissed() {
      if (window.location.search.indexOf('nudge') !== -1) {
        return false;
      }
      try {
        if (window.localStorage) {
          var val = window.localStorage.getItem('december_cloud_nudge_dismissed');
          if (val) {
            var dismissedAt = parseInt(val, 10);
            if (!isNaN(dismissedAt)) {
              if (Date.now() - dismissedAt < TTL_MS) {
                return true;
              }
            } else if (val === 'true') {
              // Legacy flag without timestamp: migrate to current timestamp
              window.localStorage.setItem('december_cloud_nudge_dismissed', String(Date.now()));
              return true;
            }
          }
        }
      } catch (e) {
        // Intentionally swallowed: localStorage access in restricted sandboxes
      }
      if (document.cookie.indexOf('december_logged_in=1') !== -1) {
        return true;
      }
      return false;
    }

    function setPopupVisible(visible) {
      var nudgeEl = document.getElementById('december-cloud-nudge');
      if (!nudgeEl) {
        return;
      }
      if (visible) {
        nudgeEl.classList.remove('opacity-0', 'translate-y-4', 'pointer-events-none');
        nudgeEl.classList.add('opacity-100', 'translate-y-0', 'pointer-events-auto');
        nudgeEl.setAttribute('aria-hidden', 'false');
      } else {
        nudgeEl.classList.remove('opacity-100', 'translate-y-0', 'pointer-events-auto');
        nudgeEl.classList.add('opacity-0', 'translate-y-4', 'pointer-events-none');
        nudgeEl.setAttribute('aria-hidden', 'true');
      }
    }

    function cleanupListeners() {
      if (timerId !== null) {
        window.clearTimeout(timerId);
        timerId = null;
      }
      window.removeEventListener('scroll', onScroll);
      if (footerObserver) {
        footerObserver.disconnect();
        footerObserver = null;
      }
    }

    function hidePopup() {
      setPopupVisible(false);
      cleanupListeners();
    }

    function dismissPopup() {
      try {
        if (window.localStorage) {
          window.localStorage.setItem('december_cloud_nudge_dismissed', String(Date.now()));
        }
      } catch (e) {
        // Intentionally swallowed: localStorage access in restricted sandboxes
      }
      hidePopup();
    }

    function showPopup() {
      if (isDisplayed || isDismissed() || !isMainPage() || !isDesktop()) {
        cleanupListeners();
        return;
      }

      var nudgeEl = document.getElementById('december-cloud-nudge');
      if (!nudgeEl) {
        return;
      }

      isDisplayed = true;
      cleanupListeners();

      if (!isFooterVisible) {
        setPopupVisible(true);
      }
    }

    function onScroll() {
      if (isDisplayed) {
        return;
      }

      var doc = document.documentElement;
      var scrollableHeight = doc.scrollHeight - window.innerHeight;

      if (scrollableHeight > 0) {
        var scrollRatio = (window.scrollY || window.pageYOffset || 0) / scrollableHeight;
        if (scrollRatio >= 0.40) {
          showPopup();
        }
      }
    }

    function setupFooterObserver() {
      if (typeof IntersectionObserver === 'undefined') {
        return;
      }
      var footerEl = document.querySelector('footer');
      if (!footerEl) {
        return;
      }

      footerObserver = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            isFooterVisible = true;
            if (isDisplayed) {
              setPopupVisible(false);
            }
          } else {
            isFooterVisible = false;
            if (isDisplayed && !isDismissed()) {
              setPopupVisible(true);
            }
          }
        });
      }, { threshold: 0.05 });

      footerObserver.observe(footerEl);
    }

    function setupNudge() {
      isDisplayed = false;
      isFooterVisible = false;
      cleanupListeners();

      // Only show on the main landing page in desktop view (>= 640px)
      if (!isMainPage() || isDismissed() || !isDesktop()) {
        hidePopup();
        return;
      }

      var closeBtn = document.getElementById('cloud-nudge-close-btn');
      if (closeBtn) {
        closeBtn.onclick = function () {
          dismissPopup();
        };
      }

      var ctaBtn = document.getElementById('cloud-nudge-cta-btn');
      if (ctaBtn) {
        ctaBtn.onclick = function () {
          dismissPopup();
        };
      }

      setupFooterObserver();

      // 7-second timer trigger (or instant with ?nudge)
      var delayMs = window.location.search.indexOf('nudge') !== -1 ? 0 : 7000;
      timerId = window.setTimeout(function () {
        showPopup();
      }, delayMs);

      // Scroll depth trigger (40% of page)
      window.addEventListener('scroll', onScroll, { passive: true });
    }

    // Astro View Transitions and initial load lifecycle
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupNudge);
    } else {
      setupNudge();
    }

    document.addEventListener('astro:page-load', setupNudge);
    document.addEventListener('astro:before-swap', cleanupListeners);
  })();
</script>
