---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CustomScrollbar from '../components/CustomScrollbar.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  activePath?: string;
  hideHeader?: boolean;
  hideFooter?: boolean;
}

const {
  title = 'December | A Coding Agent for Terminal and Cloud',
  description = 'December is an open-source coding agent for terminal and cloud. It writes code, fixes bugs, and runs commands with seamless terminal-to-cloud handoff.',
  canonicalUrl = 'https://trydecember.com',
  activePath = '/',
  hideHeader = false,
  hideFooter = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://trydecember.com/og.png" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content="https://trydecember.com/og.png" />

    <!-- Typography (Geist & Geist Mono) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@100..900&family=Geist:wght@100..900&family=Inter:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Astro View Transitions for instant client navigation -->
    <ClientRouter />
  </head>
  <body class="min-h-screen flex flex-col bg-white text-[#090a0f] selection:bg-[#87b2f4] selection:text-[#0a1128]">
    <CustomScrollbar />
    {!hideHeader && <Header activePath={activePath} />}
    <main class="flex-1">
      <slot />
    </main>
    {!hideFooter && <Footer />}
  </body>
</html>
