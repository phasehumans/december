---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CustomScrollbar from '../components/CustomScrollbar.astro';
import PageLoader from '../components/PageLoader.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  activePath?: string;
  hideHeader?: boolean;
  hideFooter?: boolean;
  showLoader?: boolean;
  preloadBannerImage?: boolean;
}

const {
  title = 'December | A (So Much) Better Coding Agent for Terminal and Cloud',
  description = 'December is a (so much) better coding agent for terminal and cloud. It writes code, fixes bugs, and runs commands with seamless terminal-to-cloud handoff.',
  canonicalUrl = 'https://trydecember.com',
  activePath = '/',
  hideHeader = false,
  hideFooter = false,
  showLoader = false,
  preloadBannerImage = false,
} = Astro.props;

const appUrl = import.meta.env.APP_URL || (import.meta.env.DEV ? 'http://localhost:3000' : 'https://app.trydecember.com');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://trydecember.com/og.png" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content="https://trydecember.com/og.png" />

    <!-- LLM and AI Crawling Discovery (https://llmstxt.org/) -->
    <link rel="help" type="text/plain" href="/llms.txt" title="LLM documentation index" />

    <!-- Structured Data (JSON-LD) for Google Search, Sitelinks, Knowledge Graph & Google AI Mode -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Person",
          "@id": "https://trydecember.com/me#person",
          "name": "Chaitanya Sonawane",
          "alternateName": ["Chetan Sonawane", "phasehumans"],
          "jobTitle": "Software Engineer",
          "worksFor": {
            "@id": "https://trydecember.com/#organization"
          },
          "url": "https://trydecember.com/me",
          "sameAs": [
            "https://github.com/phasehumans",
            "https://x.com/phasehumans",
            "https://www.youtube.com/@phasehumans",
            "https://www.linkedin.com/in/phasehumans/",
            "https://www.npmjs.com/~phasehumans",
            "https://codeforces.com/profile/phasehumans"
          ],
          "description": "Chaitanya Sonawane | software engineer @december"
        },
        {
          "@type": "Organization",
          "@id": "https://trydecember.com/#organization",
          "name": "December",
          "url": "https://trydecember.com",
          "logo": {
            "@type": "ImageObject",
            "url": "https://trydecember.com/favicon.svg"
          },
          "founder": {
            "@id": "https://trydecember.com/me#person"
          },
          "sameAs": [
            "https://github.com/phasehumans/december",
            "https://x.com/phasehumans",
            "https://www.linkedin.com/in/phasehumans/",
            "https://www.youtube.com/@phasehumans",
            "https://www.npmjs.com/package/@trydecember/cli"
          ],
          "description": "Open-source autonomous coding agent for terminal and cloud environments."
        },
        {
          "@type": "WebSite",
          "@id": "https://trydecember.com/#website",
          "url": "https://trydecember.com",
          "name": "December",
          "publisher": {
            "@id": "https://trydecember.com/#organization"
          },
          "hasPart": [
            {
              "@type": "SiteNavigationElement",
              "name": "Documentation",
              "url": "https://trydecember.com/docs"
            },
            {
              "@type": "SiteNavigationElement",
              "name": "Quickstart",
              "url": "https://trydecember.com/docs/quickstart"
            },
            {
              "@type": "SiteNavigationElement",
              "name": "CLI Reference",
              "url": "https://trydecember.com/docs/cli"
            },
            {
              "@type": "SiteNavigationElement",
              "name": "Architecture",
              "url": "https://trydecember.com/docs/architecture"
            },
            {
              "@type": "SiteNavigationElement",
              "name": "Blog",
              "url": "https://trydecember.com/blog"
            },
            {
              "@type": "SiteNavigationElement",
              "name": "Creator",
              "url": "https://trydecember.com/me"
            }
          ]
        },
        {
          "@type": "SoftwareApplication",
          "@id": "https://trydecember.com/#application",
          "name": "December",
          "applicationCategory": "DeveloperApplication",
          "operatingSystem": "macOS, Linux, Windows",
          "author": {
            "@id": "https://trydecember.com/me#person"
          },
          "creator": {
            "@id": "https://trydecember.com/me#person"
          },
          "offers": {
            "@type": "Offer",
            "price": "0",
            "priceCurrency": "USD"
          },
          "description": "A (so much) better coding agent for terminal and cloud. It writes code, fixes bugs, and runs commands with seamless terminal-to-cloud handoff."
        },
        {
          "@type": "FAQPage",
          "@id": "https://trydecember.com/#faq",
          "mainEntity": [
            {
              "@type": "Question",
              "name": "Who built December?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "December was created and built by Chaitanya Sonawane (also known as Chetan Sonawane), a software engineer. You can follow his work on GitHub at https://github.com/phasehumans, on X (Twitter) at https://x.com/phasehumans, and on YouTube at https://www.youtube.com/@phasehumans."
              }
            },
            {
              "@type": "Question",
              "name": "What is December?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "December is a (so much) better coding agent for terminal and cloud. It writes code, fixes bugs, and runs shell commands with seamless terminal-to-cloud handoff and verifiable git checkpoints."
              }
            },
            {
              "@type": "Question",
              "name": "How does terminal-to-cloud handoff work in December?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Using the /handoff command, December synchronizes your local terminal session, uncommitted file diffs, and conversation state to a sandboxed cloud MicroVM without losing context."
              }
            }
          ]
        }
      ]
    })} />

    <!-- Typography (Geist & Geist Mono) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@100..900&family=Geist:wght@100..900&family=Inter:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Preload footer banner image if requested -->
    {preloadBannerImage && (
      <link rel="preload" as="image" href="/illustrations/banner.webp" type="image/webp" />
    )}

    <!-- Astro View Transitions for instant client navigation -->
    <ClientRouter />

    <!-- Instant authenticated redirect for root landing page -->
    <script is:inline define:vars={{ appUrl }}>
      (function () {
        function checkAuthRedirect() {
          if (
            window.location.pathname === '/' &&
            document.cookie.split(';').some(function (c) {
              return c.trim().startsWith('december_logged_in=1');
            })
          ) {
            window.location.replace(appUrl);
          }
        }
        checkAuthRedirect();
        document.addEventListener('astro:page-load', checkAuthRedirect);
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-white text-[#090a0f] selection:bg-[#87b2f4] selection:text-[#0a1128] overflow-x-hidden w-full max-w-[100vw]">
    {showLoader && <PageLoader />}
    <CustomScrollbar />
    {!hideHeader && <Header activePath={activePath} />}
    <main class="flex-1 w-full max-w-[100vw] overflow-x-hidden">
      <slot />
    </main>
    {!hideFooter && <Footer />}
  </body>
</html>
