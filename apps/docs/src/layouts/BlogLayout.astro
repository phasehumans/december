---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title?: string;
  description?: string;
  currentSlug?: string;
  frontmatter?: {
    title?: string;
    description?: string;
    currentSlug?: string;
  };
}

const { frontmatter } = Astro.props;
const title = frontmatter?.title || Astro.props.title || 'Blog Post';
const description = frontmatter?.description || Astro.props.description;
const currentSlug = frontmatter?.currentSlug ?? Astro.props.currentSlug ?? '';
---

<BaseLayout
  title={`${title} | December`}
  description={description}
  canonicalUrl={`https://trydecember.com/blog/${currentSlug}`}
  activePath="/blog"
  hideHeader={true}
  hideFooter={true}
>
  <!-- Same column, size and colours as /me: no site header or footer, a back link to the post list, no links to other posts -->
  <div class="min-h-dvh w-full flex flex-col items-center px-6 py-8 sm:py-16">
    <article class="w-full max-w-[520px] min-w-0 flex flex-col">
      <!-- Back to the post list: grey, black on hover, the arrow moves left a little -->
      <a
        href="/me#blog"
        class="group self-start inline-flex items-center gap-1.5 -ml-0.5 py-1 font-mono text-xs text-[#64748b] hover:text-[#090a0f] transition-colors"
      >
        <svg class="w-3 h-3 transition-transform duration-150 group-hover:-translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M19 12H5M12 19l-7-7 7-7" />
        </svg>
        blog
      </a>

      <!-- Title only, lowercase like the /me lists: no date or read time -->
      <h1 class="mt-7 sm:mt-9 text-sm sm:text-base font-medium text-[#090a0f] leading-snug">
        {title.toLowerCase()}
      </h1>

      <div class="mt-6 docs-prose blog-prose min-w-0 max-w-full">
        <slot />
      </div>
    </article>
  </div>
</BaseLayout>
