---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title?: string;
  description?: string;
  currentSlug?: string;
  frontmatter?: {
    title?: string;
    description?: string;
    currentSlug?: string;
  };
}

const { frontmatter } = Astro.props;
const title = frontmatter?.title || Astro.props.title || 'Documentation';
const description = frontmatter?.description || Astro.props.description;
const currentSlug = frontmatter?.currentSlug !== undefined ? frontmatter.currentSlug : (Astro.props.currentSlug ?? '');

const docSections = [
  {
    category: 'Getting Started',
    items: [
      { slug: '', label: 'Overview' },
      { slug: 'quickstart', label: 'Quickstart (60s)' },
    ],
  },
  {
    category: 'Core Concepts',
    items: [
      { slug: 'architecture', label: 'System Architecture' },
      { slug: 'agent-loop', label: 'Agent Reasoning Loop' },
      { slug: 'checkpoints', label: 'Git Checkpoints' },
      { slug: 'previews', label: 'Live Sandboxed Previews' },
    ],
  },
  {
    category: 'Interfaces & CLI',
    items: [
      { slug: 'cli', label: 'CLI Reference' },
      { slug: 'slash-commands', label: 'Slash Commands' },
      { slug: 'prompting', label: 'Prompting Guide' },
    ],
  },
  {
    category: 'Ecosystem & Safety',
    items: [
      { slug: 'integrations', label: 'Model Providers & BYOK' },
      { slug: 'security', label: 'Security & Isolation' },
    ],
  },
];
---

<BaseLayout
  title={`${title} — December Documentation`}
  description={description}
  activePath={`/docs/${currentSlug}`}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8 md:py-12">
    <div class="flex flex-col lg:flex-row gap-10">
      <!-- Left Sidebar Navigation -->
      <aside class="w-full lg:w-64 shrink-0">
        <div class="sticky top-20 flex flex-col gap-6 max-h-[calc(100vh-6rem)] overflow-y-auto pr-2">
          <div class="pb-2 border-b border-[#222222]">
            <a href="/docs" class="text-sm font-mono text-[#888888] hover:text-white transition-colors flex items-center gap-1.5">
              <span>← Back to Overview</span>
            </a>
          </div>

          <nav class="space-y-6">
            {docSections.map((section) => (
              <div>
                <h4 class="text-[11px] font-mono uppercase tracking-wider text-[#666666] mb-2 px-2">
                  {section.category}
                </h4>
                <ul class="space-y-1">
                  {section.items.map((item) => {
                    const href = item.slug ? `/docs/${item.slug}` : '/docs';
                    const isActive = currentSlug === item.slug;
                    return (
                      <li>
                        <a
                          href={href}
                          class={`block px-2.5 py-1.5 rounded-md text-[13px] transition-colors ${
                            isActive
                              ? 'bg-[#1e1e1e] text-white font-medium border border-[#333333]'
                              : 'text-[#999999] hover:bg-[#151515] hover:text-[#dddddd]'
                          }`}
                        >
                          {item.label}
                        </a>
                      </li>
                    );
                  })}
                </ul>
              </div>
            ))}
          </nav>
        </div>
      </aside>

      <!-- Center Content Area -->
      <article class="flex-1 min-w-0 max-w-3xl pb-16">
        <!-- Breadcrumbs -->
        <div class="flex items-center gap-2 text-[12px] font-mono text-[#666666] mb-6">
          <a href="/" class="hover:text-white transition-colors">home</a>
          <span>/</span>
          <a href="/docs" class="hover:text-white transition-colors">docs</a>
          {currentSlug && (
            <>
              <span>/</span>
              <span class="text-[#aaaaaa]">{currentSlug}</span>
            </>
          )}
        </div>

        <header class="mb-8 border-b border-[#222222] pb-6">
          <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight text-white">{title}</h1>
          {description && (
            <p class="mt-3 text-base text-[#999999] leading-relaxed">{description}</p>
          )}
        </header>

        <!-- Markdown / MDX Content Slot -->
        <div class="docs-prose text-[#cccccc] text-[15px] leading-relaxed space-y-6">
          <slot />
        </div>
      </article>
    </div>
  </div>
</BaseLayout>

<style is:global>
  .docs-prose h2 {
    font-size: 1.5rem;
    font-weight: 600;
    color: #ffffff;
    margin-top: 2.25rem;
    margin-bottom: 0.75rem;
    letter-spacing: -0.02em;
    border-bottom: 1px solid #222222;
    padding-bottom: 0.5rem;
  }

  .docs-prose h3 {
    font-size: 1.2rem;
    font-weight: 500;
    color: #eeeeee;
    margin-top: 1.75rem;
    margin-bottom: 0.5rem;
    letter-spacing: -0.01em;
  }

  .docs-prose p {
    margin-bottom: 1.25rem;
    color: #bbbbba;
    line-height: 1.7;
  }

  .docs-prose ul {
    list-style-type: disc;
    padding-left: 1.5rem;
    margin-bottom: 1.25rem;
    color: #bbbbba;
  }

  .docs-prose li {
    margin-bottom: 0.4rem;
  }

  .docs-prose code {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background-color: #1a1a1a;
    color: #e5e5e5;
    padding: 0.15rem 0.35rem;
    border-radius: 0.25rem;
    border: 1px solid #292929;
  }

  .docs-prose pre {
    background-color: #111111 !important;
    border: 1px solid #242424;
    border-radius: 0.5rem;
    padding: 1rem;
    overflow-x: auto;
    margin: 1.25rem 0;
  }

  .docs-prose pre code {
    background-color: transparent;
    padding: 0;
    border: none;
    font-size: 0.85rem;
    color: #dddddd;
  }

  .docs-prose blockquote {
    border-left: 3px solid #3b82f6;
    background-color: rgba(59, 130, 246, 0.05);
    padding: 0.75rem 1rem;
    margin: 1.25rem 0;
    border-radius: 0 0.375rem 0.375rem 0;
  }

  .docs-prose strong {
    color: #ffffff;
    font-weight: 600;
  }

  .docs-prose a {
    color: #60a5fa;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>
