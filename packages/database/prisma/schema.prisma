generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                     String          @id @default(uuid())
  name                   String
  email                  String          @unique
  password               String?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  emailVerified          Boolean         @default(false)
  googleId               String?
  otpExpiresAt           DateTime?
  otpHash                String?
  githubId               String?         @unique
  githubToken            String?
  githubUsername         String?
  githubConnected        Boolean         @default(false)
  githubAppInstall       Boolean         @default(false)
  notifyProductUpdates   Boolean         @default(true)
  notifyProjectActivity  Boolean         @default(true)
  notifySecurityAlerts   Boolean         @default(true)
  deletedAt              DateTime?
  isDeleted              Boolean         @default(false)
  creditBalance          Float           @default(0)
  hasCompletedOnboarding Boolean         @default(false)
  welcomeCardDone        Boolean         @default(false)
  githubCardDone         Boolean         @default(false)
  feedbackCardDone       Boolean         @default(false)

  notifications      Notification[]
  authSessions       AuthSession[]
  sessions           Session[]
  walletTransactions WalletTransaction[]
  usageEvents        UsageEvent[]
  deviceCodes        DeviceCode[]
  redeemClaims       RedeemCodeClaim[]
  githubInstallations GithubAppInstallation[]
  secrets            Secret[]
  feedbacks          Feedback[]
  projects           Project[]
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  title     String
  message   String
  isRead    Boolean          @default(false)
  type      NotificationType @default(INFO)
  link      String?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
  @@index([createdAt])
}

model AuthSession {
  id               String    @id @default(uuid())
  userId           String
  refreshTokenHash         String    @unique
  previousRefreshTokenHash String?
  rotatedAt                DateTime?
  userAgent                String?
  ipAddress        String?
  expiresAt        DateTime
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  isRevoked        Boolean   @default(false)
  revokedAt        DateTime?
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([userId, isRevoked])
}

model Session {
  id                   String      @id @default(uuid())
  title                String?
  description          String?
  userId               String
  type                 SessionType @default(WEB)
  vmId                 String?
  vmStatus             VmStatus    @default(STOPPED)
  isArchived           Boolean     @default(false)
  tags                 String[]
  githubLastSyncedAt   DateTime?
  githubRepoName       String?
  githubRepoOwner      String?
  githubRepoUrl        String?
  repoUrl              String?
  branch               String?
  gitRef               String?
  issueNumber          Int?
  projectId            String?
  epoch                Int                   @default(1)
  leaseExpiresAt       DateTime?
  leaseOwner           String?
  status               String                @default("IDLE")
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  deletedAt            DateTime?

  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  project         Project?              @relation(fields: [projectId], references: [id], onDelete: SetNull)
  messages        Message[]
  settings        SessionSettings?
  memories        SessionMemory[]
  usageEvents        UsageEvent[]
  durableSteps       DurableStep[]
  mailboxMessages    MailboxMessage[]
  wakeUpTriggers     WakeUpTrigger[]

  @@index([userId])
  @@index([projectId])
}

model Project {
  id            String    @id @default(uuid())
  name          String
  description   String?
  userId        String
  repoOwner     String?
  repoName      String?
  repoUrl       String?
  defaultBranch String?   @default("main")
  pinnedRules   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions      Session[]

  @@index([userId])
}

model SessionSettings {
  id        String   @id @default(uuid())
  sessionId String   @unique
  config    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model DurableStep {
  id          String   @id @default(uuid())
  sessionId   String
  stepIndex   Int
  stepType    String
  opId        String?
  input       Json?
  output      Json?
  outputRef   String?
  durationMs  Int?
  createdAt   DateTime @default(now())

  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, stepIndex])
  @@index([sessionId])
  @@index([sessionId, opId])
}

model MailboxMessage {
  id          String    @id @default(uuid())
  sessionId   String
  sender      String    // USER | SYSTEM | WEBHOOK | CRON
  content     String
  status      String    @default("QUEUED") // QUEUED, PLACED, COMPLETED, FAILED
  metadata    Json?
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  session     Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, status])
  @@index([status, createdAt])
}

model WakeUpTrigger {
  id          String    @id @default(uuid())
  sessionId   String
  triggerAt   DateTime
  reason      String?   // scheduled_wake, cron_check, pr_review, etc.
  status      String    @default("PENDING") // PENDING, PROCESSING, COMPLETED, CANCELLED
  payload     Json?
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  session     Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([triggerAt, status])
  @@index([sessionId])
}

enum SessionType {
  WEB
  SEARCH
}

enum VmStatus {
  PROVISIONING
  RUNNING
  STOPPED
  FAILED
}

model SessionMemory {
  id        String   @id @default(uuid())
  sessionId String
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, key])
  @@index([sessionId])
}

model Message {
  id        String      @id @default(uuid())
  role      MessageRole
  content   String
  status    String?
  sequence  Int
  blocks    Json?
  sessionId String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, sequence])
}

model WalletTransaction {
  id                String          @id @default(uuid())
  userId            String
  amountInCents     Int
  currency          String          @default("USD")
  provider          PaymentProvider
  providerOrderId   String?
  providerPaymentId String?
  status            PaymentStatus   @default(PENDING)
  metadata          Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum PaymentProvider {
  RAZORPAY
  COINBASE
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

model UsageEvent {
  id                String   @id @default(uuid())
  userId            String
  sessionId         String?
  model             String
  inputTokens       Int      @default(0)
  outputTokens      Int      @default(0)
  totalTokens       Int      @default(0)
  costInCents       Float    @default(0)
  chatId            String?
  externalRequestId String?  @unique
  metadata          Json?
  periodStart       DateTime
  periodEnd         DateTime
  createdAt         DateTime @default(now())

  session Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, periodStart])
  @@index([userId, periodStart, createdAt])
  @@index([sessionId, createdAt])
  @@index([createdAt])
}

enum NotificationType {
  INFO
  WARNING
  SUCCESS
  ERROR
}


enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model DeviceCode {
  id         String           @id @default(uuid())
  deviceCode String           @unique
  userCode   String           @unique
  userId     String?
  expiresAt  DateTime
  status     DeviceCodeStatus @default(PENDING)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  user       User?            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([deviceCode])
  @@index([userCode])
  @@index([userId])
}

enum DeviceCodeStatus {
  PENDING
  APPROVED
  EXPIRED
}

model RedeemCode {
  id              String            @id @default(uuid())
  codeHash        String            @unique
  creditAmount    Int
  maxRedemptions  Int?
  redemptionCount Int               @default(0)
  expiresAt       DateTime?
  metadata        Json?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  claims          RedeemCodeClaim[]
}

model RedeemCodeClaim {
  id           String     @id @default(uuid())
  redeemCodeId String
  userId       String
  redeemedAt   DateTime   @default(now())
  redeemCode   RedeemCode @relation(fields: [redeemCodeId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([redeemCodeId, userId])
  @@index([userId])
}

model GithubAppInstallation {
  id             String   @id @default(uuid())
  installationId String   @unique
  userId         String?
  accountLogin   String?
  accountType    String?
  targetType     String?
  permissions    Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Secret {
  id        String   @id @default(uuid())
  userId    String
  name      String
  value     String   // Encrypted value
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
}

model Feedback {
  id        String   @id @default(uuid())
  userId    String
  rating    String?
  feedback  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

