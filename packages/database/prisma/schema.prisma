generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String        @id @default(uuid())
  name                  String
  email                 String        @unique
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  emailVerified         Boolean       @default(false)
  googleId              String?
  otpExpiresAt          DateTime?
  otpHash               String?
  otpAttempts           Int           @default(0)
  githubId              String?       @unique
  githubToken           String?
  githubUsername        String?
  githubConnected       Boolean       @default(false)
  githubAppInstall      Boolean       @default(false)
  notifyProductUpdates  Boolean       @default(true)
  notifyProjectActivity Boolean       @default(true)
  notifySecurityAlerts  Boolean       @default(true)
  deletedAt             DateTime?
  isDeleted             Boolean       @default(false)
  creditBalance         Float         @default(0)
  // empty until the user finishes the /onboarding flow (finished or skipped through)
  onboardingCompletedAt DateTime?
  // last onboarding step the user was on: github | start | models
  onboardingStep        String?
  defaultModelSource    BillingSource @default(CREDITS)

  notifications       Notification[]
  authSessions        AuthSession[]
  sessions            Session[]
  walletTransactions  WalletTransaction[]
  usageEvents         UsageEvent[]
  deviceCodes         DeviceCode[]
  redeemClaims        RedeemCodeClaim[]
  githubInstallations GithubAppInstallation[]
  secrets             Secret[]
  feedbacks           Feedback[]
  projects            Project[]
  providerCredentials ProviderCredential[]
  gitConnections      GitConnection[]
  featureWaitlists    FeatureWaitlist[]
  creditRequests      CreditRequest[]
  pullRequestSettings PullRequestSettings?
}

// how a cloud run pays for model tokens
enum BillingSource {
  CREDITS
  OWN_KEY
}

// a user's own api key for one provider, used by december cloud runs.
// encryptedKey is aes-256-gcm with SECRETS_ENC_KEY; the key itself is never returned.
model ProviderCredential {
  id           String    @id @default(uuid())
  userId       String
  provider     String
  encryptedKey String
  keyHint      String
  models       Json
  defaultModel String
  verifiedAt   DateTime
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
}

// the git hosts december cloud works with
enum GitProvider {
  GITHUB
  GITLAB
}

// a user's account on a git host (gitlab today; github still uses the User.github* columns).
// the tokens are aes-256-gcm with SECRETS_ENC_KEY, like ProviderCredential, and never leave the server
// and the worker. expiresAt is when the access token stops working (gitlab tokens last 2 hours).
model GitConnection {
  id                    String      @id @default(uuid())
  userId                String
  provider              GitProvider
  externalId            String
  username              String
  encryptedAccessToken  String
  encryptedRefreshToken String?
  expiresAt             DateTime?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  user                  User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@unique([provider, externalId])
  @@index([userId])
}

// one row per user per coming-soon feature: who asked to be notified and who saw the popup
model FeatureWaitlist {
  id          String    @id @default(uuid())
  userId      String
  feature     String
  joinedAt    DateTime?
  popupSeenAt DateTime?
  notifiedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, feature])
  @@index([feature, joinedAt])
}

model Notification {
  id        String               @id @default(uuid())
  userId    String
  title     String
  message   String
  isRead    Boolean              @default(false)
  type      NotificationType     @default(INFO)
  // MENTION = a person talked to you or December (replies, review comments, @trydecember)
  category  NotificationCategory @default(GENERAL)
  link      String?
  createdAt DateTime             @default(now())
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
  @@index([userId, category, isRead])
  @@index([createdAt])
}

model AuthSession {
  id                       String    @id @default(uuid())
  userId                   String
  refreshTokenHash         String    @unique
  previousRefreshTokenHash String?
  rotatedAt                DateTime?
  userAgent                String?
  ipAddress                String?
  expiresAt                DateTime
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  isRevoked                Boolean   @default(false)
  revokedAt                DateTime?
  user                     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([userId, isRevoked])
}

model Session {
  id                 String         @id @default(uuid())
  title              String?
  description        String?
  userId             String
  type               SessionType    @default(WEB)
  vmId               String?
  vmStatus           VmStatus       @default(STOPPED)
  isArchived         Boolean        @default(false)
  tags               String[]
  githubLastSyncedAt DateTime?
  githubRepoName     String?
  githubRepoOwner    String?
  githubRepoUrl      String?
  gitProvider        GitProvider    @default(GITHUB)
  repoUrl            String?
  branch             String?
  gitRef             String?
  issueNumber        Int?
  // the pull request December opened for this session (saved by the worker)
  prNumber           Int?
  prUrl              String?
  prState            String?
  prTitle            String?
  prBranch           String?
  // pinned sessions come first in the recent list; the date orders the pins
  pinnedAt           DateTime?
  // the agent asked a question and waits for an answer (the question itself lives in Redis)
  pendingQuestionAt  DateTime?
  // set when the session was started from GitHub by the December GitHub App: the mode
  // (issue | change | review), the installation, the issue or pull request and its refs
  githubRun          Json?
  projectId          String?
  epoch              Int            @default(1)
  leaseExpiresAt     DateTime?
  leaseOwner         String?
  status             String         @default("IDLE")
  // the E2B sandbox itself, apart from the agent run (vmStatus). it stays RUNNING after a
  // turn for the preview, terminal and next prompt until the idle sweeper pauses it
  sandboxStatus      SandboxStatus?
  // last agent step, terminal input or preview request on the sandbox (idle pause after 10 minutes)
  vmLastActivityAt   DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  deletedAt          DateTime?

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  project         Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  messages        Message[]
  settings        SessionSettings?
  memories        SessionMemory[]
  usageEvents     UsageEvent[]
  durableSteps    DurableStep[]
  mailboxMessages MailboxMessage[]
  wakeUpTriggers  WakeUpTrigger[]

  @@index([userId])
  @@index([userId, prNumber])
  @@index([userId, pinnedAt])
  @@index([projectId])
  @@index([userId, sandboxStatus])
  @@index([sandboxStatus, vmLastActivityAt])
}

model Project {
  id            String      @id @default(uuid())
  name          String
  description   String?
  userId        String
  repoOwner     String?
  repoName      String?
  repoUrl       String?
  gitProvider   GitProvider @default(GITHUB)
  defaultBranch String?     @default("main")
  pinnedRules   String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions Session[]

  @@index([userId])
}

model SessionSettings {
  id        String   @id @default(uuid())
  sessionId String   @unique
  config    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model DurableStep {
  id         String   @id @default(uuid())
  sessionId  String
  stepIndex  Int
  stepType   String
  opId       String?
  input      Json?
  output     Json?
  outputRef  String?
  durationMs Int?
  createdAt  DateTime @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, stepIndex])
  @@index([sessionId])
  @@index([sessionId, opId])
}

model MailboxMessage {
  id          String    @id @default(uuid())
  sessionId   String
  sender      String // USER | SYSTEM | WEBHOOK | CRON
  content     String
  status      String    @default("QUEUED") // QUEUED, PLACED, COMPLETED, FAILED
  metadata    Json?
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, status])
  @@index([status, createdAt])
}

model WakeUpTrigger {
  id          String    @id @default(uuid())
  sessionId   String
  triggerAt   DateTime
  reason      String? // scheduled_wake, cron_check, pr_review, etc.
  status      String    @default("PENDING") // PENDING, PROCESSING, COMPLETED, CANCELLED
  payload     Json?
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([triggerAt, status])
  @@index([sessionId])
}

enum SessionType {
  WEB
  SEARCH
}

enum VmStatus {
  PROVISIONING
  RUNNING
  STOPPED
  FAILED
}

// #624 part 4: at most 10 STARTING or RUNNING sandboxes per user. PAUSED keeps the files
// and memory and does not count; STOPPED is gone
enum SandboxStatus {
  STARTING
  RUNNING
  PAUSED
  STOPPED
}

model SessionMemory {
  id        String   @id @default(uuid())
  sessionId String
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, key])
  @@index([sessionId])
}

model Message {
  id        String      @id @default(uuid())
  role      MessageRole
  content   String
  status    String?
  sequence  Int
  blocks    Json?
  sessionId String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, sequence])
}

model WalletTransaction {
  id                String          @id @default(uuid())
  userId            String
  amountInCents     Int
  currency          String          @default("USD")
  provider          PaymentProvider
  providerOrderId   String?
  providerPaymentId String?
  status            PaymentStatus   @default(PENDING)
  metadata          Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum PaymentProvider {
  RAZORPAY
  COINBASE
  // free credits an admin approved (credit requests)
  GRANT
  // credits an admin added or removed by hand, with a reason
  ADJUSTMENT
}

enum CreditRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// a request for the one-time $5 free credits. one per normalized address, for good:
// the row stays when the account is deleted, and a rejection is final.
model CreditRequest {
  id               String              @id @default(uuid())
  userId           String?
  normalizedEmail  String              @unique
  status           CreditRequestStatus @default(PENDING)
  buildPlan        String
  heardFrom        String
  agreedToFeedback Boolean             @default(false)
  ipAddress        String?
  userAgent        String?
  reviewedBy       String?
  reviewedAt       DateTime?
  rejectReason     String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId])
  @@index([ipAddress])
}

// one row for every admin action. adminUserId is not a relation so the log outlives accounts.
model AdminAuditLog {
  id          String   @id @default(uuid())
  adminUserId String
  action      String
  targetType  String
  targetId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([targetType, targetId])
}

enum AnnouncementKind {
  ANNOUNCEMENT
  FEEDBACK_REQUEST
}

// a message the admin page sent to users (replaces scripts/announce.py and scripts/feedback.ts)
model Announcement {
  id              String           @id @default(uuid())
  kind            AnnouncementKind @default(ANNOUNCEMENT)
  subject         String
  body            String
  // feedback requests: users who signed up this many days ago
  signedUpDaysAgo Int?
  createdBy       String
  recipientCount  Int              @default(0)
  skippedCount    Int              @default(0)
  sentAt          DateTime?
  createdAt       DateTime         @default(now())

  @@index([createdAt])
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

model UsageEvent {
  id                String        @id @default(uuid())
  userId            String
  sessionId         String?
  model             String
  inputTokens       Int           @default(0)
  outputTokens      Int           @default(0)
  totalTokens       Int           @default(0)
  costInCents       Float         @default(0)
  chatId            String?
  externalRequestId String?       @unique
  metadata          Json?
  billingSource     BillingSource @default(CREDITS)
  periodStart       DateTime
  periodEnd         DateTime
  createdAt         DateTime      @default(now())

  session Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, periodStart])
  @@index([userId, periodStart, createdAt])
  @@index([sessionId, createdAt])
  @@index([createdAt])
}

enum NotificationType {
  INFO
  WARNING
  SUCCESS
  ERROR
}

enum NotificationCategory {
  GENERAL
  MENTION
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model DeviceCode {
  id         String           @id @default(uuid())
  deviceCode String           @unique
  userCode   String           @unique
  userId     String?
  expiresAt  DateTime
  status     DeviceCodeStatus @default(PENDING)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  user       User?            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([deviceCode])
  @@index([userCode])
  @@index([userId])
}

enum DeviceCodeStatus {
  PENDING
  APPROVED
  EXPIRED
}

model RedeemCode {
  id              String            @id @default(uuid())
  codeHash        String            @unique
  creditAmount    Int
  maxRedemptions  Int?
  redemptionCount Int               @default(0)
  expiresAt       DateTime?
  metadata        Json?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  claims          RedeemCodeClaim[]
}

model RedeemCodeClaim {
  id           String     @id @default(uuid())
  redeemCodeId String
  userId       String
  redeemedAt   DateTime   @default(now())
  redeemCode   RedeemCode @relation(fields: [redeemCodeId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([redeemCodeId, userId])
  @@index([userId])
}

// how December opens and handles pull requests, and what the GitHub App does on its own.
// one row per user; a missing row means every default below.
model PullRequestSettings {
  id                    String   @id @default(uuid())
  userId                String   @unique
  // opening (#637)
  branchPrefix          String   @default("december/")
  prDraft               Boolean  @default(false)
  prCreate              String   @default("auto")
  prAuthor              String   @default("december")
  commitAuthor          String   @default("both")
  archiveOnMerge        Boolean  @default(true)
  // github app (#568): pause, replies and review
  githubCommentsEnabled Boolean  @default(true)
  reviewReplies         String   @default("mention")
  replyToBots           Boolean  @default(false)
  fixFailedChecks       Boolean  @default(true)
  autoReview            String   @default("asked")
  reviewCadence         String   @default("once")
  // empty means every repository the app can see
  reviewRepos           String[] @default([])
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GithubAppInstallation {
  id             String   @id @default(uuid())
  installationId String   @unique
  userId         String?
  accountLogin   String?
  accountType    String?
  targetType     String?
  permissions    Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Secret {
  id        String   @id @default(uuid())
  userId    String
  name      String
  value     String // Encrypted value
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
}

model Feedback {
  id        String   @id @default(uuid())
  userId    String
  rating    String?
  feedback  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
