generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                     String        @id @default(uuid())
  name                   String
  email                  String        @unique
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  emailVerified          Boolean       @default(false)
  googleId               String?
  otpExpiresAt           DateTime?
  otpHash                String?
  otpAttempts            Int           @default(0)
  githubId               String?       @unique
  githubToken            String?
  githubUsername         String?
  githubConnected        Boolean       @default(false)
  githubAppInstall       Boolean       @default(false)
  notifyProductUpdates   Boolean       @default(true)
  notifySecurityAlerts   Boolean       @default(true)
  // what December tells the user about (#636): ALL, IMPORTANT (needs input, failed, low
  // credits) or NONE, and where: email and browser push
  notifyLevel            NotifyLevel   @default(IMPORTANT)
  notifyEmail            Boolean       @default(true)
  notifyPush             Boolean       @default(false)
  // one mail a day at digestTime (HH:mm in timezone) with what happened since the last one
  digestEnabled          Boolean       @default(false)
  digestTime             String        @default("09:00")
  timezone               String        @default("UTC")
  lastDigestAt           DateTime?
  deletedAt              DateTime?
  isDeleted              Boolean       @default(false)
  creditBalance          Float         @default(0)
  // spend limits (#638), whole cents, null is off. the low balance alert goes out once when
  // the balance goes under lowBalanceAlertCents; lowBalanceAlertedAt marks that it went out
  lowBalanceAlertCents   Int?          @default(100)
  lowBalanceAlertedAt    DateTime?
  sessionLimitCents      Int?
  dayLimitCents          Int?
  // "continue" at the day limit: the cost of that day (YYYY-MM-DD in timezone) that was let through
  dayLimitAllowanceDay   String?
  dayLimitAllowanceCents Float         @default(0)
  // empty until the user finishes the /onboarding flow (finished or skipped through)
  onboardingCompletedAt  DateTime?
  // last onboarding step the user was on: github | start | models
  onboardingStep         String?
  defaultModelSource     BillingSource @default(CREDITS)
  // defaults for a new session (#632): plan first, effort (fast | deep), open a pull request
  defaultPlanFirst       Boolean       @default(false)
  defaultEffort          String        @default("deep")
  defaultOpenPullRequest Boolean       @default(true)
  // more defaults for a new session (#637): the model of the user's own key, the repository
  // ('last-used' or a full name) and the base branch ('default' or a branch name)
  defaultOwnKeyProvider  String?
  defaultOwnKeyModel     String?
  defaultRepository      String        @default("last-used")
  defaultBaseBranch      String        @default("default")
  // tool calls the agent may never make in cloud sessions (/permissions, #632)
  toolDenyRules          String[]      @default([])
  // the admin page can open this user's sessions until this date (#636). null means off
  supportAccessUntil     DateTime?
  // web preferences kept across devices (#636): sendKey, soundOnFinish, messageWhileWorking
  preferences            Json?
  // the code of this user's invite link (#638). empty until the user first reads the link
  referralCode           String?       @unique
  // sandbox settings (#637): the sandbox is paused after this many minutes with no activity
  // (10, 30 or 60), and sessions not updated for archiveAfterDays (7 or 30) are archived.
  // null means never archive
  idleStopMinutes        Int           @default(10)
  archiveAfterDays       Int?

  notifications       Notification[]
  authSessions        AuthSession[]
  pushSubscriptions   PushSubscription[]
  sessions            Session[]
  walletTransactions  WalletTransaction[]
  usageEvents         UsageEvent[]
  deviceCodes         DeviceCode[]
  redeemClaims        RedeemCodeClaim[]
  githubInstallations GithubAppInstallation[]
  secrets             Secret[]
  feedbacks           Feedback[]
  projects            Project[]
  providerCredentials ProviderCredential[]
  gitConnections      GitConnection[]
  featureWaitlists    FeatureWaitlist[]
  creditRequests      CreditRequest[]
  pullRequestSettings PullRequestSettings?
  repositorySettings  RepositorySetting[]
  skills              UserSkill[]
  mcpServers          UserMcpServer[]
  ownedTeam           Team?
  teamMemberships     TeamMember[]
  teamInvitesSent     TeamInvite[]
  auditEvents         AuditEvent[]
  referralsMade       Referral[]              @relation("ReferralInviter")
  referredBy          Referral?               @relation("ReferralInvitee")
  adminTotp           AdminTotp?

  // the daily purge finds accounts deleted more than 90 days ago
  @@index([deletedAt])
}

// how a cloud run pays for model tokens
enum BillingSource {
  CREDITS
  OWN_KEY
}

// a user's own api key for one provider, used by december cloud runs.
// encryptedKey is aes-256-gcm with SECRETS_ENC_KEY; the key itself is never returned.
model ProviderCredential {
  id           String    @id @default(uuid())
  userId       String
  provider     String
  encryptedKey String
  keyHint      String
  models       Json
  defaultModel String
  verifiedAt   DateTime
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
}

// the git hosts december cloud works with
enum GitProvider {
  GITHUB
  GITLAB
}

// a user's account on a git host (gitlab today; github still uses the User.github* columns).
// the tokens are aes-256-gcm with SECRETS_ENC_KEY, like ProviderCredential, and never leave the server
// and the worker. expiresAt is when the access token stops working (gitlab tokens last 2 hours).
model GitConnection {
  id                    String      @id @default(uuid())
  userId                String
  provider              GitProvider
  externalId            String
  username              String
  encryptedAccessToken  String
  encryptedRefreshToken String?
  expiresAt             DateTime?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  user                  User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@unique([provider, externalId])
  @@index([userId])
}

// one row per user per coming-soon feature: who asked to be notified and who saw the popup
model FeatureWaitlist {
  id          String    @id @default(uuid())
  userId      String
  feature     String
  joinedAt    DateTime?
  popupSeenAt DateTime?
  notifiedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, feature])
  @@index([feature, joinedAt])
}

model Notification {
  id        String               @id @default(uuid())
  userId    String
  title     String
  message   String
  isRead    Boolean              @default(false)
  type      NotificationType     @default(INFO)
  // MENTION = a person talked to you or December (replies, review comments, @trydecember)
  category  NotificationCategory @default(GENERAL)
  link      String?
  createdAt DateTime             @default(now())
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
  @@index([userId, category, isRead])
  @@index([createdAt])
}

model AuthSession {
  id                       String             @id @default(uuid())
  userId                   String
  refreshTokenHash         String             @unique
  previousRefreshTokenHash String?
  rotatedAt                DateTime?
  // when the admin last entered an authenticator code in this sign-in (admin panel only)
  adminVerifiedAt          DateTime?
  userAgent                String?
  ipAddress                String?
  expiresAt                DateTime
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  isRevoked                Boolean            @default(false)
  revokedAt                DateTime?
  user                     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  // browsers that turned push on while signed in with this session (#636)
  pushSubscriptions        PushSubscription[]

  @@index([userId])
  @@index([expiresAt])
  @@index([userId, isRevoked])
}

model Session {
  id                   String         @id @default(uuid())
  title                String?
  description          String?
  userId               String
  type                 SessionType    @default(WEB)
  vmId                 String?
  vmStatus             VmStatus       @default(STOPPED)
  isArchived           Boolean        @default(false)
  tags                 String[]
  githubLastSyncedAt   DateTime?
  githubRepoName       String?
  githubRepoOwner      String?
  githubRepoUrl        String?
  gitProvider          GitProvider    @default(GITHUB)
  repoUrl              String?
  branch               String?
  gitRef               String?
  issueNumber          Int?
  // the pull request December opened for this session (saved by the worker)
  prNumber             Int?
  // the host's id of the repository the pull request is in (GitHub repo id, GitLab
  // project id). webhooks match by it, so a renamed repository, or a new one with an old
  // name, cannot change the pull request of another repository
  githubRepoId         String?
  prUrl                String?
  prState              String?
  prTitle              String?
  prBranch             String?
  // pull request dates and line counts; the github app webhook keeps the state current (#632)
  prOpenedAt           DateTime?
  prMergedAt           DateTime?
  prClosedAt           DateTime?
  // last change of the pull request on the git host (push, edit, state); the Pull
  // requests page sorts and shows "Updated" by it
  prUpdatedAt          DateTime?
  // last time prState was read from the git host (refresh on read for missed webhooks)
  prCheckedAt          DateTime?
  prAdditions          Int?
  prDeletions          Int?
  // messages before this sequence are out of the agent's context (/clear, /compact)
  contextStartSequence Int            @default(0)
  // pinned sessions come first in the recent list; the date orders the pins
  pinnedAt             DateTime?
  // the agent asked a question and waits for an answer (the question itself lives in Redis)
  pendingQuestionAt    DateTime?
  // spend limits (#638). limitAllowanceCents: the cost on credits that a "continue" let
  // through. limitQuestionKind (session | day) and limitQuestionCents: the open question
  // "Reached $5. Continue?". limitHeldRun: the run that waits for the answer (no secrets)
  limitAllowanceCents  Float          @default(0)
  limitQuestionKind    String?
  limitQuestionCents   Int?
  limitHeldRun         Json?
  // set when the session was started from GitHub by the December GitHub App: the mode
  // (issue | change | review), the installation, the issue or pull request and its refs
  githubRun            Json?
  projectId            String?
  epoch                Int            @default(1)
  leaseExpiresAt       DateTime?
  leaseOwner           String?
  status               String         @default("IDLE")
  // the E2B sandbox itself, apart from the agent run (vmStatus). it stays RUNNING after a
  // turn for the preview, terminal and next prompt until the idle sweeper pauses it
  sandboxStatus        SandboxStatus?
  // last agent step, terminal input or preview request on the sandbox (idle pause after 10 minutes)
  vmLastActivityAt     DateTime?
  // when the sandbox last started or resumed (the "running now" list of the sandbox settings)
  sandboxStartedAt     DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  project         Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  messages        Message[]
  attachments     MessageAttachment[]
  settings        SessionSettings?
  memories        SessionMemory[]
  usageEvents     UsageEvent[]
  durableSteps    DurableStep[]
  mailboxMessages MailboxMessage[]
  wakeUpTriggers  WakeUpTrigger[]

  @@index([userId])
  @@index([userId, prNumber])
  @@index([githubRepoOwner, githubRepoName, prNumber])
  @@index([userId, pinnedAt])
  @@index([projectId])
  @@index([userId, sandboxStatus])
  @@index([sandboxStatus, vmLastActivityAt])
}

model Project {
  id            String      @id @default(uuid())
  name          String
  description   String?
  userId        String
  repoOwner     String?
  repoName      String?
  repoUrl       String?
  gitProvider   GitProvider @default(GITHUB)
  defaultBranch String?     @default("main")
  pinnedRules   String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions Session[]

  @@index([userId])
}

model SessionSettings {
  id        String   @id @default(uuid())
  sessionId String   @unique
  config    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model DurableStep {
  id         String   @id @default(uuid())
  sessionId  String
  stepIndex  Int
  stepType   String
  opId       String?
  input      Json?
  output     Json?
  outputRef  String?
  durationMs Int?
  createdAt  DateTime @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, stepIndex])
  @@index([sessionId])
  @@index([sessionId, opId])
}

model MailboxMessage {
  id          String    @id @default(uuid())
  sessionId   String
  sender      String // USER | SYSTEM | WEBHOOK | CRON
  content     String
  status      String    @default("QUEUED") // QUEUED, PLACED, COMPLETED, FAILED
  metadata    Json?
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, status])
  @@index([status, createdAt])
}

model WakeUpTrigger {
  id          String    @id @default(uuid())
  sessionId   String
  triggerAt   DateTime
  reason      String? // scheduled_wake, cron_check, pr_review, etc.
  status      String    @default("PENDING") // PENDING, PROCESSING, COMPLETED, CANCELLED
  payload     Json?
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([triggerAt, status])
  @@index([sessionId])
}

enum SessionType {
  WEB
  SEARCH
}

enum VmStatus {
  PROVISIONING
  RUNNING
  STOPPED
  FAILED
}

// #624 part 4: at most 10 STARTING or RUNNING sandboxes per user. PAUSED keeps the files
// and memory and does not count; STOPPED is gone
enum SandboxStatus {
  STARTING
  RUNNING
  PAUSED
  STOPPED
}

model SessionMemory {
  id        String   @id @default(uuid())
  sessionId String
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, key])
  @@index([sessionId])
}

model Message {
  id        String      @id @default(uuid())
  role      MessageRole
  content   String
  status    String?
  sequence  Int
  blocks    Json?
  sessionId String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  session     Session             @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  attachments MessageAttachment[]

  @@unique([sessionId, sequence])
}

// a file the user sent with a prompt (#634). the bytes are in the file store under fileKey
model MessageAttachment {
  id          String   @id @default(uuid())
  sessionId   String
  // empty until the prompt that carries the file is sent
  messageId   String?
  name        String
  contentType String
  sizeBytes   Int
  fileKey     String
  createdAt   DateTime @default(now())
  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  message     Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([sessionId])
  @@index([messageId])
}

// a payment row stays when the 90-day purge deletes its account: userId becomes null, so
// revenue and the accounting record stay
model WalletTransaction {
  id                String          @id @default(uuid())
  userId            String?
  amountInCents     Int
  currency          String          @default("USD")
  provider          PaymentProvider
  providerOrderId   String?
  providerPaymentId String?
  status            PaymentStatus   @default(PENDING)
  metadata          Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  user              User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
}

enum PaymentProvider {
  RAZORPAY
  COINBASE
  // free credits an admin approved (credit requests)
  GRANT
  // credits an admin added or removed by hand, with a reason
  ADJUSTMENT
  // a referral credit (#638): the inviter and the new account each get one row
  REFERRAL
}

enum CreditRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// a request for the one-time $5 free credits. one per normalized address, for good:
// the row stays when the account is deleted, and a rejection is final.
model CreditRequest {
  id               String              @id @default(uuid())
  userId           String?
  normalizedEmail  String              @unique
  status           CreditRequestStatus @default(PENDING)
  buildPlan        String
  heardFrom        String
  agreedToFeedback Boolean             @default(false)
  ipAddress        String?
  userAgent        String?
  reviewedBy       String?
  reviewedAt       DateTime?
  rejectReason     String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId])
  @@index([ipAddress])
}

// one row for every admin action. adminUserId is not a relation so the log outlives accounts.
// one browser that turned on push for the user (#636). keys come from PushManager.subscribe
model PushSubscription {
  id            String       @id @default(uuid())
  userId        String
  // the sign-in of the browser that turned push on. signing it out removes the row.
  // null for rows from before this field
  authSessionId String?
  endpoint      String       @unique
  p256dh        String
  auth          String
  userAgent     String?
  createdAt     DateTime     @default(now())
  lastUsedAt    DateTime?
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  authSession   AuthSession? @relation(fields: [authSessionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([authSessionId])
}

// the admin's authenticator app (TOTP). the secret is encrypted with SECRETS_ENC_KEY.
// enabledAt is null until the first code is entered during setup.
model AdminTotp {
  userId          String    @id
  secretEncrypted String
  enabledAt       DateTime?
  // the last 30-second step a code was accepted for: the same code cannot be used twice
  lastUsedStep    Int?
  failedCount     Int       @default(0)
  lockedUntil     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AdminAuditLog {
  id          String   @id @default(uuid())
  adminUserId String
  action      String
  targetType  String
  targetId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([targetType, targetId])
}

enum TeamRole {
  OWNER
  ADMIN
  MEMBER
}

// a team of people (#640). every user owns one team. members share nothing yet: sessions,
// secrets, keys, credits and github installs stay with each user
model Team {
  id        String   @id @default(uuid())
  name      String
  ownerId   String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner       User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members     TeamMember[]
  invites     TeamInvite[]
  auditEvents AuditEvent[]
}

model TeamMember {
  id        String   @id @default(uuid())
  teamId    String
  userId    String
  role      TeamRole @default(MEMBER)
  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
}

// an invite by email. the link has a random token, only its sha256 hash is saved
model TeamInvite {
  id          String    @id @default(uuid())
  teamId      String
  // lower case
  email       String
  role        TeamRole  @default(MEMBER)
  tokenHash   String    @unique
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  team      Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  invitedBy User @relation(fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([teamId, email])
}

// what happened in a team: member changes, sign-ins, secret, key and billing changes.
// actorId is empty when the account of the actor is gone
model AuditEvent {
  id        String   @id @default(uuid())
  teamId    String
  actorId   String?
  action    String
  target    String?
  ip        String?
  metadata  Json?
  createdAt DateTime @default(now())

  team  Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([teamId, createdAt])
}

enum AnnouncementKind {
  ANNOUNCEMENT
  FEEDBACK_REQUEST
}

// a message the admin page sent to users (replaces scripts/announce.py and scripts/feedback.ts)
model Announcement {
  id              String           @id @default(uuid())
  kind            AnnouncementKind @default(ANNOUNCEMENT)
  subject         String
  body            String
  // feedback requests: users who signed up this many days ago
  signedUpDaysAgo Int?
  createdBy       String
  recipientCount  Int              @default(0)
  skippedCount    Int              @default(0)
  sentAt          DateTime?
  createdAt       DateTime         @default(now())

  @@index([createdAt])
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

model UsageEvent {
  id                String        @id @default(uuid())
  userId            String
  sessionId         String?
  model             String
  inputTokens       Int           @default(0)
  outputTokens      Int           @default(0)
  totalTokens       Int           @default(0)
  costInCents       Float         @default(0)
  chatId            String?
  externalRequestId String?       @unique
  metadata          Json?
  billingSource     BillingSource @default(CREDITS)
  periodStart       DateTime
  periodEnd         DateTime
  createdAt         DateTime      @default(now())

  session Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, periodStart])
  @@index([userId, periodStart, createdAt])
  @@index([sessionId, createdAt])
  @@index([createdAt])
}

enum NotificationType {
  INFO
  WARNING
  SUCCESS
  ERROR
}

enum NotifyLevel {
  ALL
  IMPORTANT
  NONE
}

enum NotificationCategory {
  GENERAL
  MENTION
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model DeviceCode {
  id         String           @id @default(uuid())
  deviceCode String           @unique
  userCode   String           @unique
  userId     String?
  expiresAt  DateTime
  status     DeviceCodeStatus @default(PENDING)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  user       User?            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([deviceCode])
  @@index([userCode])
  @@index([userId])
}

enum DeviceCodeStatus {
  PENDING
  APPROVED
  EXPIRED
}

model RedeemCode {
  id              String            @id @default(uuid())
  codeHash        String            @unique
  creditAmount    Int
  maxRedemptions  Int?
  redemptionCount Int               @default(0)
  expiresAt       DateTime?
  metadata        Json?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  claims          RedeemCodeClaim[]
}

model RedeemCodeClaim {
  id           String     @id @default(uuid())
  redeemCodeId String
  userId       String
  redeemedAt   DateTime   @default(now())
  redeemCode   RedeemCode @relation(fields: [redeemCodeId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([redeemCodeId, userId])
  @@index([userId])
}

enum ReferralStatus {
  // the new account has not paid for credits yet
  PENDING
  // both accounts got the credit
  CREDITED
  // the inviter was at the cap when the new account paid: nobody got a credit
  SKIPPED
}

// a new account that signed up with the invite link of another user (#638). the credits are
// paid once, when the new account makes its first paid top-up
model Referral {
  id         String         @id @default(uuid())
  inviterId  String
  // one referral for each new account
  inviteeId  String         @unique
  status     ReferralStatus @default(PENDING)
  creditedAt DateTime?
  createdAt  DateTime       @default(now())
  inviter    User           @relation("ReferralInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  invitee    User           @relation("ReferralInvitee", fields: [inviteeId], references: [id], onDelete: Cascade)

  @@index([inviterId, status])
}

// how December opens and handles pull requests, and what the GitHub App does on its own.
// one row per user; a missing row means every default below.
model PullRequestSettings {
  id                    String   @id @default(uuid())
  userId                String   @unique
  // opening (#637)
  branchPrefix          String   @default("december/")
  prDraft               Boolean  @default(false)
  // not used: "create the pull request" is User.defaultOpenPullRequest (one stored value)
  prCreate              String   @default("auto")
  prAuthor              String   @default("december")
  commitAuthor          String   @default("both")
  archiveOnMerge        Boolean  @default(true)
  // github app (#568): pause, replies and review
  githubCommentsEnabled Boolean  @default(true)
  reviewReplies         String   @default("mention")
  replyToBots           Boolean  @default(false)
  fixFailedChecks       Boolean  @default(true)
  autoReview            String   @default("asked")
  reviewCadence         String   @default("once")
  // empty means every repository the app can see
  reviewRepos           String[] @default([])
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// what a user set for one repository (#637): the setup commands run after the clone in a
// new sandbox. repoFullName is lower case (owner/name, or a gitlab group path)
model RepositorySetting {
  id            String   @id @default(uuid())
  userId        String
  repoFullName  String
  setupCommands String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, repoFullName])
}

model GithubAppInstallation {
  id             String   @id @default(uuid())
  installationId String   @unique
  userId         String?
  accountLogin   String?
  accountType    String?
  targetType     String?
  permissions    Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Secret {
  id           String   @id @default(uuid())
  userId       String
  name         String
  value        String // Encrypted value
  note         String?
  // the repository that gets this secret, as 'owner/name'. '' means all repositories (#637)
  repoFullName String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name, repoFullName])
  @@index([userId])
}

model Feedback {
  id        String   @id @default(uuid())
  userId    String
  rating    String?
  feedback  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// a skill saved on the account (connections, #632 section 2). the agent runs it when the
// user picks it with /name, or by itself when runs is "agent"
model UserSkill {
  id          String   @id @default(uuid())
  userId      String
  name        String
  description String
  body        String
  // agent: the agent may run it by itself; user: only when the user picks it
  runs        String   @default("agent")
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
}

// a remote mcp server saved on the account; cloud sessions connect to it for each run
model UserMcpServer {
  id               String    @id @default(uuid())
  userId           String
  name             String
  url              String
  // http (streamable http) or sse
  transport        String    @default("http")
  // none or header; oauth sign-in is not supported yet
  auth             String    @default("none")
  // the headers as encrypted json; headerKeys shows the names without the values
  encryptedHeaders String?
  headerKeys       String[]  @default([])
  enabled          Boolean   @default(true)
  disabledTools    String[]  @default([])
  // what the last run found: unknown, connected or error, and the tools it listed
  status           String    @default("unknown")
  lastError        String?
  tools            String[]  @default([])
  checkedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
}
